{# =========================================================
   ROOMHIVE (Symfony) — templates/base.html.twig
   Site-wide shell. Pages extending this automatically get:
   - /assets/style.css + /assets/myaccount.css (copied from the
     original /webprogg/assets)
   - /assets/javaScript.js + Lucide icons (loaded once here)
   - Session flash messages (error / success)
   Standalone full-HTML pages (like user/profile_edit.html.twig)
   do NOT extend this — they link the same assets themselves.
========================================================= #}
<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}RoomHive{% endblock %}</title>
        <script>
            try {
                if (localStorage.getItem("rhTheme") === "dark") {
                    document.documentElement.setAttribute("data-theme-preview", "1");
                }
            } catch (e) {}
        </script>
        <link rel="stylesheet" href="/assets/style.css">
        <link rel="stylesheet" href="/assets/myaccount.css">
        {% block stylesheets %}{% endblock %}
        <script>
            document.documentElement.classList.add("js");
        </script>
    </head>

    <body>
        {# ⚠️ Left commented by default: if your child templates already
       include navbar/footer themselves, enabling these here would
       double-render. Check one child template first, then uncomment.
    {% include 'partials/navbar.html.twig' with { notification_count: notification_count|default(0) } %}
    #}

        {% for label in ['error', 'success'] %}
            {% for flash in app.flashes(label) %}
                <section class="up-alert up-alert-{{ label }}">
                    <p><i data-lucide="{{ label == 'error' ? 'circle-x' : 'circle-check' }}"></i>{{ flash }}</p>
                </section>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}

        {# {% include 'partials/footer.html.twig' %} #}

        <script src="/assets/javaScript.js"></script>
        <script src="https://unpkg.com/lucide@0.469.0/dist/umd/lucide.min.js"></script>
        <script>
            function rhRefreshIcons() {
                if (window.lucide && typeof lucide.createIcons === "function") {
                    lucide.createIcons();
                }
            }
            rhRefreshIcons();
            document.addEventListener("DOMContentLoaded", rhRefreshIcons);
        </script>
        {% block javascripts %}{% endblock %}
    </body>

</html>
