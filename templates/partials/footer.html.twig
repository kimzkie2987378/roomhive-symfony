{# Lucide renderer — guarded; shares the navbar's __rhNavbarLucide
   key so it never double-runs. createIcons() is idempotent anyway. #}
<script src="https://unpkg.com/lucide@0.469.0/dist/umd/lucide.min.js"></script>
<script>
    (function () {
        "use strict";

        if (window.__rhNavbarLucide) {
            return;
        }
        window.__rhNavbarLucide = true;

        function renderFooterIcons() {
            if (window.lucide && typeof window.lucide.createIcons === "function") {
                window.lucide.createIcons();
            }
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", renderFooterIcons);
        } else {
            renderFooterIcons();
        }
    })();
</script>
