{# =========================================================
   ROOMHIVE — COMING SOON PLACEHOLDER
   templates/pages/coming-soon.html.twig

   Rendered by PagesController::comingSoon() for routes whose
   real pages don't exist yet (login, profile, messages,
   settings, notifications, wallet).

   Receives: page_name (route name), current_page (path)
========================================================= #}

{# Friendly label per route, with safe fallbacks #}
{% set route_info = {
    'app_login':         { 'label': 'Login',            'title': 'Sign in is on its way',        'desc': 'The login page is being built right now. Soon you will be able to sign in and manage your bookings.' },
    'app_profile':       { 'label': 'My Profile',       'title': 'Your profile is moving in',    'desc': 'The profile page is under construction. Your details are safe — this view is coming soon.' },
    'app_messages':      { 'label': 'Messages',         'title': 'Your inbox is being built',    'desc': 'Host and guest messaging will land here. Check back soon!' },
    'app_settings':      { 'label': 'Profile Settings', 'title': 'Settings are on the way',      'desc': 'Editing your details, avatar and password will live here soon.' },
    'app_notifications': { 'label': 'Notifications',    'title': 'Notifications coming soon',    'desc': 'Booking updates and alerts will appear here once live.' },
    'app_wallet':        { 'label': 'Wallet',           'title': 'Your wallet is being built',   'desc': 'Top-ups, balance and transaction history will live here. Check back soon!' },
} %}

{% set info = route_info[page_name|default('')] ?? {
    'label': 'Coming Soon',
    'title': 'This page is on its way',
    'desc':  'Our bees are still building this part of the hive. Check back soon!',
} %}

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{{ info.label }} — RoomHive</title>

        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="{{ asset('assets/style.css') }}">

        <script>
            document.documentElement.classList.add("js");
        </script>

        <style>
            .cs-page {
                --hive-honey: #eda423;
                --hive-honey-light: #f6c04e;
                --hive-ink: #1c1d22;
                --hive-ink-soft: #565a66;
                --hive-line: #e9e2d3;

                position: relative;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 140px 20px 80px;
                overflow: hidden;
            }

            .cs-page::before {
                content: "";
                position: absolute;
                inset: 0;
                background-image: url("data:image/svg+xml,%3Csvg width='28' height='49' viewBox='0 0 28 49' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23eda423' fill-opacity='0.07' fill-rule='nonzero'%3E%3Cpath d='M13.99 9.25l13 7.5v15l-13 7.5L1 31.75v-15l12.99-7.5zM3 17.9v12.7l10.99 6.34 11-6.35V17.9l-11-6.34L3 17.9zM0 15l12.98-7.5V0h-2v6.35L0 12.69v2.3zm0 18.5L12.98 41v8h-2v-6.85L0 35.81v-2.3zM15 0v7.5L27.99 15H28v-2.31h-.01L17 6.35V0h-2zm0 49v-8l12.99-7.5H28v2.31h-.01L17 42.15V49h-2z'/%3E%3C/g%3E%3C/svg%3E");
                background-size: 28px 49px;
                -webkit-mask-image: linear-gradient(
                    180deg,
                    rgba(0, 0, 0, 0.9),
                    transparent 60%
                );
                mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.9), transparent 60%);
                pointer-events: none;
                z-index: 0;
            }

            .cs-page > * {
                position: relative;
                z-index: 1;
            }

            .cs-blob {
                position: absolute;
                border-radius: 50%;
                filter: blur(70px);
                pointer-events: none;
                z-index: 0;
            }

            .cs-blob-1 {
                width: 340px;
                height: 340px;
                top: -120px;
                right: -100px;
                background: radial-gradient(
                    circle at 30% 30%,
                    rgba(246, 196, 78, 0.8),
                    rgba(237, 164, 35, 0.22) 60%,
                    transparent 75%
                );
                animation: csDrift 14s ease-in-out infinite alternate;
            }

            .cs-blob-2 {
                width: 260px;
                height: 260px;
                bottom: -100px;
                left: -120px;
                background: radial-gradient(
                    circle at 60% 40%,
                    rgba(246, 196, 78, 0.6),
                    rgba(237, 164, 35, 0.18) 60%,
                    transparent 75%
                );
                animation: csDrift 18s ease-in-out infinite alternate-reverse;
            }

            @keyframes csDrift {
                from {
                    transform: translate(0, 0) scale(1);
                }
                to {
                    transform: translate(30px, -24px) scale(1.08);
                }
            }

            @keyframes csRise {
                from {
                    opacity: 0;
                    transform: translateY(14px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .js .cs-card {
                animation: csRise 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
            }

            .cs-card {
                max-width: 560px;
                text-align: center;
                background: #ffffff;
                border: 1px solid var(--hive-line);
                border-radius: 20px;
                padding: 48px 40px;
                box-shadow: 0 18px 40px -22px rgba(28, 29, 34, 0.35);
            }

            .cs-badge {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 8px 16px;
                background: #ffffff;
                border: 1px solid rgba(237, 164, 35, 0.35);
                border-radius: 999px;
                box-shadow: 0 4px 14px rgba(237, 164, 35, 0.12);
                color: #b07708;
                font-size: 11.5px;
                font-weight: 700;
                letter-spacing: 0.8px;
                text-transform: uppercase;
            }

            .cs-pulse-dot {
                position: relative;
                width: 8px;
                height: 8px;
                background: var(--hive-honey);
                border-radius: 50%;
            }

            .cs-pulse-dot::after {
                content: "";
                position: absolute;
                inset: 0;
                background: var(--hive-honey);
                border-radius: 50%;
                animation: csPing 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
            }

            @keyframes csPing {
                0% {
                    transform: scale(1);
                    opacity: 0.7;
                }
                80%,
                100% {
                    transform: scale(2.6);
                    opacity: 0;
                }
            }

            .cs-icon {
                width: 76px;
                height: 76px;
                margin: 26px auto 0;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 24px;
                background: linear-gradient(
                    135deg,
                    var(--hive-honey-light),
                    var(--hive-honey)
                );
                box-shadow: 0 12px 26px rgba(237, 164, 35, 0.35);
            }

            .cs-icon svg {
                width: 36px;
                height: 36px;
                color: var(--hive-ink);
            }

            .cs-card h1 {
                margin: 24px 0 0;
                font-size: clamp(24px, 4vw, 32px);
                color: var(--hive-ink);
                letter-spacing: -0.4px;
            }

            .cs-shimmer {
                background: linear-gradient(92deg, #eda423 0%, #f6c04e 45%, #eda423 90%);
                background-size: 200% auto;
                -webkit-background-clip: text;
                background-clip: text;
                -webkit-text-fill-color: transparent;
                color: transparent;
                animation: csShimmer 3.5s linear infinite;
            }

            @keyframes csShimmer {
                to {
                    background-position: 200% center;
                }
            }

            .cs-card p {
                margin: 14px 0 0;
                color: var(--hive-ink-soft);
                font-size: 14.5px;
                line-height: 1.6;
            }

            .cs-actions {
                display: flex;
                gap: 12px;
                justify-content: center;
                flex-wrap: wrap;
                margin-top: 30px;
            }

            .cs-btn {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 12px 24px;
                border-radius: 12px;
                font-family: inherit;
                font-size: 14px;
                font-weight: 700;
                text-decoration: none;
                transition:
                    transform 0.15s ease,
                    box-shadow 0.2s ease,
                    background 0.15s ease;
            }

            .cs-btn svg {
                width: 15px;
                height: 15px;
            }

            .cs-btn-primary {
                background: linear-gradient(
                    135deg,
                    var(--hive-honey-light),
                    var(--hive-honey)
                );
                color: var(--hive-ink);
                box-shadow: 0 8px 20px rgba(237, 164, 35, 0.35);
                border: none;
            }

            .cs-btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 26px rgba(237, 164, 35, 0.45);
            }

            .cs-btn-ghost {
                background: #ffffff;
                color: var(--hive-ink);
                border: 1.5px solid var(--hive-line);
            }

            .cs-btn-ghost:hover {
                border-color: var(--hive-honey);
                background: #fffdf6;
            }

            @media (prefers-reduced-motion: reduce) {
                .cs-blob,
                .cs-pulse-dot::after,
                .cs-shimmer {
                    animation: none !important;
                }
                .js .cs-card {
                    animation: none !important;
                    opacity: 1 !important;
                    transform: none !important;
                }
            }
        </style>
    </head>

    <body>

        {% include 'partials/navbar.html.twig' with { current_page: current_page|default('') } %}

        <main class="cs-page">

            <span class="cs-blob cs-blob-1" aria-hidden="true"></span>
            <span class="cs-blob cs-blob-2" aria-hidden="true"></span>

            <div class="cs-card">

                <span class="cs-badge">
                    <span class="cs-pulse-dot"></span>
                    {{ info.label }}
                </span>

                <span class="cs-icon" aria-hidden="true">
                    <i data-lucide="hard-hat"></i>
                </span>

                <h1>
                    <span class="cs-shimmer">{{ info.title }}</span>
                </h1>

                <p>{{ info.desc }}</p>

                <div class="cs-actions">
                    <a href="{{ path('app_listings') }}" class="cs-btn cs-btn-primary">
                        <i data-lucide="search"></i>
                        Browse Listings
                    </a>
                    <a href="/" class="cs-btn cs-btn-ghost">
                        <i data-lucide="house"></i>
                        Back to Home
                    </a>
                </div>

            </div>

        </main>

        {% include 'partials/footer.html.twig' ignore missing %}

        <script src="https://unpkg.com/lucide@0.469.0/dist/umd/lucide.min.js"></script>
        <script>
            function csRefreshIcons() {
                if (window.lucide && typeof lucide.createIcons === "function") {
                    lucide.createIcons();
                }
            }
            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", csRefreshIcons);
            } else {
                csRefreshIcons();
            }
        </script>

    </body>

</html>
