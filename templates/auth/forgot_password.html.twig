{# =========================================================
   ROOMHIVE — FORGOT PASSWORD
   templates/auth/forgot_password.html.twig

   Rendered by AuthController::forgotPassword().

   === SELF-CONTAINED STYLES (this version) ===
   The forgot-password section was missing from the Symfony
   copy of style.css, so the full design ships inline — the
   page is styled no matter what style.css holds. Class names
   kept identical to the legacy markup.

   === ICONS (LUCIDE, lucide.dev) ===
   Converted to <i data-lucide="..."> (rendered to inline SVG
   by lucide.createIcons()):
     - ForgotPasswordIcon.png      -> key-round   (honey badge)
     - EmailIcon.jpg (label)       -> mail
     - VerifiedListingsIcons.png   -> life-buoy   (help box)
     - text arrows                 -> arrow-left / arrow-right
   The old glyph entity stays INSIDE each <i> as the no-CDN
   fallback. The RoomHive logo stays a real <img> (brand logo,
   per convention). This page has no shared navbar, so it
   ships its own guarded loader (bottom of <body>, same
   window.__rhNavbarLucide key as the other auth pages).
========================================================= #}

<!DOCTYPE html>
<html lang="en">

    <head>

        <meta charset="UTF-8">

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        >

        <title>RoomHive - Forgot Password</title>

        <!-- Poppins Font -->
        <link
            href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        >

        <!-- Main CSS (page is fully styled inline below regardless) -->
        <link rel="stylesheet" href="{{ asset('assets/style.css') }}">

        <style>
            /* =============================================
                                   FORGOT PASSWORD — full standalone styles
                                ============================================== */
            body.forgot-password-page {
                margin: 0;
                min-height: 100vh;

                background: #f7f8fa;
                color: #14142b;

                font-family:
                    "Poppins",
                    -apple-system,
                    BlinkMacSystemFont,
                    "Segoe UI",
                    sans-serif;
            }

            /* Close / Back to Home — pins to the viewport's
                                   top-right corner, clear of the card */
            .forgot-password-page .close-button {
                position: fixed;
                top: 18px;
                right: 26px;
                z-index: 50;

                color: #8b93a6;
                font-size: 34px;
                font-weight: 400;
                line-height: 1;
                text-decoration: none;

                transition:
                    color 0.15s ease,
                    transform 0.15s ease;
            }

            .forgot-password-page .close-button:hover {
                color: #14142b;
                transform: scale(1.1);
            }

            .forgot-password-container {
                display: flex;
                align-items: center;
                justify-content: center;

                min-height: 100vh;
                padding: 40px 16px;
            }

            .forgot-password-card {
                width: 100%;
                max-width: 460px;

                background: #ffffff;
                border: 1px solid #eef1f6;
                border-radius: 20px;
                padding: 40px 36px 34px;

                box-shadow: 0 18px 40px -22px rgba(20, 20, 43, 0.28);

                text-align: center;
            }

            /* RoomHive logo — brand logo stays a real <img>,
                                   explicitly constrained (the giant-logo fix) */
            .forgot-logo img {
                width: 130px;
                max-width: 60%;
                height: auto;
                display: block;
                margin: 0 auto 18px;
            }

            /* =============================================
                                   LUCIDE ICONS (lucide.dev)
                                   Lucide copies the placeholder's classes onto the
                                   generated <svg>, so these selectors match either
                                   state.
                                ============================================== */
            svg.lucide {
                display: inline-block;
                vertical-align: -0.18em;
                flex-shrink: 0;
            }

            /* Forgot-password icon — was ForgotPasswordIcon.png.
                                   Honey gradient badge with an ink key glyph, matching
                                   the site's badge language (hero-badge / cs-icon). */
            .forgot-icon {
                width: 84px;
                height: 84px;
                margin: 0 auto 14px;

                display: flex;
                align-items: center;
                justify-content: center;

                border-radius: 24px;

                background: linear-gradient(135deg, #f6c04e, #eda423);

                box-shadow: 0 12px 26px rgba(237, 164, 35, 0.35);
            }

            .forgot-icon svg {
                width: 40px;
                height: 40px;

                color: #14142b;
                stroke-width: 1.9;
            }

            /* Field label icon — was EmailIcon.jpg (16px) */
            .forgot-form-group label svg {
                width: 16px;
                height: 16px;
                color: #b07708;
            }

            /* Help box icon — was VerifiedListingsIcons.png */
            .help-icon {
                width: 40px;
                height: 40px;
                flex-shrink: 0;

                display: flex;
                align-items: center;
                justify-content: center;

                border-radius: 12px;

                background: #fff6e9;
                border: 1px solid rgba(237, 164, 35, 0.35);

                color: #d99218;
            }

            .help-icon svg {
                width: 20px;
                height: 20px;
            }

            /* Back-to-login arrow — was ← text */
            .back-login-button svg {
                width: 15px;
                height: 15px;
            }

            /* Contact Support arrow — was → text */
            .contact-support svg {
                width: 14px;
                height: 14px;
                vertical-align: -2px;
            }

            .forgot-password-card h1 {
                margin: 0 0 10px;

                font-size: 24px;
                font-weight: 700;
                letter-spacing: -0.3px;
                color: #14142b;
            }

            .forgot-description {
                margin: 0 0 22px;

                color: #8b93a6;
                font-size: 13.5px;
                line-height: 1.6;
            }

            /* Messages */
            .forgot-message {
                padding: 12px 14px;
                border-radius: 12px;
                margin-bottom: 18px;

                font-size: 13px;
                font-weight: 500;
                text-align: left;
            }

            .forgot-message.error {
                background: #fdecec;
                border: 1px solid #f5b5b5;
                color: #a3282e;
            }

            .forgot-message.success {
                background: #eaf9f0;
                border: 1px solid #c9edd7;
                color: #1e7a3d;
            }

            /* Form */
            .forgot-form-group {
                text-align: left;
                margin-bottom: 20px;
            }

            .forgot-form-group label {
                display: flex;
                align-items: center;
                gap: 7px;

                margin-bottom: 7px;

                color: #555;
                font-size: 12.5px;
                font-weight: 600;
            }

            .forgot-form-group input {
                width: 100%;
                padding: 12px 14px;

                border: 1px solid #dadee6;
                border-radius: 10px;

                font-family: inherit;
                font-size: 14px;
                color: #14142b;

                box-sizing: border-box;

                transition:
                    border-color 0.15s ease,
                    box-shadow 0.15s ease;
            }

            .forgot-form-group input:focus {
                outline: none;
                border-color: #f5a623;
                box-shadow: 0 0 0 3px rgba(245, 166, 35, 0.18);
            }

            .reset-button {
                display: block;
                width: 100%;
                padding: 14px;

                border: none;
                border-radius: 12px;

                background: linear-gradient(135deg, #f6c04e, #eda423);

                color: #14142b;
                font-family: inherit;
                font-size: 15px;
                font-weight: 700;

                cursor: pointer;

                box-shadow: 0 8px 20px rgba(237, 164, 35, 0.35);

                transition:
                    transform 0.15s ease,
                    box-shadow 0.2s ease,
                    filter 0.15s ease;
            }

            .reset-button:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 26px rgba(237, 164, 35, 0.45);
                filter: brightness(1.03);
            }

            .reset-button:active {
                transform: translateY(0);
            }

            /* OR divider */
            .forgot-divider {
                display: flex;
                align-items: center;
                gap: 12px;

                margin: 24px 0;
            }

            .forgot-divider span {
                flex: 1;
                height: 1px;
                background: #eef1f6;
            }

            .forgot-divider p {
                margin: 0;

                color: #8b93a6;
                font-size: 11.5px;
                font-weight: 700;
                letter-spacing: 0.08em;
            }

            /* Back to login */
            .back-login-button {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;

                padding: 12px;

                border: 1.5px solid #eef1f6;
                border-radius: 12px;

                background: #ffffff;

                color: #14142b;
                font-size: 13.5px;
                font-weight: 600;
                text-decoration: none;

                transition:
                    border-color 0.15s ease,
                    background 0.15s ease;
            }

            .back-login-button:hover {
                border-color: #f5a623;
                background: #fffdf6;
            }

            /* Help box */
            .forgot-help-box {
                display: flex;
                align-items: flex-start;
                gap: 12px;

                margin-top: 22px;
                padding: 14px 16px;

                background: #f6f7fb;
                border-radius: 14px;

                text-align: left;
            }

            .help-content {
                flex: 1;
                min-width: 0;
            }

            .help-content strong {
                display: block;

                color: #14142b;
                font-size: 13px;
            }

            .help-content p {
                margin: 3px 0 0;

                color: #8b93a6;
                font-size: 12px;
                line-height: 1.5;
            }

            .contact-support {
                flex-shrink: 0;
                align-self: center;

                display: inline-flex;
                align-items: center;
                gap: 5px;

                color: #b07708;
                font-size: 12.5px;
                font-weight: 700;
                text-decoration: none;

                transition: color 0.15s ease;
            }

            .contact-support:hover {
                color: #eda423;
            }

            /* Reduced motion — the hover lifts are transitions,
                                   not animations, but keep future animations tame */
            @media (prefers-reduced-motion: reduce) {
                .forgot-password-page .close-button,
                .reset-button {
                    transition: none !important;
                }
            }

            @media (max-width: 480px) {
                .forgot-password-card {
                    padding: 30px 22px 26px;
                }

                .forgot-help-box {
                    flex-direction: column;
                }
            }
        </style>

    </head>

    <body class="forgot-password-page">

        <!-- Close / Back to Home -->
        <a href="/" class="close-button" aria-label="Close">
            &times;
        </a>

        <div class="forgot-password-container">

            <div class="forgot-password-card">

                <!-- ==================================
                 ROOMHIVE LOGO — brand logo stays <img>
            =================================== -->

                <div class="forgot-logo">

                    <img
                        src="{{ asset('images/RoomHiveLogos.png') }}"
                        alt="RoomHive Logo"
                    >

                </div>


                <!-- ==================================
                 FORGOT PASSWORD ICON — Lucide key-round
                 in a honey gradient badge (was
                 ForgotPasswordIcon.png). The old glyph
                 entity stays inside as the no-CDN fallback.
            =================================== -->

                <div class="forgot-icon" aria-hidden="true">

                    <i data-lucide="key-round" aria-hidden="true">&#9673;</i>

                </div>


                <!-- ==================================
                 TITLE
            =================================== -->

                <h1>Forgot Password?</h1>

                <p class="forgot-description">
                    No worries! Enter your email address and we'll<br>
                    send you a link to reset your password.
                </p>


                <!-- ==================================
                 ERROR MESSAGE
            =================================== -->

                {% if error is defined and error is not empty %}

                    <div class="forgot-message error">

                        {{ error }}

                    </div>

                {% endif %}


                <!-- ==================================
                 SUCCESS MESSAGE
            =================================== -->

                {% if success is defined and success is not empty %}

                    <div class="forgot-message success">

                        {{ success }}

                    </div>

                {% endif %}


                <!-- ==================================
                 EMAIL FORM — label icon is now Lucide
                 mail (was EmailIcon.jpg), matching the
                 login page's label icons.
            =================================== -->

                <form method="POST" action="{{ path('app_forgot_password') }}">

                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf }}"
                    >

                    <div class="forgot-form-group">

                        <label for="forgot-email">

                            <i data-lucide="mail" aria-hidden="true">&#9673;</i>

                            Email Address

                        </label>


                        <input
                            type="email"
                            id="forgot-email"
                            name="email"
                            placeholder="Enter your email address"
                            value="{{ email }}"
                            required
                        >

                    </div>


                    <!-- ==================================
                     SEND RESET LINK
                =================================== -->

                    <button
                        type="submit"
                        class="reset-button"
                    >
                        Send Reset Link
                    </button>

                </form>


                <!-- ==================================
                 OR DIVIDER
            =================================== -->

                <div class="forgot-divider">

                    <span></span>

                    <p>OR</p>

                    <span></span>

                </div>


                <!-- ==================================
                 BACK TO LOGIN — arrow is now Lucide
                 arrow-left (was ← text).
            =================================== -->

                <a
                    href="{{ path('app_login') }}"
                    class="back-login-button"
                >

                    <i data-lucide="arrow-left" aria-hidden="true">&larr;</i>

                    <span>Back to Log in</span>

                </a>


                <!-- ==================================
                 HELP BOX — icon is now Lucide life-buoy
                 (was VerifiedListingsIcons.png), and the
                 support link's arrow is arrow-right.
            =================================== -->

                <div class="forgot-help-box">

                    <div class="help-icon" aria-hidden="true">

                        <i data-lucide="life-buoy" aria-hidden="true">&#9673;</i>

                    </div>


                    <div class="help-content">

                        <strong>Still need help?</strong>

                        <p>
                            Contact our support team and we'll<br>
                            be happy to assist you.
                        </p>

                    </div>


                    <a
                        href="{{ path('app_contacts') }}"
                        class="contact-support"
                    >
                        Contact Support

                        <i data-lucide="arrow-right" aria-hidden="true">&rarr;</i>
                    </a>

                </div>

            </div>

        </div>

        <!-- =====================================================
         LUCIDE LOADER — this page has no shared navbar, so it
         loads the library itself (guarded; same
         window.__rhNavbarLucide key as the login/register
         pages and the navbar's loader, so coexisting loaders
         never double-run). One caution: createIcons() is
         idempotent, so a re-render pass is harmless.
    ====================================================== -->
        <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
        <script>
            (function () {
                "use strict";

                if (window.__rhNavbarLucide) {
                    return;
                }
                window.__rhNavbarLucide = true;

                function renderFpIcons() {
                    if (window.lucide && typeof window.lucide.createIcons === "function") {
                        window.lucide.createIcons();
                    }
                }

                if (document.readyState === "loading") {
                    document.addEventListener("DOMContentLoaded", renderFpIcons);
                } else {
                    renderFpIcons();
                }
            })();
        </script>

    </body>

</html>
