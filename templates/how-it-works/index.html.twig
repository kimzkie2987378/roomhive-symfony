                    </div>

                    <div class="hiw-hero-stats hiw-anim" style="--d: .45s;">
                        <div class="hiw-stat"><strong data-count="5">5</strong><span>Easy Steps</span></div>
                        <span class="hiw-stat-sep"></span>
                        <div class="hiw-stat"><strong data-count="100" data-suffix="%">100%</strong><span>Verified Listings</span></div>
                        <span class="hiw-stat-sep"></span>
                        <div class="hiw-stat"><strong>24/7</strong><span>Support</span></div>
                    </div>
                </div>

                <div class="hiw-hero-art hiw-anim" style="--d: .3s;">
                    <span class="hiw-art-glow" aria-hidden="true"></span>
                    <img class="hiw-art-img" src="{{ asset('images/HumanThinkingWithHouseAndKey.png') }}" alt="Person thinking about renting or listing a space">

                    <div class="hiw-chip hiw-chip-1">
                        <i data-lucide="search" aria-hidden="true"></i>
                        <span>Smart Search</span>
                    </div>
                    <div class="hiw-chip hiw-chip-2">
                        <i data-lucide="calendar-check" aria-hidden="true"></i>
                        <span>Easy Booking</span>
                    </div>
                    <div class="hiw-chip hiw-chip-3">
                        <i data-lucide="sparkles" aria-hidden="true"></i>
                        <span>Enjoy Your Stay</span>
                    </div>
