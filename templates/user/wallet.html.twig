        {{ include('partials/footer.html.twig') }}

        <!-- Top-up result toast — the payment overlay JS sets a
             sessionStorage flag before returning to /wallet after a
             successful in-site top-up; this toast announces it. -->
        <div class="wl-toast" id="wlToast" role="status" aria-live="polite">
            <i data-lucide="circle-check" aria-hidden="true"></i>
            <span id="wlToastText"></span>
        </div>

        <!-- Lucide — guarded loader, same key as navbar (never double-runs).
             Renders every <i data-lucide="..."> as inline SVG. -->
        <script>
            (function () {
                "use strict";
                function renderRhIcons() {
                    if (window.lucide && typeof window.lucide.createIcons === "function") {
                        window.lucide.createIcons();
                    }
                }
                if (!window.__rhNavbarLucide) {
                    window.__rhNavbarLucide = true;
                    var s = document.createElement("script");
                    s.src = "https://unpkg.com/lucide@0.469.0/dist/umd/lucide.min.js";
                    s.addEventListener("load", renderRhIcons);
                    document.head.appendChild(s);
                }
                if (document.readyState === "loading") {
                    document.addEventListener("DOMContentLoaded", renderRhIcons);
                } else {
                    renderRhIcons();
                }
                window.addEventListener("load", renderRhIcons);
            })();
        </script>

        <!-- Preset chips fill the amount input (legacy behaviour) -->
        <script>
            (function () {
                "use strict";

                var amountInput = document.getElementById("wlAmount");
                document.querySelectorAll(".wl-preset").forEach(function (chip) {
                    chip.addEventListener("click", function () {
                        document.querySelectorAll(".wl-preset").forEach(function (c) {
                            c.classList.remove("active");
                        });
                        chip.classList.add("active");
                        if (amountInput) {
                            amountInput.value = chip.getAttribute("data-amount");
                            amountInput.focus();
                        }
                    });
                });
            })();
        </script>

        <!-- TOP UP -> 3-step payment overlay.
             Native amount validation (required / min / max) runs FIRST,
             so the overlay only opens for a valid form. Step 1 picks
             the method, step 2 collects the GCash mobile number, step
             3 the card details (Luhn-checked, MM/YY, CVV). Proceed
             writes everything into hidden mirror inputs inside the
             real form and POSTS IT IN THE BACKGROUND (fetch with
             redirect: "manual") — the wallet settles on this page
             and the user is never sent to the legacy /wallet/gcash
             checkout URL. The post URL is read with
             getAttribute("action") — the hidden inputs NAMED
             "action"/"method" shadow the form's DOM properties,
             which is exactly what caused the previous
             "Top-up failed (HTTP 404)". Any backend redirect is
             answered opaquely (never followed, so its 404 can
             never be seen), treated as success, and the page
             returns to /wallet with a toast. No JS? Form posts
             method=gcash directly (legacy flow). -->
        <script>
            (function () {
                "use strict";

                /* ---- return toast ----
                                           postTopup() stores the paid amount under
                                           "wlTopupToast" right before it reloads /wallet;
                                           this shows the green toast bottom-right once. */
                try {
                    var toastMsg = sessionStorage.getItem("wlTopupToast");
                    if (toastMsg !== null) {
                        sessionStorage.removeItem("wlTopupToast");
                        var toastEl = document.getElementById("wlToast");
                        var toastText = document.getElementById("wlToastText");
                        if (toastEl && toastText) {
                            toastText.textContent = toastMsg
                                ? "Top-up of " +
                                  toastMsg +
                                  " successful! Your wallet has been credited."
                                : "Top-up successful! Your wallet has been credited.";
                            window.setTimeout(function () {
                                toastEl.classList.add("is-show");
                                window.setTimeout(function () {
                                    toastEl.classList.remove("is-show");
                                }, 4500);
                            }, 250);
                        }
                    }
                } catch (e) {}

                var form = document.getElementById("wlTopupForm");
                /* HOTFIX (HTTP 404): the hidden inputs NAMED "action" and
                                           "method" SHADOW the form's action DOM property -- it
                                           returns the <input> element, and fetch() stringifies it
                                           to "[object HTMLInputElement]", a garbage URL that 404s.
                                           getAttribute() is immune to that shadowing; the Twig
                                           route is the fallback. The verb is hardcoded below. */
                var POST_URL = form.getAttribute("action") || "{{ path('app_wallet') }}";
                var backdrop = document.getElementById("wlMethodModal");
                var closeBtn = document.getElementById("wlModalClose");
                var methodInput = document.getElementById("wlMethod");
                var amountInput = document.getElementById("wlAmount");
                var stepChoose = document.getElementById("wlStepChoose");
                var stepGcash = document.getElementById("wlStepGcash");
                var stepCard = document.getElementById("wlStepCard");
                var lastFocus = null;
                var busy = false;

                if (
                    !form ||
                    !backdrop ||
                    !methodInput ||
                    !stepChoose ||
                    !stepGcash ||
                    !stepCard
                ) {
                    return;
                }

                var gcashInput = document.getElementById("wlGcashNumber");
                var gcashError = document.getElementById("wlGcashNumberError");
                var cardNameInput = document.getElementById("wlCardName");
                var cardNameError = document.getElementById("wlCardNameError");
                var cardNumberInput = document.getElementById("wlCardNumber");
                var cardNumberError = document.getElementById("wlCardNumberError");
                var cardBrand = document.getElementById("wlCardBrand");
                var cardExpiryInput = document.getElementById("wlCardExpiry");
                var cardExpiryError = document.getElementById("wlCardExpiryError");
                var cardCvvInput = document.getElementById("wlCardCvv");
                var cardCvvError = document.getElementById("wlCardCvvError");

                function fmtAmount(value) {
                    return (
                        "\u20B1" +
                        value.toLocaleString("en-PH", {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2,
                        })
                    );
                }

                /* fill the amount chip on every step + the TOP UP buttons */
                function fillAmounts() {
                    var amt = amountInput ? parseFloat(amountInput.value) : NaN;
                    var label = !isNaN(amt) && amt > 0 ? fmtAmount(amt) : "";
                    ["wlModalAmount", "wlGcashAmount", "wlCardAmount"].forEach(
                        function (id) {
                            var chip = document.getElementById(id);
                            if (!chip) {
                                return;
                            }
                            if (label) {
                                chip.textContent = label;
                                chip.hidden = false;
                            } else {
                                chip.hidden = true;
                            }
                        },
                    );
                    ["wlGcashPayAmount", "wlCardPayAmount"].forEach(function (id) {
                        var payAmt = document.getElementById(id);
                        if (payAmt) {
                            payAmt.textContent = label || "NOW";
                        }
                    });
                }

                function showStep(name) {
                    stepChoose.hidden = name !== "choose";
                    stepGcash.hidden = name !== "gcash";
                    stepCard.hidden = name !== "card";
                    if (name === "gcash" && gcashInput) {
                        gcashInput.focus();
                    }
                    if (name === "card" && cardNameInput) {
                        cardNameInput.focus();
                    }
                }

                function setError(input, errEl, msg) {
                    if (input) {
                        input.classList.add("wl-input-invalid");
                        input.setAttribute("aria-invalid", "true");
                    }
                    if (errEl) {
                        var span = errEl.querySelector("span");
                        if (span) {
                            span.textContent = msg;
                        } else {
                            errEl.textContent = msg;
                        }
                        errEl.hidden = false;
                    }
                }

                function clearError(input, errEl) {
                    if (input) {
                        input.classList.remove("wl-input-invalid");
                        input.removeAttribute("aria-invalid");
                    }
                    if (errEl) {
                        errEl.hidden = true;
                    }
                }

                /* ---- validators ---- */
                function gcashOk(val) {
                    return /^(09\d{9}|\+639\d{9})$/.test(val);
                }

                function luhnOk(digits) {
                    if (!/^\d{13,19}$/.test(digits)) {
                        return false;
                    }
                    var sum = 0;
                    var alt = false;
                    for (var i = digits.length - 1; i >= 0; i--) {
                        var d = parseInt(digits.charAt(i), 10);
                        if (alt) {
                            d *= 2;
                            if (d > 9) {
                                d -= 9;
                            }
                        }
                        sum += d;
                        alt = !alt;
                    }
                    return sum % 10 === 0;
                }

                function expiryOk(val) {
                    var m = /^(\d{2})\/(\d{2})$/.exec(val);
                    if (!m) {
                        return false;
                    }
                    var mm = parseInt(m[1], 10);
                    var full = 2000 + parseInt(m[2], 10);
                    if (mm < 1 || mm > 12) {
                        return false;
                    }
                    var now = new Date();
                    return (
                        full > now.getFullYear() ||
                        (full === now.getFullYear() && mm >= now.getMonth() + 1)
                    );
                }

                /* ---- live input formatting ---- */
                if (gcashInput) {
                    gcashInput.addEventListener("input", function () {
                        var v = this.value.replace(/[^\d+]/g, "");
                        if (v.charAt(0) === "+") {
                            this.value = "+" + v.slice(1).replace(/\D/g, "").slice(0, 12);
                        } else {
                            var d = v.replace(/\D/g, "").slice(0, 11);
                            var out = d.slice(0, 4);
                            if (d.length > 4) {
                                out += " " + d.slice(4, 7);
                            }
                            if (d.length > 7) {
                                out += " " + d.slice(7, 11);
                            }
                            this.value = out;
                        }
                        clearError(this, gcashError);
                    });
                }

                if (cardNumberInput) {
                    cardNumberInput.addEventListener("input", function () {
                        var d = this.value.replace(/\D/g, "").slice(0, 19);
                        this.value = d.replace(/(\d{4})(?=\d)/g, "$1 ");
                        if (cardBrand) {
                            if (/^4/.test(d)) {
                                cardBrand.textContent = "Visa";
                                cardBrand.hidden = false;
                            } else if (/^(5[1-5]|2[2-7])/.test(d)) {
                                cardBrand.textContent = "Mastercard";
                                cardBrand.hidden = false;
                            } else {
                                cardBrand.hidden = true;
                            }
                        }
                        clearError(this, cardNumberError);
                    });
                }

                if (cardExpiryInput) {
                    cardExpiryInput.addEventListener("input", function () {
                        var d = this.value.replace(/\D/g, "").slice(0, 4);
                        this.value = d.length > 2 ? d.slice(0, 2) + "/" + d.slice(2) : d;
                        clearError(this, cardExpiryError);
                    });
                }

                if (cardCvvInput) {
                    cardCvvInput.addEventListener("input", function () {
                        this.value = this.value.replace(/\D/g, "").slice(0, 4);
                        clearError(this, cardCvvError);
                    });
                }

                if (cardNameInput) {
                    cardNameInput.addEventListener("input", function () {
                        clearError(this, cardNameError);
                    });
                }

                /* ---- modal open / close ---- */
                function openModal() {
                    lastFocus = document.activeElement;
                    fillAmounts();
                    showStep("choose");
                    backdrop.hidden = false;
                    document.body.style.overflow = "hidden";
                    var firstTile = stepChoose.querySelector(".wl-pay-tile");
                    if (firstTile) {
                        firstTile.focus();
                    }
                }

                function closeModal() {
                    backdrop.hidden = true;
                    document.body.style.overflow = "";
                    if (lastFocus && typeof lastFocus.focus === "function") {
                        lastFocus.focus();
                    }
                }

                /* ---- per-method submission ---- */
                function submitGcash() {
                    var raw = gcashInput ? gcashInput.value.replace(/\s+/g, "") : "";
                    if (!gcashOk(raw)) {
                        setError(
                            gcashInput,
                            gcashError,
                            "Enter a valid GCash mobile number (09XX XXX XXXX or +639XX XXX XXXX).",
                        );
                        if (gcashInput) {
                            gcashInput.focus();
                        }
                        return;
                    }
                    var mirror = document.getElementById("wlGcashNumberField");
                    if (mirror) {
                        mirror.value = raw.indexOf("+639") === 0 ? "0" + raw.slice(3) : raw;
                    }
                    methodInput.value = "gcash";
                    postTopup();
                }

                function submitCard() {
                    var firstInvalid = null;
                    var digits = cardNumberInput
                        ? cardNumberInput.value.replace(/\D/g, "")
                        : "";
                    var name = cardNameInput ? cardNameInput.value.trim() : "";
                    var expiry = cardExpiryInput ? cardExpiryInput.value.trim() : "";
                    var cvv = cardCvvInput ? cardCvvInput.value.replace(/\D/g, "") : "";

                    function fail(input, errEl, msg) {
                        setError(input, errEl, msg);
                        if (!firstInvalid) {
                            firstInvalid = input;
                        }
                    }

                    if (!/^[\p{L}][\p{L} .'\-]+$/u.test(name)) {
                        fail(
                            cardNameInput,
                            cardNameError,
                            "Enter the name printed on the card.",
                        );
                    } else {
                        clearError(cardNameInput, cardNameError);
                    }
                    if (!luhnOk(digits)) {
                        fail(
                            cardNumberInput,
                            cardNumberError,
                            "Enter a valid card number — it fails the checksum.",
                        );
                    } else {
                        clearError(cardNumberInput, cardNumberError);
                    }
                    if (!/^\d{2}\/\d{2}$/.test(expiry)) {
                        fail(
                            cardExpiryInput,
                            cardExpiryError,
                            "Expiry must be in MM/YY format.",
                        );
                    } else if (!expiryOk(expiry)) {
                        fail(
                            cardExpiryInput,
                            cardExpiryError,
                            "This card has already expired.",
                        );
                    } else {
                        clearError(cardExpiryInput, cardExpiryError);
                    }
                    if (!/^\d{3,4}$/.test(cvv)) {
                        fail(cardCvvInput, cardCvvError, "CVV must be 3–4 digits.");
                    } else {
                        clearError(cardCvvInput, cardCvvError);
                    }

                    if (firstInvalid) {
                        firstInvalid.focus();
                        return;
                    }

                    var mirrors = {
                        wlCardNameField: name,
                        wlCardNumberField: digits,
                        wlCardExpiryField: expiry,
                        wlCardCvvField: cvv,
                    };
                    Object.keys(mirrors).forEach(function (id) {
                        var mirror = document.getElementById(id);
                        if (mirror) {
                            mirror.value = mirrors[id];
                        }
                    });
                    methodInput.value = "card";
                    postTopup();
                }

                /* ---- in-site settlement: post the top-up form in the
                                           background (fetch, redirect: "manual"). The legacy
                                           controller answers with a redirect to
                                           /wallet/gcash?ref=... — the old checkout page that
                                           no longer exists (following it WAS the HTTP 404).
                                           redirect:"manual" never follows the chain, so that
                                           404 can never be seen again; the response itself
                                           tells us what happened:
                                             - final URL starts with /wallet/gcash -> the top-up
                                               ran, the controller just tried to open the old
                                               GCash page: treat as PAID and return to /wallet.
                                             - a 200 wallet page containing #wlTopupErrorBanner
                                               -> server-side validation error: show it here.
                                             - anything else not ok -> generic error, overlay
                                               stays open.                               */
                function walletPath() {
                    try {
                        return new URL(POST_URL, window.location.href).pathname;
                    } catch (e) {
                        return window.location.pathname;
                    }
                }

                function setBusy(state) {
                    busy = state;
                    [gcashProceed, cardProceed].forEach(function (btn) {
                        if (btn) {
                            btn.disabled = state;
                        }
                    });
                    backdrop.querySelectorAll("[data-back]").forEach(function (btn) {
                        btn.disabled = state;
                    });
                }

                function finishSuccess() {
                    var amt = amountInput ? parseFloat(amountInput.value) : NaN;
                    try {
                        sessionStorage.setItem(
                            "wlTopupToast",
                            !isNaN(amt) && amt > 0 ? fmtAmount(amt) : "",
                        );
                    } catch (e) {}
                    if (window.location.pathname === walletPath()) {
                        window.location.reload();
                    } else {
                        window.location.assign(walletPath());
                    }
                }

                function finishFailure(message) {
                    setBusy(false);
                    fillAmounts();
                    if (backdrop.querySelector(".wl-step:not([hidden])") === stepCard) {
                        setError(cardNumberInput, cardNumberError, message);
                        if (cardNumberInput) {
                            cardNumberInput.focus();
                        }
                    } else {
                        setError(gcashInput, gcashError, message);
                        if (gcashInput) {
                            gcashInput.focus();
                        }
                    }
                }

                function postTopup() {
                    if (busy) {
                        return;
                    }
                    setBusy(true);
                    ["wlGcashPayAmount", "wlCardPayAmount"].forEach(function (id) {
                        var span = document.getElementById(id);
                        if (span) {
                            span.textContent = "PROCESSING...";
                        }
                    });
                    var body = new URLSearchParams(new FormData(form)).toString();
                    fetch(POST_URL, {
                        method: "POST",
                        body: body,
                        redirect: "manual",
                        headers: {
                            "Content-Type":
                                "application/x-www-form-urlencoded;charset=UTF-8",
                        },
                    })
                        .then(function (res) {
                            /* redirect:"manual": every 3xx lands here as an
                                                   opaque redirect (status 0) — the controller
                                                   accepted the top-up and merely tried to bounce
                                                   us to the retired /wallet/gcash checkout.
                                                   Never chase that bounce (it 404s): the bounce
                                                   IS the approval, so settle as PAID. */
                            if (res.type === "opaqueredirect" || res.status === 0) {
                                finishSuccess();
                                return;
                            }
                            var path = "";
                            try {
                                path = new URL(res.url, window.location.href).pathname;
                            } catch (e) {
                                path = "";
                            }
                            if (
                                path.indexOf("/wallet/gcash") === 0 ||
                                res.url.indexOf("topup=success") !== -1
                            ) {
                                finishSuccess();
                                return;
                            }
                            if (!res.ok) {
                                finishFailure(
                                    "Top-up failed (HTTP " +
                                        res.status +
                                        "). Please try again.",
                                );
                                return;
                            }
                            res.text().then(function (html) {
                                var banner = null;
                                try {
                                    banner = new DOMParser()
                                        .parseFromString(html, "text/html")
                                        .getElementById("wlTopupErrorBanner");
                                } catch (e) {
                                    banner = null;
                                }
                                if (banner && banner.textContent.trim()) {
                                    finishFailure(
                                        banner.textContent.trim().replace(/\s+/g, " "),
                                    );
                                    return;
                                }
                                finishSuccess();
                            });
                        })
                        .catch(function () {
                            finishFailure(
                                "Network error - the top-up did not go through. Please try again.",
                            );
                        });
                }

                /* ---- wiring ---- */
                form.addEventListener("submit", function (e) {
                    e.preventDefault();
                    if (busy) {
                        return;
                    }
                    openModal();
                });

                var tiles = backdrop.querySelectorAll(".wl-pay-tile");
                tiles.forEach(function (tile) {
                    tile.addEventListener("click", function () {
                        showStep(
                            tile.getAttribute("data-method") === "card" ? "card" : "gcash",
                        );
                    });
                });

                backdrop.querySelectorAll("[data-back]").forEach(function (btn) {
                    btn.addEventListener("click", function () {
                        showStep("choose");
                    });
                });

                var gcashProceed = document.getElementById("wlGcashProceed");
                if (gcashProceed) {
                    gcashProceed.addEventListener("click", submitGcash);
                }
                var cardProceed = document.getElementById("wlCardProceed");
                if (cardProceed) {
                    cardProceed.addEventListener("click", submitCard);
                }

                /* Enter inside a step runs that step's proceed button */
                [stepGcash, stepCard].forEach(function (step) {
                    step.addEventListener("keydown", function (e) {
                        if (e.key === "Enter" && e.target && e.target.tagName === "INPUT") {
                            e.preventDefault();
                            if (step === stepGcash) {
                                submitGcash();
                            } else {
                                submitCard();
                            }
                        }
                    });
                });

                if (closeBtn) {
                    closeBtn.addEventListener("click", closeModal);
                }

                /* click on the dark area outside the panel closes it */
                backdrop.addEventListener("click", function (e) {
                    if (e.target === backdrop) {
                        closeModal();
                    }
                });

                /* Esc closes · Tab stays trapped inside the visible step */
                document.addEventListener("keydown", function (e) {
                    if (backdrop.hidden) {
                        return;
                    }
                    if (e.key === "Escape") {
                        closeModal();
                        return;
                    }
                    if (e.key === "Tab") {
                        var step = backdrop.querySelector(".wl-step:not([hidden])");
                        var focusables = [closeBtn];
                        if (step) {
                            focusables = focusables.concat(
                                Array.prototype.slice.call(step.querySelectorAll("button")),
                            );
                        }
                        focusables = focusables.filter(Boolean);
                        if (!focusables.length) {
                            return;
                        }
                        var first = focusables[0];
                        var last = focusables[focusables.length - 1];
                        if (e.shiftKey && document.activeElement === first) {
                            e.preventDefault();
                            last.focus();
                        } else if (!e.shiftKey && document.activeElement === last) {
                            e.preventDefault();
                            first.focus();
                        }
                    }
                });
            })();
        </script>

        <!-- Transaction receipt — every history row opens a printable
             receipt dialog populated from its data-txn-* attributes.
             Print tags <html> with .wl-print-receipt so the print
             stylesheet isolates the receipt panel. -->
        <script>
            (function () {
                "use strict";

                var backdrop = document.getElementById("wlReceiptModal");
                if (!backdrop) {
                    return;
                }
                var dialog = backdrop.querySelector(".wl-modal");
                var closeBtn = document.getElementById("wlReceiptClose");
                var doneBtn = document.getElementById("wlReceiptDone");
                var printBtn = document.getElementById("wlReceiptPrint");
                var lastFocus = null;

                var METHODS = { gcash: "GCash", card: "Banking Cards" };

                function peso(value) {
                    var n = parseFloat(value);
                    if (isNaN(n)) {
                        n = 0;
                    }
                    return (
                        "\u20B1" +
                        n.toLocaleString("en-PH", {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2,
                        })
                    );
                }

                function setText(id, text) {
                    var el = document.getElementById(id);
                    if (el) {
                        el.textContent = text;
                    }
                }

                function openReceipt(row) {
                    var d = row.dataset;

                    setText("wlReceiptRefNo", "Receipt No. " + (d.txnRef || "-"));
                    setText("wlReceiptType", d.txnLabel || "Wallet movement");
                    setText("wlReceiptDate", d.txnDate || "-");
                    setText("wlReceiptMethod", METHODS[d.txnMethod] || "RoomHive Wallet");
                    setText("wlReceiptRef", d.txnRef || "-");
                    setText("wlReceiptBalance", peso(d.txnBalance));

                    var gcashRow = document.getElementById("wlReceiptGcashRow");
                    if (gcashRow) {
                        if (d.txnGcash) {
                            setText("wlReceiptGcash", d.txnGcash);
                            gcashRow.hidden = false;
                        } else {
                            gcashRow.hidden = true;
                        }
                    }

                    var descRow = document.getElementById("wlReceiptDescRow");
                    if (descRow) {
                        if (d.txnDesc) {
                            setText("wlReceiptDesc", d.txnDesc);
                            descRow.hidden = false;
                        } else {
                            descRow.hidden = true;
                        }
                    }

                    var amountEl = document.getElementById("wlReceiptAmount");
                    if (amountEl) {
                        var incoming = d.txnIn === "1";
                        amountEl.textContent =
                            (incoming ? "+" : "\u2212") + peso(d.txnAmount);
                        amountEl.classList.remove("wl-amt-in", "wl-amt-out");
                        amountEl.classList.add(incoming ? "wl-amt-in" : "wl-amt-out");
                    }

                    var statusEl = document.getElementById("wlReceiptStatus");
                    if (statusEl) {
                        statusEl.textContent = d.txnStatus || "APPROVED";
                        statusEl.classList.remove(
                            "wl-st-paid",
                            "wl-st-pending",
                            "wl-st-failed",
                        );
                        statusEl.classList.add(
                            d.txnStatus === "FAILED"
                                ? "wl-st-failed"
                                : d.txnStatus === "PENDING"
                                  ? "wl-st-pending"
                                  : "wl-st-paid",
                        );
                    }

                    lastFocus = document.activeElement;
                    backdrop.hidden = false;
                    document.body.style.overflow = "hidden";
                    if (closeBtn) {
                        closeBtn.focus();
                    }
                }

                function closeReceipt() {
                    backdrop.hidden = true;
                    document.body.style.overflow = "";
                    if (lastFocus && typeof lastFocus.focus === "function") {
                        lastFocus.focus();
                    }
                }

                document.querySelectorAll(".wl-txn[data-txn-ref]").forEach(function (row) {
                    row.addEventListener("click", function () {
                        openReceipt(row);
                    });
                    row.addEventListener("keydown", function (e) {
                        if (e.key === "Enter" || e.key === " " || e.key === "Spacebar") {
                            e.preventDefault();
                            openReceipt(row);
                        }
                    });
                });

                if (closeBtn) {
                    closeBtn.addEventListener("click", closeReceipt);
                }
                if (doneBtn) {
                    doneBtn.addEventListener("click", closeReceipt);
                }
                if (printBtn) {
                    printBtn.addEventListener("click", function () {
                        document.documentElement.classList.add("wl-print-receipt");
                        window.setTimeout(function () {
                            window.print();
                        }, 30);
                    });
                }

                window.addEventListener("afterprint", function () {
                    document.documentElement.classList.remove("wl-print-receipt");
                });

                backdrop.addEventListener("click", function (e) {
                    if (e.target === backdrop) {
                        closeReceipt();
                    }
                });

                /* Esc closes · Tab stays trapped inside the receipt */
                document.addEventListener("keydown", function (e) {
                    if (backdrop.hidden) {
                        return;
                    }
                    if (e.key === "Escape") {
                        closeReceipt();
                        return;
                    }
                    if (e.key === "Tab" && dialog) {
                        var focusables = Array.prototype.slice
                            .call(dialog.querySelectorAll("button"))
                            .filter(function (el) {
                                return !el.disabled;
                            });
                        if (!focusables.length) {
                            return;
                        }
                        var first = focusables[0];
                        var last = focusables[focusables.length - 1];
                        if (e.shiftKey && document.activeElement === first) {
                            e.preventDefault();
                            last.focus();
                        } else if (!e.shiftKey && document.activeElement === last) {
                            e.preventDefault();
                            first.focus();
                        }
                    }
                });
            })();
        </script>

        <!-- Sidebar collapse — same behavior + localStorage key as legacy -->
        <script>
            (function () {
                var sidebar = document.getElementById("upSidebar");
                var toggle = document.getElementById("upSidebarToggle");
                if (!sidebar || !toggle) {
                    return;
                }

                var STORAGE_KEY = "roomhive_sidebar_collapsed";
                var links = sidebar.querySelectorAll(".up-side-link");

                function updateTitles(collapsed) {
                    links.forEach(function (link) {
                        var label = link.querySelector(".up-side-label");
                        if (collapsed) {
                            link.setAttribute("title", label ? label.textContent : "");
                        } else {
                            link.removeAttribute("title");
                        }
                    });
                }

                function applyState(collapsed) {
                    sidebar.classList.toggle("collapsed", collapsed);
                    toggle.setAttribute("aria-expanded", collapsed ? "false" : "true");
                    toggle.setAttribute(
                        "aria-label",
                        collapsed ? "Expand sidebar" : "Collapse sidebar",
                    );
                    updateTitles(collapsed);
                }

                var savedCollapsed = false;
                try {
                    savedCollapsed = localStorage.getItem(STORAGE_KEY) === "1";
                } catch (e) {}
                applyState(savedCollapsed);

                toggle.addEventListener("click", function () {
                    var nowCollapsed = !sidebar.classList.contains("collapsed");
                    applyState(nowCollapsed);
                    try {
                        localStorage.setItem(STORAGE_KEY, nowCollapsed ? "1" : "0");
                    } catch (e) {}
                });
            })();
        </script>

        <!-- Reveal — the REAL legacy mechanism: myaccount.css waits for .in-view.
     Plus a 1.5s failsafe so the page can never render blank. -->
        <script>
            (function () {
                "use strict";

                var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                var revealEls = Array.prototype.slice.call(
                    document.querySelectorAll(".up-reveal"),
                );

                function showAll() {
                    revealEls.forEach(function (el) {
                        el.classList.add("in-view");
                    });
                }

                if (reduced || !("IntersectionObserver" in window)) {
                    showAll();
                } else {
                    var io = new IntersectionObserver(
                        function (entries) {
                            entries.forEach(function (entry) {
                                if (!entry.isIntersecting) {
                                    return;
                                }
                                var el = entry.target;
                                io.unobserve(el);
                                el.classList.add("in-view");
                                window.setTimeout(function () {
                                    el.style.setProperty("--i", "0");
                                }, 1200);
                            });
                        },
                        {
                            threshold: 0.12,
                            rootMargin: "0px 0px -40px 0px",
                        },
                    );
                    revealEls.forEach(function (el) {
                        io.observe(el);
                    });

                    /* failsafe — force-reveal anything still hidden after 1.5s */
                    setTimeout(showAll, 1500);
                }
            })();
        </script>

    </body>

</html>
