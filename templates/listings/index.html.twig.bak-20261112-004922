<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>RoomHive - Listings</title>

        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="{{ asset('assets/style.css') }}">
        <link rel="stylesheet" href="{{ asset('assets/listings-style.css') }}">

        <script>
            document.documentElement.classList.add("js");
        </script>

        <style>
            .js-hidden {
                display: none !important;
            }
            .listings-page {
                padding-top: 130px;
            }

            /* GRID SAFETY NET */
            #rh-listings-results {
                display: grid !important;
                grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
                gap: 24px !important;
                width: 100% !important;
            }
            #rh-listings-results.rh-list-view {
                grid-template-columns: 1fr !important;
            }
            @media (max-width: 1180px) {
                #rh-listings-results {
                    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
                }
            }
            @media (max-width: 900px) {
                #rh-listings-results {
                    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
                }
            }
            @media (max-width: 720px) {
                #rh-listings-results {
                    grid-template-columns: 1fr !important;
                }
            }

            /* =====================================================
                                                                       FILTER BAR — location, category and search extend
                                                                    ====================================================== */
            #filter-form {
                display: flex !important;
                align-items: center;
                gap: 14px;
            }
            #filter-form > .filter-group,
            #filter-form > .filter-divider {
                flex: 0 0 auto;
            }

            #filter-form > .location-group,
            #filter-form > .category-dd,
            #filter-form > .search-group {
                flex: 1 1 auto;
            }
            #filter-form > .location-group {
                flex-grow: 1.6;
            }

            .location-group .location-search,
            .category-dd .category-dd-btn {
                width: 100%;
                min-width: 0;
                box-sizing: border-box;
            }

            .search-group {
                display: flex;
                align-items: center;
                gap: 8px;
            }
            .search-group .search-input {
                flex: 1 1 auto;
                width: auto;
                min-width: 0;
            }

            @media (max-width: 900px) {
                #filter-form {
                    flex-wrap: wrap;
                }
                #filter-form > .location-group,
                #filter-form > .category-dd,
                #filter-form > .search-group {
                    flex: 1 1 100%;
                }
            }

            /* =====================================================
                                                                       DROPDOWN MAKEOVER — selects, inputs, panels
                                                                    ====================================================== */
            .filter-group {
                position: relative;
            }

            select.filter-select,
            .location-search,
            .category-dd-btn {
                -webkit-appearance: none;
                appearance: none;
                border: 1.5px solid var(--rh-line, #e2e8f0);
                border-radius: 12px;
                background: #ffffff;
                font-family: inherit;
                font-size: 0.88rem;
                font-weight: 500;
                color: #1c2a38;
                padding: 10px 36px 10px 40px;
                cursor: pointer;
                transition:
                    border-color 0.18s ease,
                    box-shadow 0.18s ease,
                    background 0.18s ease;
            }
            select.filter-select:hover,
            .location-search:hover,
            .category-dd-btn:hover {
                border-color: var(--rh-gold, #d68e0e);
                background: #fffdf6;
            }
            select.filter-select:focus,
            .location-search:focus,
            .category-dd-btn:focus {
                outline: none;
                border-color: var(--rh-gold, #d68e0e);
                box-shadow: 0 0 0 4px rgba(237, 164, 35, 0.15);
                background: #ffffff;
            }

            .filter-arrow {
                transition: transform 0.2s ease;
                pointer-events: none;
            }
            select.filter-select:focus ~ .filter-arrow,
            .category-dd.open .filter-arrow {
                transform: rotate(180deg);
            }

            /* ---- CATEGORY BUTTON — icon + label row ---- */
            .category-dd-btn {
                display: inline-flex;
                align-items: center;
                gap: 9px;
                text-align: left;
                white-space: nowrap;
            }
            .category-btn-icon {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                color: #d99218;
                flex-shrink: 0;
            }
            .category-btn-icon svg {
                width: 16px;
                height: 16px;
            }

            /* ---- SHARED PANEL STYLES (location + category) ---- */
            .location-suggestions,
            .category-panel {
                display: none;
                position: absolute;
                top: calc(100% + 8px);
                left: 0;
                min-width: 260px;
                max-height: 320px;
                overflow-y: auto;
                background: #ffffff;
                border: 1px solid var(--rh-line, #e2e8f0);
                border-radius: 14px;
                box-shadow: 0 18px 40px rgba(28, 42, 56, 0.16);
                z-index: 600;
                padding: 6px;
                animation: locDropIn 0.16s ease;
            }
            @keyframes locDropIn {
                from {
                    opacity: 0;
                    transform: translateY(-6px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
            .location-suggestions.open,
            .category-panel.open {
                display: block;
            }

            .loc-group-label {
                padding: 8px 12px 4px;
                font-size: 0.68rem;
                font-weight: 800;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                color: #9aa4af;
            }

            .location-suggestions button,
            .category-panel button {
                display: flex;
                align-items: center;
                gap: 10px;
                width: 100%;
                padding: 9px 12px;
                border: none;
                border-radius: 10px;
                background: none;
                cursor: pointer;
                font: inherit;
                font-size: 0.88rem;
                font-weight: 500;
                color: #1c2a38;
                text-align: left;
                transition:
                    background 0.12s ease,
                    color 0.12s ease;
            }
            .location-suggestions button:hover,
            .location-suggestions button.highlighted,
            .category-panel button:hover {
                background: #fdf1dc;
                color: #b07708;
            }

            .loc-dot {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 30px;
                height: 30px;
                border-radius: 9px;
                background: #fff6e9;
                border: 1px solid rgba(237, 164, 35, 0.35);
                color: #d99218;
                flex-shrink: 0;
            }
            .loc-dot svg {
                width: 15px;
                height: 15px;
            }
            .location-suggestions button.highlighted .loc-dot,
            .category-panel button:hover .loc-dot {
                background: #f6c04e;
                color: #1c2a38;
            }

            .loc-badge {
                margin-left: auto;
                font-size: 0.68rem;
                font-weight: 700;
                color: #8a94a0;
                background: #f1f4f7;
                border: 1px solid #e2e8f0;
                border-radius: 999px;
                padding: 3px 10px;
                white-space: nowrap;
            }
            .location-suggestions button.highlighted .loc-badge {
                color: #b07708;
                background: #fdf1dc;
                border-color: #f0d9a8;
            }
            .loc-empty {
                padding: 14px;
                font-size: 0.85rem;
                color: #8a94a0;
            }

            /* =====================================================
                                       LOCATION PANEL — stage 2 extras
                                       (back row, whole-province row, match highlight)
                                    ====================================================== */
            .loc-back-row {
                display: flex;
                align-items: center;
                gap: 6px;
                width: 100%;
                padding: 8px 12px;
                border: none;
                border-radius: 10px;
                background: none;
                cursor: pointer;
                font: inherit;
                font-size: 0.78rem;
                font-weight: 700;
                color: #57655c;
                text-align: left;
                margin-bottom: 2px;
                transition:
                    background 0.12s ease,
                    color 0.12s ease;
            }
            .loc-back-row:hover {
                background: #f1f4f7;
                color: #b07708;
            }

            .loc-all-row {
                border-bottom: 1px dashed #e2e8f0;
                border-radius: 10px 10px 0 0;
                font-weight: 600;
            }

            b.loc-hl {
                color: #b07708;
                font-weight: 800;
            }

            /* =====================================================
                                       CLEAR (X) BUTTON — location search
                                       Sits in the input's 36px right padding zone.
                                    ====================================================== */
            .loc-clear-btn {
                position: absolute;
                right: 9px;
                top: 50%;
                transform: translateY(-50%);

                display: none;
                align-items: center;
                justify-content: center;

                width: 22px;
                height: 22px;
                padding: 0;

                border: none;
                border-radius: 50%;

                background: #eef1f6;
                color: #57655c;

                cursor: pointer;
                z-index: 5;

                transition:
                    background 0.15s ease,
                    color 0.15s ease,
                    transform 0.15s ease;
            }

            .loc-clear-btn.visible {
                display: inline-flex;
            }

            .loc-clear-btn:hover {
                background: #fdecec;
                color: #a1332e;
                transform: translateY(-50%) scale(1.08);
            }

            .loc-clear-btn svg {
                width: 11px;
                height: 11px;
                display: block;
            }

            /* ---- CATEGORY PANEL specifics ---- */
            .category-panel {
                min-width: 240px;
            }
            .category-panel .cat-check {
                margin-left: auto;
                width: 18px;
                height: 18px;
                color: #d99218;
                flex-shrink: 0;
            }
            .category-panel .cat-check svg {
                width: 16px;
                height: 16px;
            }
            .category-panel button.active {
                background: #fdf3e0;
                color: #b07708;
                font-weight: 600;
            }
            .category-panel button.active .loc-dot {
                background: #f6c04e;
                color: #1c2a38;
            }

            /* AMENITY CHIPS ON CARDS */
            .rh-card-amenities {
                display: flex;
                flex-wrap: wrap;
                gap: 5px;
                margin-top: 2px;
            }
            .rh-chip-mini {
                font-size: 0.68rem;
                font-weight: 600;
                color: #9c6a08;
                background: #f1e3c4;
                border: 1px solid #e2d0a8;
                border-radius: 999px;
                padding: 3px 9px;
                white-space: nowrap;
            }
            .rh-chip-more {
                font-size: 0.68rem;
                font-weight: 600;
                color: #57655c;
                align-self: center;
            }

            /* AMENITIES BAR */
            .filter-bar.amenities-bar {
                position: static;
                margin-top: 8px;
                flex-wrap: wrap;
                gap: 8px;
                padding: 8px 10px;
            }
            .amenities-bar-label {
                flex: 0 0 auto;
                padding: 6px 12px;
            }
            .amenities-bar-title {
                font-size: 0.88rem;
                font-weight: 600;
                color: var(--rh-ink, #1c1c1c);
                white-space: nowrap;
            }
            .amenity-toggle-btn {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                cursor: pointer;
                border: 1px solid var(--rh-line, #e2e8f0);
                background: var(--rh-cloud, #f7f9fb);
                border-radius: 999px;
                padding: 8px 16px;
                font-family: inherit;
                font-size: 0.85rem;
                font-weight: 500;
                color: var(--rh-ink-soft, #57655c);
                white-space: nowrap;
                transition:
                    border-color 0.15s ease,
                    color 0.15s ease,
                    background 0.15s ease;
            }
            .amenity-toggle-btn:hover {
                border-color: var(--rh-gold, #d68e0e);
                color: var(--rh-gold-deep, #9c6a08);
            }
            .amenity-toggle-btn.active {
                background: var(--rh-gold-wash, #fdf3e0);
                border-color: var(--rh-gold, #d68e0e);
                color: var(--rh-gold-deep, #9c6a08);
                font-weight: 600;
            }
            .amenity-check {
                font-size: 0.8rem;
                line-height: 1;
            }
            .amenity-ico {
                width: 15px;
                height: 15px;
                opacity: 0.75;
                flex-shrink: 0;
            }
            .amenity-toggle-btn.active .amenity-ico {
                opacity: 1;
            }

            /* PRICE RANGE — LIVE */
            .price-value {
                transition:
                    color 0.15s ease,
                    transform 0.15s ease;
            }
            .price-value.price-live {
                color: var(--rh-gold-deep, #9c6a08);
                font-weight: 700;
                transform: scale(1.08);
            }

            /* PRICE RANGE — filled track follows the thumb.
                                       Base (unfilled) color here; JS paints the gold
                                       gradient up to the thumb position on load + drag. */
            .price-range {
                -webkit-appearance: none;
                appearance: none;
                height: 6px;
                border-radius: 999px;
                background: #e2e8f0;
                outline: none;
                cursor: pointer;
            }
            .price-range::-webkit-slider-thumb {
                -webkit-appearance: none;
                appearance: none;
                width: 16px;
                height: 16px;
                border-radius: 50%;
                background: #d68e0e;
                border: 2px solid #ffffff;
                box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
                cursor: pointer;
            }
            .price-range::-moz-range-thumb {
                width: 16px;
                height: 16px;
                border-radius: 50%;
                background: #d68e0e;
                border: 2px solid #ffffff;
                box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
                cursor: pointer;
            }

            /* LUCIDE */
            svg.lucide {
                display: inline-block;
                vertical-align: -0.18em;
                flex-shrink: 0;
            }
            .filter-icon,
            .filter-arrow {
                width: 15px;
                height: 15px;
                flex-shrink: 0;
            }
            .rh-loc-ico {
                width: 13px;
                height: 13px;
                flex-shrink: 0;
            }
            .rh-view-btn svg {
                width: 16px;
                height: 16px;
                display: block;
            }
            .search-button svg {
                width: 17px;
                height: 17px;
                display: block;
            }

            /* PAGINATION */
            .rh-pagination {
                display: flex;
                gap: 6px;
                flex-wrap: wrap;
                align-items: center;
                justify-content: center;
                margin-top: 26px;
            }
            .rh-pagination a {
                min-width: 36px;
                padding: 8px 11px;
                text-align: center;
                border: 1px solid var(--rh-line, #e2e8f0);
                border-radius: 9px;
                font-size: 13px;
                font-weight: 700;
                text-decoration: none;
                color: var(--rh-ink-soft, #57655c);
                background: #ffffff;
                transition:
                    background 0.15s ease,
                    color 0.15s ease;
            }
            .rh-pagination a:hover {
                border-color: var(--rh-gold, #d68e0e);
                color: var(--rh-gold-deep, #9c6a08);
            }
            .rh-pagination a.current {
                color: #ffffff;
                background: var(--rh-gold, #d68e0e);
                border-color: var(--rh-gold, #d68e0e);
            }
            /* =====================================================
                                       WISHLIST HEART — top-right of every space card
                                    ====================================================== */
            .rh-card-media {
                position: relative;
            }
            .rh-wish-btn {
                position: absolute;
                top: 12px;
                right: 12px;
                z-index: 30;

                display: inline-flex;
                align-items: center;
                justify-content: center;

                width: 38px;
                height: 38px;
                padding: 0;

                border: none;
                border-radius: 50%;

                background: rgba(255, 255, 255, 0.92);
                color: #1c2a38;

                cursor: pointer;
                box-shadow: 0 2px 10px rgba(28, 42, 56, 0.22);

                transition:
                    transform 0.15s ease,
                    box-shadow 0.15s ease,
                    background 0.15s ease;
            }
            .rh-wish-btn:hover {
                transform: scale(1.08);
                background: #ffffff;
                box-shadow: 0 4px 14px rgba(28, 42, 56, 0.28);
            }
            .rh-wish-btn:active {
                transform: scale(0.94);
            }
            .rh-wish-btn:focus-visible {
                outline: 2px solid var(--rh-gold, #d68e0e);
                outline-offset: 2px;
            }
            .rh-wish-btn svg {
                width: 18px;
                height: 18px;
                display: block;
            }
            /* outline heart by default, filled heart once saved */
            .rh-wish-btn .rh-wish-fill {
                display: none;
            }
            .rh-wish-btn.saved {
                color: #d68e0e;
            }
            .rh-wish-btn.saved .rh-wish-outline {
                display: none;
            }
            .rh-wish-btn.saved .rh-wish-fill {
                display: block;
            }
            /* GLOW — saved hearts pulse with a soft GOLD ring that
                           radiates outward, matching the site's gold theme.
                           Runs alongside the .pop bounce (pop animates the svg,
                           glow animates the button's box-shadow). */
            .rh-wish-btn.saved {
                animation: rhWishGlow 1.6s ease-in-out infinite;
            }
            @keyframes rhWishGlow {
                0%,
                100% {
                    box-shadow:
                        0 0 0 0 rgba(237, 164, 35, 0.55),
                        0 2px 10px rgba(28, 42, 56, 0.22);
                }
                50% {
                    box-shadow:
                        0 0 0 9px rgba(237, 164, 35, 0),
                        0 2px 10px rgba(28, 42, 56, 0.22);
                }
            }
            /* hover keeps the glow running (animation owns box-shadow)
                           but still lifts + brightens so the cursor feels alive */
            .rh-wish-btn.saved:hover {
                transform: scale(1.08);
                background: #ffffff;
            }
            /* dark mode — brighter gold on dark cards */
            html.dark .rh-wish-btn.saved {
                color: #f6c04e;
                animation-name: rhWishGlowDark;
            }
            @keyframes rhWishGlowDark {
                0%,
                100% {
                    box-shadow:
                        0 0 0 0 rgba(246, 192, 78, 0.55),
                        0 2px 10px rgba(0, 0, 0, 0.35);
                }
                50% {
                    box-shadow:
                        0 0 0 9px rgba(246, 192, 78, 0),
                        0 2px 10px rgba(0, 0, 0, 0.35);
                }
            }
            /* reduced motion — static glow ring, no pulsing */
            @media (prefers-reduced-motion: reduce) {
                .rh-wish-btn.saved,
                html.dark .rh-wish-btn.saved {
                    animation: none;
                    box-shadow:
                        0 0 0 4px rgba(237, 164, 35, 0.4),
                        0 2px 10px rgba(28, 42, 56, 0.22);
                }
            }
            /* pop animation on toggle */
            @keyframes rhWishPop {
                0% {
                    transform: scale(0.6);
                }
                55% {
                    transform: scale(1.25);
                }
                100% {
                    transform: scale(1);
                }
            }
            .rh-wish-btn.pop svg {
                animation: rhWishPop 0.32s ease;
            }

            /* =====================================================
                                       ENQUIRY WAITING CARD — a listing the viewer
                                       has a PENDING application on stays in their
                                       grid, but the card renders slightly blurred
                                       with a 3-dot loader, the "Waiting for host
                                       to accept" caption and a Cancel button.
                                       Cancel posts to the SAME
                                       /booking/cancel-booking endpoint the My
                                       Bookings page uses (a fresh enquiry has
                                       nothing paid, so no refund applies).
                                    ====================================================== */
            .listing-box {
                position: relative;
            }
            /* the card content blurs; the overlay floats above it */
            .listing-box.rh-enquiry-wait .rh-card-media,
            .listing-box.rh-enquiry-wait .listing-box-info {
                filter: blur(3px);
                pointer-events: none;
            }
            .rh-enquiry-overlay {
                position: absolute;
                inset: 0;
                z-index: 40;

                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 9px;
                padding: 14px;
                text-align: center;

                background: rgba(255, 255, 255, 0.55);
                -webkit-backdrop-filter: blur(2px);
                backdrop-filter: blur(2px);
                border-radius: inherit;
                cursor: default;
            }
            /* 3-dot loading animation */
            .rh-enq-dots {
                display: flex;
                align-items: center;
                gap: 7px;
            }
            .rh-enq-dots span {
                width: 9px;
                height: 9px;
                border-radius: 50%;
                background: var(--rh-gold, #d68e0e);
                animation: rhEnqDot 1.2s infinite ease-in-out;
            }
            .rh-enq-dots span:nth-child(2) {
                animation-delay: 0.15s;
            }
            .rh-enq-dots span:nth-child(3) {
                animation-delay: 0.3s;
            }
            @keyframes rhEnqDot {
                0%,
                80%,
                100% {
                    transform: scale(0.55);
                    opacity: 0.35;
                }
                40% {
                    transform: scale(1);
                    opacity: 1;
                }
            }
            .rh-enq-label {
                margin: 0;
                font-family: inherit;
                font-size: 13.5px;
                font-weight: 700;
                line-height: 1.35;
                color: #1c2a38;
            }
            /* Cancel — same quiet outline style as the pagination
                           buttons; hover borrows the gold theme */
            .rh-enq-cancel {
                appearance: none;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                margin-top: 3px;
                padding: 7px 24px;

                border: 1px solid var(--rh-line, #e2e8f0);
                border-radius: 9px;
                background: #ffffff;
                color: #1c2a38;
                font-family: inherit;
                font-size: 13px;
                font-weight: 700;
                line-height: 1;
                cursor: pointer;

                transition:
                    background 0.15s ease,
                    color 0.15s ease,
                    border-color 0.15s ease;
            }
            .rh-enq-cancel:hover {
                border-color: var(--rh-gold, #d68e0e);
                color: var(--rh-gold-deep, #9c6a08);
            }
            .rh-enq-cancel:disabled {
                opacity: 0.6;
                cursor: default;
            }
            .rh-enq-cancel:focus-visible {
                outline: 2px solid var(--rh-gold, #d68e0e);
                outline-offset: 2px;
            }
            /* dark mode — frost turns to smoked glass */
            html.dark .rh-enquiry-overlay {
                background: rgba(10, 18, 28, 0.55);
            }
            html.dark .rh-enq-label {
                color: #e7eef6;
            }
            html.dark .rh-enq-cancel {
                background: rgba(255, 255, 255, 0.08);
                border-color: rgba(255, 255, 255, 0.22);
                color: #e7eef6;
            }
            html.dark .rh-enq-cancel:hover {
                border-color: var(--rh-gold, #d68e0e);
                color: #f6c04e;
            }
            /* reduced motion — dots hold still instead of bouncing */
            @media (prefers-reduced-motion: reduce) {
                .rh-enq-dots span {
                    animation: none;
                    opacity: 0.55;
                    transform: scale(0.8);
                }
            }
            /* ============ CARD RATING SCALE -- the 5-star track on
               each listing card, replacing the bare "No reviews yet"
               text. Page-local on purpose: listings-style.css stays
               untouched. The dim row is the track; the gold row sits
               exactly on top of it and clips to (rating / 5 * 100)%, so
               fractional averages scale star by star. The gold matches
               the ratings overlay on the detail page; dark mode handled
               below. */
            .rh-card-rating {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                flex: 0 0 auto;
                line-height: 1;
                white-space: nowrap;
            }
            .rh-stars {
                position: relative;
                display: inline-block;
                line-height: 0;
            }
            /* STAR SCALE v2 -- bigger stars (16px) and a GAP-FREE row:
               five 16px boxes make an 80px track whose star boundaries
               fall on exact 20% steps, so the gold fill clips precisely
               on the right star at ANY average (3.0 = 3 crisp full
               stars, 3.5 = exactly half of the fourth, 4.3 = exactly
               30% of the fifth). The glyph is letterboxed inside its
               box, which keeps the visual spacing. */
            .rh-stars-row {
                display: inline-flex;
                flex-wrap: nowrap;
                gap: 0;
            }
            .rh-star {
                width: 16px;
                height: 16px;
                display: block;
            }
            .rh-stars-base {
                color: #d3d9e3;
            }
            .rh-stars-fill {
                position: absolute;
                top: 0;
                left: 0;
                height: 100%;
                overflow: hidden;
                color: #eda423;
                pointer-events: none;
            }
            .rh-stars-text {
                display: inline-flex;
                align-items: baseline;
                gap: 3px;
                font-size: 13px;
                line-height: 1;
            }
            .rh-stars-num {
                font-weight: 700;
                color: #14142b;
            }
            .rh-stars-count {
                font-weight: 600;
                color: #8b93a6;
            }
            html.dark .rh-stars-base {
                color: rgba(255, 255, 255, 0.22);
            }
            html.dark .rh-stars-num {
                color: #e8eef5;
            }
            html.dark .rh-stars-count {
                color: #a9b8c8;
            }
        </style>
    </head>

    <body>

        {# Category icons — Lucide names per slug #}
        {% set category_icons = {
        'shared-bedroom': 'bed-double',
        'private-room':   'door-open',
        'entire-house':   'house',
        'boarding-house': 'building-2',
        'studio-loft':    'warehouse',
        'apartment':      'building',
    } %}

        {# Icon currently shown IN THE BAR — matches the active filter #}
        {% set current_category_icon = selected.category
        ? (category_icons[selected.category] ?? 'house')
        : 'layout-grid' %}

        {% include 'partials/navbar.html.twig' with { current_page: '/listings' } %}

        <main class="listings-page">

            {# ============ MAIN FILTER BAR ============ #}
            <form class="filter-bar" method="get" action="{{ path('app_listings') }}" id="filter-form">

                {# LOCATION — province → towns autocomplete.
                   Stage 1: all provinces A–Z. Stage 2: towns A–Z.
                   Typing filters both. Free text always allowed.
                   X button clears the location entirely. #}
                <div class="filter-group location-group">
                    <i data-lucide="map-pin" class="filter-icon"></i>
                    <input
                        type="text"
                        class="location-search"
                        id="location-search"
                        placeholder="Search a province or town..."
                        value="{{ selected.location ? selected.location ~ ', ' ~ selected.province : selected.province }}"
                        autocomplete="off"
                    >
                    <button
                        type="button"
                        class="loc-clear-btn"
                        id="location-clear"
                        aria-label="Clear location search"
                    >
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 6 6 18"/>
                            <path d="m6 6 12 12"/>
                        </svg>
                    </button>
                    <input type="hidden" name="province" id="province-hidden" value="{{ selected.province }}">
                    <input type="hidden" name="location" id="location-hidden" value="{{ selected.location }}">
                    <div class="location-suggestions" id="location-suggestions"></div>
                </div>

                <div class="filter-divider"></div>

                {# CATEGORY — custom dropdown; the BAR shows the
               selected category's icon + label #}
                <div class="filter-group category-dd" id="category-dd">
                    <i data-lucide="tag" class="filter-icon"></i>
                    <button
                        type="button"
                        class="category-dd-btn"
                        id="category-btn"
                        aria-haspopup="listbox"
                        aria-expanded="false"
                    >
                        <span class="category-btn-icon" id="category-btn-icon">
                            <i data-lucide="{{ current_category_icon }}"></i>
                        </span>
                        <span id="category-btn-label">{{ selected_category_label }}</span>
                    </button>
                    <i data-lucide="chevron-down" class="filter-arrow"></i>
                    <input type="hidden" name="category" id="category-value" value="{{ selected.category }}">

                    <div class="category-panel" id="category-panel" role="listbox">

                        <button
                            type="button"
                            role="option"
                            class="{{ selected.category == '' ? 'active' : '' }}"
                            data-value=""
                        >
                            <span class="loc-dot"><i data-lucide="layout-grid"></i></span>
                            <span>All Categories</span>
                            <span class="cat-check">{% if selected.category == '' %}<i data-lucide="check"></i>{% endif %}</span>
                        </button>

                        {% for value, label in categories %}
                            <button
                                type="button"
                                role="option"
                                class="{{ selected.category == value ? 'active' : '' }}"
                                data-value="{{ value }}"
                            >
                                <span class="loc-dot"><i data-lucide="{{ category_icons[value] ?? 'house' }}"></i></span>
                                <span>{{ label }}</span>
                                <span class="cat-check">{% if selected.category == value %}<i data-lucide="check"></i>{% endif %}</span>
                            </button>
                        {% endfor %}

                    </div>
                </div>

                <div class="filter-divider"></div>

                <div class="filter-group price-filter">
                    <span class="price-icon">₱</span>
                    <span class="price-value" id="price-min">0</span>
                    <input
                        type="range"
                        class="price-range"
                        id="price-range"
                        name="price_max"
                        min="0"
                        max="20000"
                        step="500"
                        value="{{ selected.price_max }}"
                    >
                    <span class="price-value" id="price-max">{{ selected.price_max|number_format(0) }}</span>
                </div>

                <div class="filter-divider"></div>

                <div class="filter-group search-group">
                    <input
                        type="text"
                        class="search-input"
                        name="q"
                        placeholder="Search.."
                        value="{{ selected.q }}"
                    >
                    <button class="search-button" type="submit">
                        <i data-lucide="search"></i>
                    </button>
                </div>

            </form>

            {# ============ AMENITIES BAR ============ #}
            <div class="filter-bar amenities-bar" id="amenities-bar">

                <div class="filter-group amenities-bar-label">
                    <i data-lucide="house" class="filter-icon"></i>
                    <span class="amenities-bar-title">Amenities</span>
                </div>

                <div class="filter-divider"></div>

                {% for key, label in amenity_options %}
                    <label class="amenity-toggle-btn{{ key in selected.amenities ? ' active' : '' }}">
                        <input
                            type="checkbox"
                            class="js-hidden"
                            name="amenities[]"
                            value="{{ key }}"
                            {{ key in selected.amenities ? 'checked' : '' }}
                            onchange="document.getElementById('filter-form').submit()"
                        >
                        {% if amenity_icons[key] %}
                            <i data-lucide="{{ amenity_icons[key] }}" class="amenity-ico"></i>
                        {% endif %}
                        <span class="amenity-check">{{ key in selected.amenities ? '&#10003;' : '' }}</span>
                        {{ label }}
                    </label>
                {% endfor %}

                {% if selected.amenities is not empty %}
                    <button type="button" class="amenity-toggle-btn" onclick="window.location='{{ path('app_listings') }}'">
                        Clear
                    </button>
                {% endif %}

            </div>

            {# ============ LISTINGS ============ #}
            <section class="listings-content">
                <div class="listings-main">

                    <div class="rh-results-bar">
                        <div class="rh-toolbar">
                            <p class="rh-results-count" id="rh-results-count">
                                Showing {{ listings|length }} of {{ total_items }} space{{ total_items == 1 ? '' : 's' }}
                            </p>
                            <div class="rh-toolbar-actions">
                                <select
                                    class="rh-sort"
                                    id="rh-sort"
                                    name="sort"
                                    form="filter-form"
                                    aria-label="Sort listings"
                                    onchange="document.getElementById('filter-form').submit()"
                                >
                                    <option value="featured" {{ selected.sort == 'featured' ? 'selected' : '' }}>Featured</option>
                                    <option value="price-asc" {{ selected.sort == 'price-asc' ? 'selected' : '' }}>Price: Low &rarr; High</option>
                                    <option value="price-desc" {{ selected.sort == 'price-desc' ? 'selected' : '' }}>Price: High &rarr; Low</option>
                                </select>
                                <div class="rh-view-toggle" role="group" aria-label="Layout">
                                    <button type="button" class="rh-view-btn active" data-view="grid" aria-label="Grid view"><i data-lucide="layout-grid"></i></button>
                                    <button type="button" class="rh-view-btn" data-view="list" aria-label="List view"><i data-lucide="list"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="listings-results" id="rh-listings-results">

                        {% if listings is empty %}
                            <div class="rh-empty-state">
                                <p class="rh-empty-title">No listings match your filters</p>
                                <p class="rh-empty-subtitle">
                                    Try widening your price range, removing an amenity,
                                    or searching a different area.
                                </p>
                                {% if has_active_filters %}
                                    <a class="rh-empty-clear-btn" href="{{ path('app_listings') }}">Clear all filters</a>
                                {% endif %}
                            </div>
                        {% endif %}

                        {% for listing in listings %}
                            {% set isNew = listing.createdAt >= date('-14 days') %}
                            {% set enqPending = listing.enquiryPending ?? false %}
                            {% set chips = listing.amenities %}
                            {% if listing.hasParking and 'parking' not in chips %}
                                {% set chips = ['parking']|merge(chips) %}
                            {% endif %}

                            <a
                                href="{{ path('app_listing_detail', { id: listing.id }) }}"
                                class="listing-box{{ enqPending ? ' rh-enquiry-wait' : '' }}"
                            >

                                <div class="rh-card-media">
                                    <img src="{{ asset(listing.coverImage) }}" alt="{{ listing.title }}">
                                    <div class="rh-card-badges">
                                        {% if isNew %}<span class="rh-badge rh-badge-new">New</span>{% endif %}
                                    </div>

                                    <button
                                        type="button"
                                        class="rh-wish-btn{{ listing.id in wishlist_ids|default([]) ? ' saved' : '' }}"
                                        data-listing-id="{{ listing.id }}"
                                        aria-pressed="{{ listing.id in wishlist_ids|default([]) ? 'true' : 'false' }}"
                                        aria-label="{{ listing.id in wishlist_ids|default([]) ? 'Remove from wishlist' : 'Save to wishlist' }}"
                                        title="{{ listing.id in wishlist_ids|default([]) ? 'Remove from wishlist' : 'Save to wishlist' }}"
                                    >
                                        <svg class="rh-wish-outline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                                        </svg>
                                        <svg class="rh-wish-fill" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
                                            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                                        </svg>
                                    </button>
                                </div>

                                <div class="listing-box-info">
                                    <div class="rh-card-title-row">
                                        <h4 class="listing-box-title">{{ listing.title }}</h4>
                                        {# RATING SCALE -- the 5-star track renders on every card; the
                                            gold fill row sits exactly on the dim track and clips to
                                            (rating / 5 * 100)% so a 4.3 average paints 4 full stars plus
                                            a 30%-lit fifth. 0 reviews keeps the track empty next to
                                            "No reviews yet". Data comes from the index controller
                                            (rating + reviews keys per listing); styles live at the top
                                            of this file, page-local on purpose. #}
                                        {% set rh_rating = listing.rating ?? 0 %}
                                        {% set rh_reviews = listing.reviews ?? 0 %}
                                        <span class="rh-card-rating" role="img" aria-label="{% if rh_reviews > 0 %}Rated {{ rh_rating|number_format(1) }} out of 5 from {{ rh_reviews }} {{ rh_reviews == 1 ? 'review' : 'reviews' }}{% else %}No reviews yet{% endif %}">
                                            <span class="rh-stars" aria-hidden="true">
                                                <span class="rh-stars-row rh-stars-base">{% for _rh_i in 1..5 %}<svg class="rh-star" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>{% endfor %}</span>
                                                <span class="rh-stars-row rh-stars-fill" style="width: {{ ((rh_rating / 5) * 100)|number_format(1) }}%">{% for _rh_i in 1..5 %}<svg class="rh-star" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>{% endfor %}</span>
                                            </span>
                                            <span class="rh-stars-text">
                                                {% if rh_reviews > 0 %}
                                                    <span class="rh-stars-num">{{ rh_rating|number_format(1) }}</span>
                                                    <span class="rh-stars-count">({{ rh_reviews }})</span>
                                                {% else %}
                                                    <span class="rh-rating-none">No reviews yet</span>
                                                {% endif %}
                                            </span>
                                        </span>
                                    </div>

                                    <div class="listing-box-location">
                                        <i data-lucide="map-pin" class="rh-loc-ico"></i>
                                        <span>{{ listing.location }}{% if listing.province %}, {{ listing.province }}{% endif %}</span>
                                    </div>

                                    <div class="rh-card-price-row">
                                        <span class="rh-card-price">
                                            &#8369; {{ listing.price|number_format(0) }}
                                            <span class="rh-card-per">/ month</span>
                                        </span>
                                    </div>

                                    <div class="rh-card-amenities">
                                        {% for key in chips|slice(0, 3) %}
                                            <span class="rh-chip-mini">{{ amenity_options[key] ?? key|replace({'-': ' '})|title }}</span>
                                        {% endfor %}
                                        {% if chips|length > 3 %}
                                            <span class="rh-chip-more">+{{ chips|length - 3 }} more</span>
                                        {% endif %}
                                    </div>
                                </div>

                                {% if enqPending %}
                                    {# ENQUIRY WAITING CARD — this viewer has
                                       a PENDING application on this space:
                                       the card goes slightly blurred with a
                                       3-dot loader + "Waiting for host to
                                       accept" + a Cancel button. The card
                                       itself still links to the detail page
                                       (which shows the tracking note); only
                                       the Cancel button intercepts clicks. #}
                                    <div class="rh-enquiry-overlay" role="status" aria-live="polite">
                                        <div class="rh-enq-dots" aria-hidden="true">
                                            <span></span><span></span><span></span>
                                        </div>
                                        <p class="rh-enq-label">Waiting for host to accept</p>
                                        <button
                                            type="button"
                                            class="rh-enq-cancel"
                                            data-booking-id="{{ listing.enquiryBookingId }}"
                                            title="Cancel this enquiry"
                                        >Cancel</button>
                                    </div>
                                {% endif %}

                            </a>
                        {% endfor %}

                    </div>

                    {% if total_pages > 1 %}
                        <div class="rh-pagination">
                            {% for p in 1..total_pages %}
                                <a
                                    href="{{ path('app_listings', app.request.query.all|merge({ page: p })) }}"
                                    class="{{ p == page ? 'current' : '' }}"
                                >{{ p }}</a>
                            {% endfor %}
                        </div>
                    {% endif %}

                </div>
            </section>

        </main>

