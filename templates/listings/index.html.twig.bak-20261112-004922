                /* =====================================================
                                           LOCATION AUTOCOMPLETE — A–Z provinces → towns
                                           Stage 1: click/focus (empty) → ALL provinces A–Z
                                                    under letter headers
                                           Stage 2: picked province → its towns A–Z,
                                                    "All of {Province}", back row
                                           Typing:  filters provinces AND towns at any stage
                                           Free text is never blocked — on submit, whatever
                                           is typed lands in the hidden fields.
                                           X button clears the location entirely and
                                           refreshes the results (other filters kept).
                                        ====================================================== */
                var input = document.getElementById("location-search");
                var panel = document.getElementById("location-suggestions");
                var form = document.getElementById("filter-form");
                var provHid = document.getElementById("province-hidden");
                var locHid = document.getElementById("location-hidden");
                var clearBtn = document.getElementById("location-clear");

                if (!input || !panel || !form || !provHid || !locHid) {
                    return;
                }

                var items = [];
                var active = -1;
                var mode = "province"; /* 'province' | 'town' */
                var currentProvince = "";

                var ICON_PROVINCE =
                    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" y1="3" x2="9" y2="18"/><line x1="15" y1="6" x2="15" y2="21"/></svg>';
                var ICON_TOWN =
                    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>';

                function norm(s) {
                    return (s || "").toLowerCase().replace(/\s+/g, " ").trim();
                }

                function sortedProvinces() {
                    return Object.keys(PH).sort(function (a, b) {
                        return a.localeCompare(b);
                    });
                }

                function sortedTowns(province) {
                    return (PH[province] || []).slice().sort(function (a, b) {
                        return a.localeCompare(b);
                    });
                }

                function isOpen() {
                    return panel.classList.contains("open");
                }

                function closePanel() {
                    panel.classList.remove("open");
                    panel.innerHTML = "";
                    items = [];
                    active = -1;
                }

                function setActive(idx) {
                    if (!items.length) {
                        return;
                    }
                    if (active >= 0 && items[active]) {
                        items[active].classList.remove("highlighted");
                    }
                    active = (idx + items.length) % items.length;
                    items[active].classList.add("highlighted");
                    items[active].scrollIntoView({ block: "nearest" });
                }

                /* label with the typed match highlighted */
                function makeLabel(text, q) {
                    var span = document.createElement("span");
                    if (q) {
                        var i = text.toLowerCase().indexOf(q.toLowerCase());
                        if (i >= 0) {
                            span.appendChild(document.createTextNode(text.slice(0, i)));
                            var b = document.createElement("b");
                            b.className = "loc-hl";
                            b.textContent = text.substr(i, q.length);
                            span.appendChild(b);
                            span.appendChild(
                                document.createTextNode(text.slice(i + q.length)),
                            );
                            return span;
                        }
                    }
                    span.textContent = text;
                    return span;
                }

                function makeButton(name, badgeText, iconSvg, onClick, q) {
                    var btn = document.createElement("button");
                    btn.type = "button";

                    var dot = document.createElement("span");
                    dot.className = "loc-dot";
                    dot.innerHTML = iconSvg;
                    btn.appendChild(dot);

                    btn.appendChild(makeLabel(name, q || ""));

                    if (badgeText) {
                        var badge = document.createElement("span");
                        badge.className = "loc-badge";
                        badge.textContent = badgeText;
                        btn.appendChild(badge);
                    }

                    btn.addEventListener("click", onClick);
                    return btn;
                }

                function findProvince(name) {
                    var n = (name || "").trim().toLowerCase();
                    if (!n) {
                        return "";
                    }

                    var exact = null;
                    var starts = [];

                    Object.keys(PH).forEach(function (p) {
                        var lp = p.toLowerCase();
                        if (lp === n) {
                            exact = p;
                        } else if (lp.startsWith(n)) {
                            starts.push(p);
                        }
                    });

                    if (exact) {
                        return exact;
                    }
                    return starts.length === 1 ? starts[0] : "";
                }

                /* Keep the hidden fields in step with what's typed so
                                           free-text searches still reach the server. */
                function syncHiddenFromText() {
                    var v = input.value.trim();

                    if (!v) {
                        provHid.value = "";
                        locHid.value = "";
                        return;
                    }

                    /* "Town, Province" with a known province? */
                    var comma = v.indexOf(",");
                    if (comma > 0) {
                        var townPart = v.slice(0, comma).trim();
                        var provPart = v.slice(comma + 1).trim();
                        if (townPart && PH.hasOwnProperty(provPart)) {
                            provHid.value = provPart;
                            locHid.value = townPart;
                            return;
                        }
                    }

                    var province = findProvince(v);
                    if (province) {
                        provHid.value = province;
                        locHid.value = "";
                        return;
                    }

                    /* Free text — goes through the location LIKE filter */
                    provHid.value = "";
                    locHid.value = v;
                }

                /* ---------- CLEAR (X) BUTTON ---------- */
                function updateClearBtn() {
                    if (clearBtn) {
                        clearBtn.classList.toggle("visible", input.value.trim() !== "");
                    }
                }

                if (clearBtn) {
                    clearBtn.addEventListener("click", function (e) {
                        e.stopPropagation();

                        /* wipe everything location-related */
                        input.value = "";
                        provHid.value = "";
                        locHid.value = "";
                        mode = "province";
                        currentProvince = "";
                        closePanel();
                        updateClearBtn();

                        /* refresh results WITHOUT the location filter —
                                                   category, price, amenities and q are kept.
                                                   Remove this form.submit() line if the X should
                                                   only clear the box (user presses Search after). */
                        form.submit();
                    });
                }

                /* ---------- STAGE 1 — provinces (A–Z) ---------- */
                function renderProvinceStage(query) {
                    panel.innerHTML = "";
                    items = [];
                    active = -1;

                    var q = norm(query);
                    var frag = document.createDocumentFragment();

                    if (q === "") {
                        /* ALL provinces, grouped under letter headers */
                        var letter = "";
                        sortedProvinces().forEach(function (province) {
                            if (province.charAt(0) !== letter) {
                                letter = province.charAt(0);
                                var head = document.createElement("div");
                                head.className = "loc-group-label";
                                head.textContent = letter;
                                frag.appendChild(head);
                            }

                            var btn = makeButton(
                                province,
                                "Province",
                                ICON_PROVINCE,
                                function () {
                                    onPickProvince(province);
                                },
                                "",
                            );
                            frag.appendChild(btn);
                            items.push(btn);
                        });

                        panel.appendChild(frag);
                        panel.classList.add("open");
                        updateClearBtn();
                        return;
                    }

                    /* typing — provinces first, then towns everywhere */
                    var provs = [];
                    var towns = [];

                    sortedProvinces().forEach(function (province) {
                        var lp = province.toLowerCase();
                        if (lp.startsWith(q)) {
                            provs.push(province);
                        }
                    });
                    sortedProvinces().forEach(function (province) {
                        var lp = province.toLowerCase();
                        if (!lp.startsWith(q) && lp.indexOf(q) !== -1) {
                            provs.push(province);
                        }
                    });

                    if (q.length >= 2) {
                        var townStarts = [];
                        var townContains = [];
                        sortedProvinces().forEach(function (province) {
                            sortedTowns(province).forEach(function (town) {
                                var lt = town.toLowerCase();
                                if (lt.startsWith(q)) {
                                    townStarts.push({ town: town, province: province });
                                } else if (lt.indexOf(q) !== -1) {
                                    townContains.push({ town: town, province: province });
                                }
                            });
                        });
                        towns = townStarts.concat(townContains);
                    }

                    if (!provs.length && !towns.length) {
                        var empty = document.createElement("div");
                        empty.className = "loc-empty";
                        empty.textContent =
                            'No location found for "' +
                            query +
                            '" — press Enter to search it anyway.';
                        panel.appendChild(empty);
                        panel.classList.add("open");
                        updateClearBtn();
                        return;
                    }

                    if (provs.length) {
                        var ph = document.createElement("div");
                        ph.className = "loc-group-label";
                        ph.textContent = "Provinces";
                        frag.appendChild(ph);

                        provs.slice(0, 6).forEach(function (province) {
                            var btn = makeButton(
                                province,
                                "Province",
                                ICON_PROVINCE,
                                function () {
                                    onPickProvince(province);
                                },
                                q,
                            );
                            frag.appendChild(btn);
                            items.push(btn);
                        });
                    }

                    if (towns.length) {
                        var th = document.createElement("div");
                        th.className = "loc-group-label";
                        th.textContent = "Cities & Towns";
                        frag.appendChild(th);

                        towns.slice(0, 10).forEach(function (match) {
                            var btn = makeButton(
                                match.town,
                                match.province,
                                ICON_TOWN,
                                function () {
                                    onPickTown(match.town, match.province);
                                },
                                q,
                            );
                            frag.appendChild(btn);
                            items.push(btn);
                        });
                    }

                    panel.appendChild(frag);
                    panel.classList.add("open");
                    updateClearBtn();
                }

                /* ---------- STAGE 2 — towns of one province ---------- */
                function townQuery() {
                    var v = input.value;
                    var lv = v.toLowerCase();
                    var lp = currentProvince.toLowerCase();

                    /* strip a leading "Iloilo" / "Iloilo, " so the rest
                                               of the typed text filters the town list */
                    if (lv.startsWith(lp)) {
                        v = v.slice(currentProvince.length);
                        if (v.charAt(0) === ",") {
                            v = v.slice(1);
                        }
                    }
                    return norm(v);
                }

                function renderTownStage() {
                    panel.innerHTML = "";
                    items = [];
                    active = -1;

                    var q = townQuery();
                    var frag = document.createDocumentFragment();

                    /* back to all provinces */
                    var back = document.createElement("button");
                    back.type = "button";
                    back.className = "loc-back-row";
                    back.innerHTML = "&#8592; All provinces";
                    back.addEventListener("click", function () {
                        onBackToProvinces();
                    });
                    frag.appendChild(back);

                    /* whole-province option */
                    var allBtn = makeButton(
                        "All of " + currentProvince,
                        "whole province",
                        ICON_PROVINCE,
                        function () {
                            onPickWholeProvince();
                        },
                        q,
                    );
                    allBtn.classList.add("loc-all-row");
                    frag.appendChild(allBtn);
                    items.push(allBtn);

                    var inProvince = [];
                    sortedTowns(currentProvince).forEach(function (town) {
                        if (q === "" || norm(town).indexOf(q) !== -1) {
                            inProvince.push(town);
                        }
                    });

                    inProvince.forEach(function (town) {
                        var btn = makeButton(
                            town,
                            currentProvince,
                            ICON_TOWN,
                            function () {
                                onPickTown(town, currentProvince);
                            },
                            q,
                        );
                        frag.appendChild(btn);
                        items.push(btn);
                    });

                    /* typed a town from another province? offer it */
                    var others = [];
                    if (q.length >= 2) {
                        sortedProvinces().forEach(function (province) {
                            if (province === currentProvince) {
                                return;
                            }
                            sortedTowns(province).forEach(function (town) {
                                if (norm(town).indexOf(q) !== -1) {
                                    others.push({ town: town, province: province });
                                }
                            });
                        });
                    }

                    if (others.length) {
                        var oh = document.createElement("div");
                        oh.className = "loc-group-label";
                        oh.textContent = "Other provinces";
                        frag.appendChild(oh);

                        others.slice(0, 8).forEach(function (match) {
                            var btn = makeButton(
                                match.town,
                                match.province,
                                ICON_TOWN,
                                function () {
                                    onPickTown(match.town, match.province);
                                },
                                q,
                            );
                            frag.appendChild(btn);
                            items.push(btn);
                        });
                    }

                    if (!inProvince.length && !others.length) {
                        var empty = document.createElement("div");
                        empty.className = "loc-empty";
                        empty.textContent =
                            "No towns in " +
                            currentProvince +
                            ' match "' +
                            input.value +
                            '" — press Enter to search it anyway.';
                        frag.appendChild(empty);
                    }

                    panel.appendChild(frag);
                    panel.classList.add("open");
                    updateClearBtn();
                }

                /* ---------- PICKS ---------- */
                function onPickProvince(province) {
                    mode = "town";
                    currentProvince = province;
                    input.value = province;
                    provHid.value = province;
                    locHid.value = "";
                    renderTownStage();
                    input.focus();
                }

                function onPickWholeProvince() {
                    provHid.value = currentProvince;
                    locHid.value = "";
                    input.value = currentProvince;
                    closePanel();
                    form.submit();
                }

                function onPickTown(town, province) {
                    provHid.value = province;
                    locHid.value = town;
                    input.value = town + ", " + province;
                    closePanel();
                    form.submit();
                }

                function onBackToProvinces() {
                    mode = "province";
                    currentProvince = "";
                    input.value = "";
                    provHid.value = "";
                    locHid.value = "";
                    renderProvinceStage("");
                    input.focus();
                }

                /* ---------- OPEN (click / focus / typing) ---------- */
                function startSuggestions() {
                    var v = input.value.trim();
                    var comma = v.indexOf(",");

                    /* box already holds "Town, Province"? → reopen town stage */
                    if (comma > 0) {
                        var provPart = v.slice(comma + 1).trim();
                        if (provPart && PH.hasOwnProperty(provPart)) {
                            mode = "town";
                            currentProvince = provPart;
                            renderTownStage();
                            return;
                        }
                    }

                    /* box holds exactly a province name? → its towns */
                    var province = findProvince(v);
                    if (province && norm(v) === province.toLowerCase()) {
                        mode = "town";
                        currentProvince = province;
                        renderTownStage();
                        return;
                    }

                    mode = "province";
                    currentProvince = "";
                    renderProvinceStage(input.value);
                }

                input.addEventListener("focus", startSuggestions);
                input.addEventListener("click", function () {
                    if (!isOpen()) {
                        startSuggestions();
                    }
                });

                input.addEventListener("input", function () {
                    if (mode === "town") {
                        renderTownStage();
                    } else {
                        syncHiddenFromText();
                        renderProvinceStage(input.value);
                    }
                });

                /* keyboard */
                input.addEventListener("keydown", function (e) {
                    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                        e.preventDefault();
                        if (!isOpen()) {
                            startSuggestions();
                            return;
                        }
                        if (items.length) {
                            setActive(e.key === "ArrowDown" ? active + 1 : active - 1);
                        }
                    } else if (e.key === "Enter") {
                        if (isOpen() && active >= 0 && items[active]) {
                            e.preventDefault();
                            items[active].click();
                        }
                        /* no highlight → native submit runs; the form
                                                   submit handler fills the hidden fields */
                    } else if (e.key === "Escape") {
                        closePanel();
                    } else if (e.key === "Tab") {
                        closePanel();
                    }
                });

                /* native submit — typed text lands in the hidden fields */
                form.addEventListener("submit", function () {
                    if (input.value.trim() !== "") {
                        syncHiddenFromText();
                    }
                });

                /* click outside closes */
                document.addEventListener("click", function (e) {
                    if (!e.target.closest(".location-group")) {
                        closePanel();
                    }
                });

                /* initial state — show X if the box arrived pre-filled */
                updateClearBtn();
            })();
        </script>

        <script>
            (function () {
                "use strict";

                /* =====================================================
                                           PRICE RANGE — gold fill follows the thumb,
                                           live label + auto-submit on release
                                        ====================================================== */
                var range = document.getElementById("price-range");
                var maxLabel = document.getElementById("price-max");
                var form = document.getElementById("filter-form");

                if (range && maxLabel && form) {
                    /* Paint the track: gold gradient up to the thumb,
                                               grey for the rest. Called on load and on drag. */
                    function paintTrack() {
                        var min = Number(range.min) || 0;
                        var max = Number(range.max) || 0;
                        var val = Number(range.value) || 0;
                        var pct = max > min ? ((val - min) / (max - min)) * 100 : 0;

                        range.style.background =
                            "linear-gradient(to right," +
                            " #f6c04e 0%," +
                            " #d68e0e " +
                            pct +
                            "%," +
                            " #e2e8f0 " +
                            pct +
                            "%," +
                            " #e2e8f0 100%)";
                    }

                    /* live label + repaint while dragging */
                    range.addEventListener("input", function () {
                        maxLabel.textContent = Number(range.value).toLocaleString();
                        maxLabel.classList.add("price-live");
                        paintTrack();
                    });

                    /* submit when the thumb is released */
                    range.addEventListener("change", function () {
                        maxLabel.classList.remove("price-live");
                        form.submit();
                    });

                    /* initial paint (restores the fill on reload) */
                    paintTrack();
                }

                /* =====================================================
                                           VIEW TOGGLE — grid / list
                                        ====================================================== */
                var results = document.getElementById("rh-listings-results");
                var viewBtns = document.querySelectorAll(".rh-view-btn");

                if (results && viewBtns.length) {
                    viewBtns.forEach(function (btn) {
                        btn.addEventListener("click", function () {
                            viewBtns.forEach(function (b) {
                                b.classList.remove("active");
                            });
                            btn.classList.add("active");

                            if (btn.dataset.view === "list") {
                                results.classList.add("rh-list-view");
                            } else {
                                results.classList.remove("rh-list-view");
                            }
                        });
                    });
                }
            })();
        </script>

        <!-- Wishlist hearts — toggle via POST /wishlist/toggle (guests → /login) -->
        <script>
            (function () {
                "use strict";

                /* =====================================================
                                           WISHLIST HEARTS — every card's heart button
                                           posts listing_id to /wishlist/toggle.

                                           Two response shapes are supported because
                                           different installs of WishlistController
                                           answer differently:
                                              { ok, added, count }   (added: true/false)
                                              { ok, saved }          (saved: true/false)

                                           OPTIMISTIC UI: the heart glows the instant
                                           the user clicks — we don't wait for the
                                           server. If the request fails or the server
                                           disagrees, we revert to the prior state.

                                           preventDefault + stopPropagation keep the
                                           card's <a> link from firing.
                                        ====================================================== */
                document.addEventListener("click", function (e) {
                    var btn = e.target.closest(".rh-wish-btn");
                    if (!btn) {
                        return;
                    }

                    /* the whole card is a link — do not navigate */
                    e.preventDefault();
                    e.stopPropagation();

                    var listingId = parseInt(btn.dataset.listingId, 10);
                    if (!listingId) {
                        return;
                    }
                    if (btn.dataset.busy === "1") {
                        return;
                    }
                    btn.dataset.busy = "1";

                    /* ---- OPTIMISTIC UI: toggle immediately ----
                                   remember the prior state so we can revert on
                                   failure. */
                    var wasSaved = btn.classList.contains("saved");
                    var nowSaved = !wasSaved;

                    function applyState(saved) {
                        btn.classList.toggle("saved", saved);
                        btn.setAttribute("aria-pressed", saved ? "true" : "false");
                        var label = saved ? "Remove from wishlist" : "Save to wishlist";
                        btn.setAttribute("aria-label", label);
                        btn.setAttribute("title", label);

                        /* restart the pop animation so the click feels
                                       tactile — works for both glow-on and glow-off */
                        btn.classList.remove("pop");
                        void btn.offsetWidth;
                        btn.classList.add("pop");
                    }

                    /* glow instantly, don't wait for the network */
                    applyState(nowSaved);

                    var body = new FormData();
                    body.append("listing_id", String(listingId));

                    fetch("/wishlist/toggle", {
                        method: "POST",
                        body: body,
                        credentials: "same-origin",
                        headers: { "X-Requested-With": "XMLHttpRequest" },
                    })
                        .then(function (res) {
                            if (res.status === 401) {
                                /* not logged in — revert the optimistic
                                               glow, then send to login */
                                applyState(wasSaved);
                                window.location.href = "/login";
                                throw new Error("login");
                            }
                            return res.json();
                        })
                        .then(function (data) {
                            if (!data || !data.ok) {
                                /* server refused — revert */
                                applyState(wasSaved);
                                return;
                            }

                            /* accept BOTH response shapes:
                                              data.added  → boolean (newer controller)
                                              data.saved  → boolean (legacy controller)
                                           fall back to the optimistic value if the
                                           server omitted both (shouldn't happen). */
                            var serverSaved;
                            if (data.added !== undefined) {
                                serverSaved = !!data.added;
                            } else if (data.saved !== undefined) {
                                serverSaved = !!data.saved;
                            } else {
                                serverSaved = nowSaved;
                            }

                            /* sync to the server's truth (in case of a
                                           race — e.g. the row already existed) */
                            if (serverSaved !== nowSaved) {
                                applyState(serverSaved);
                            }
                        })
                        .catch(function () {
                            /* network error / login redirect already
                                           handled — keep the optimistic state so
                                           the user sees their click took effect,
                                           the next page load will reconcile */
                        })
                        .finally(function () {
                            delete btn.dataset.busy;
                        });
                });
            })();
        </script>

        <!-- Enquiry waiting card — Cancel withdraws the viewer's
             PENDING application via POST /booking/cancel-booking,
             the SAME endpoint (app_booking_cancel) the My Bookings
             details page uses. A fresh enquiry has nothing paid, so
             that endpoint's 98% refund math simply yields 0 and the
             host still gets the standard "cancelled their booking"
             notification. After the POST we reload so the card
             renders its TRUE state: normal again if the enquiry was
             withdrawn, gone entirely if the host accepted meanwhile. -->
        <script>
            (function () {
                "use strict";

                var CANCEL_URL = "/booking/cancel-booking";

                document.addEventListener("click", function (e) {
                    var btn = e.target.closest(".rh-enq-cancel");
                    if (!btn) {
                        return;
                    }

                    /* the whole card is a link — do not navigate */
                    e.preventDefault();
                    e.stopPropagation();

                    if (btn.dataset.busy === "1") {
                        return;
                    }
                    var bookingId = parseInt(btn.dataset.bookingId, 10);
                    if (!bookingId) {
                        return;
                    }

                    if (
                        !window.confirm(
                            "Cancel this enquiry? The host will be notified that you withdrew your request.",
                        )
                    ) {
                        return;
                    }

                    btn.dataset.busy = "1";
                    btn.disabled = true;

                    var body = new FormData();
                    body.append("booking_id", String(bookingId));

                    fetch(CANCEL_URL, {
                        method: "POST",
                        body: body,
                        credentials: "same-origin",
                        headers: { "X-Requested-With": "XMLHttpRequest" },
                    })
                        .then(function (res) {
                            if (res.status === 401) {
                                window.location.href = "/login";
                                throw new Error("login");
                            }
                            /* the endpoint answers with a redirect and
                                           fetch follows it — any 2xx means the
                                           request landed; the reload below paints
                                           the card's truth. */
                            if (!res.ok) {
                                throw new Error("cancel failed");
                            }
                            window.location.reload();
                        })
                        .catch(function (err) {
                            if (err && err.message === "login") {
                                return;
                            }
                            btn.disabled = false;
                            delete btn.dataset.busy;
                            window.alert(
                                "Something went wrong while cancelling your enquiry. Please try again.",
                            );
                        });
                });
            })();
        </script>


