            function rhRefreshIcons() {
                if (window.lucide && typeof lucide.createIcons === "function") {
                    lucide.createIcons();
                }
            }
            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", rhRefreshIcons);
            } else {
                rhRefreshIcons();
            }
        </script>

        <script>
            (function () {
                "use strict";

                /* =====================================================
                                                                           CATEGORY DROPDOWN — custom panel + bar icon swap
                                                                        ====================================================== */
                var catGroup = document.getElementById("category-dd");
                var catBtn = document.getElementById("category-btn");
                var catPanel = document.getElementById("category-panel");
                var catValue = document.getElementById("category-value");
                var catIcon = document.getElementById("category-btn-icon");
                var catLabel = document.getElementById("category-btn-label");

                function closeCategory() {
                    if (!catPanel) {
                        return;
                    }
                    catPanel.classList.remove("open");
                    if (catGroup) {
                        catGroup.classList.remove("open");
                    }
                    if (catBtn) {
                        catBtn.setAttribute("aria-expanded", "false");
                    }
                }

                if (catGroup && catBtn && catPanel && catValue) {
                    catBtn.addEventListener("click", function (e) {
                        e.stopPropagation();
                        var willOpen = !catPanel.classList.contains("open");
                        catPanel.classList.toggle("open", willOpen);
                        catGroup.classList.toggle("open", willOpen);
                        catBtn.setAttribute("aria-expanded", willOpen ? "true" : "false");
                    });

                    catPanel
                        .querySelectorAll("button[data-value]")
                        .forEach(function (item) {
                            item.addEventListener("click", function () {
                                catValue.value = item.dataset.value;

                                /* swap the BAR's icon + label to the picked one.
                                                                                       The panel's .loc-dot already holds the rendered
                                                                                       <svg> (createIcons ran), so clone it directly. */
                                var dot = item.querySelector(".loc-dot");
                                if (catIcon && dot) {
                                    catIcon.innerHTML = dot.innerHTML;
                                }
                                if (catLabel && item.children[1]) {
                                    catLabel.textContent = item.children[1].textContent;
                                }

                                closeCategory();
                                document.getElementById("filter-form").submit();
                            });
                        });

                    document.addEventListener("click", function (e) {
                        if (!e.target.closest("#category-dd")) {
                            closeCategory();
                        }
                    });

                    document.addEventListener("keydown", function (e) {
                        if (e.key === "Escape") {
                            closeCategory();
                        }
                    });
                }
            })();
        </script>

