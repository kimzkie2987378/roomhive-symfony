{# =========================================================
   ROOMHIVE — MY ACCOUNT (My Account overview)
   Port of legacy userprofile.php: profile card, verification
   badges, 4 live charts, recent bookings, payment summary,
   wishlist. Charts are CSS-driven (no libraries).

   REQUIRES: public/assets/myaccount.css (copy from legacy
   webprogg/assets/myaccount.css) — all .up-* base classes
   live there. Chart-specific styles ship inline below.
========================================================= #}

<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>My Account — RoomHive</title>
        <script>
            try {
                if (localStorage.getItem("rhTheme") === "dark") {
                    document.documentElement.setAttribute("data-theme-preview", "1");
                }
            } catch (e) {}
        </script>
        <link rel="stylesheet" href="{{ asset('assets/style.css') }}">
        <link rel="stylesheet" href="{{ asset('assets/myaccount.css') }}">
        <script>
            document.documentElement.classList.add("js");
        </script>

        <style>
            /* ===== VERIFICATION BADGE STATES ===== */
            .up-badge-id-verified {
                background: #e8f8f1;
                color: #178a50;
                border: 1px solid rgba(23, 138, 80, 0.35);
            }
            .up-badge-id-pending {
                background: #fff1dc;
                color: #b07708;
                border: 1px dashed rgba(237, 164, 35, 0.5);
            }
            .up-badge-id-none {
                background: #f0f0f0;
                color: #777;
                border-color: transparent;
            }
            .up-badge-id-none:hover {
                background: #1c2a38;
                color: #fff;
            }

            .up-badge-verified {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                text-decoration: none;
                font-size: 12px;
                font-weight: 700;
                padding: 4px 12px;
                border-radius: 999px;
            }
            .up-badge-verified svg {
                width: 14px;
                height: 14px;
                flex-shrink: 0;
            }

            /* ===== NAVBAR CLEARANCE ===== */
            .up-dashboard {
                margin-top: 110px;
            }

            /* ===== PHOTO PICKER ===== */
            .up-profile-photo .up-photo-hit {
                display: block;
                width: 100%;
                height: 100%;
                cursor: pointer;
                position: relative;
            }
            .up-profile-photo .up-photo-hit > img {
                width: 96px;
                height: 96px;
                border-radius: 12px;
                object-fit: cover;
                display: block;
                border: 3px solid #fff;
                box-shadow:
                    0 0 0 3px var(--up-orange, #eda423),
                    0 10px 22px rgba(237, 164, 35, 0.3);
            }
            .up-profile-photo .up-photo-edit {
                position: absolute;
                right: -4px;
                bottom: 0;
                width: 32px;
                height: 32px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #fff;
                border: 2px solid #fff;
                border-radius: 50%;
                box-shadow: 0 4px 12px rgba(28, 42, 56, 0.28);
                z-index: 6;
                transition: transform 0.2s ease;
                color: #b07708;
            }
            .up-profile-photo .up-photo-hit:hover .up-photo-edit {
                transform: scale(1.12) rotate(8deg);
            }
            .up-profile-photo .up-photo-edit svg {
                width: 16px;
                height: 16px;
                pointer-events: none;
            }

            /* ===== LIVE CHARTS ===== */
            .up-charts {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
                gap: 16px;
            }

            .up-chart-card {
                background: #fff;
                border: 1px solid var(--up-border, rgba(28, 42, 56, 0.08));
                border-radius: var(--up-radius, 18px);
                box-shadow: var(--up-shadow, 0 6px 20px rgba(28, 42, 56, 0.06));
                padding: 18px 16px 16px;
                transition:
                    transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
                    box-shadow 0.3s ease,
                    border-color 0.3s ease;
            }
            .up-chart-card:hover {
                transform: translateY(-5px);
                border-color: rgba(237, 164, 35, 0.4);
            }

            .up-ch-label {
                display: block;
                color: var(--up-text-muted, #6b7684);
                font-size: 10.5px;
                font-weight: 700;
                letter-spacing: 0.5px;
                text-transform: uppercase;
            }
            .up-ch-highlight {
                display: block;
                margin: 4px 0 2px;
                color: var(--up-navy, #1c2a38);
                font-size: 24px;
                font-weight: 800;
                letter-spacing: -0.5px;
                line-height: 1.1;
            }
            .up-hl-gold {
                color: #b07708;
            }
            .up-hl-blue {
                color: #2f7de1;
            }
            .up-ch-sub {
                display: block;
                margin-bottom: 12px;
                color: #8b93a6;
                font-size: 10.5px;
            }

            .up-ch-bars {
                display: flex;
                align-items: flex-end;
                gap: 5px;
                height: 74px;
            }
            .up-ch-barcol {
                flex: 1;
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 4px;
                height: 100%;
            }
            .up-ch-barval {
                font-size: 9.5px;
                font-weight: 800;
                color: var(--up-navy, #1c2a38);
                white-space: nowrap;
            }
            .up-ch-bartrack {
                flex: 1;
                width: 100%;
                display: flex;
                align-items: flex-end;
                background: #f6f7f9;
                border-radius: 6px;
                overflow: hidden;
            }
            .up-ch-bar {
                width: 100%;
                height: var(--h, 4%);
                border-radius: 6px 6px 0 0;
                transition: height 0.6s cubic-bezier(0.22, 1, 0.36, 1);
            }
            .up-ch-bar.gold {
                background: linear-gradient(180deg, #f6c04e, #eda423);
            }
            .up-ch-bar.green {
                background: linear-gradient(180deg, #43bd67, #1fa971);
            }
            .up-ch-barlbl {
                font-size: 9.5px;
                color: #8b93a6;
                white-space: nowrap;
            }

            .up-ch-donut-wrap {
                display: flex;
                align-items: center;
                gap: 14px;
            }
            .up-ch-donut {
                position: relative;
                width: 84px;
                height: 84px;
                flex-shrink: 0;
            }
            .up-ch-donut svg {
                width: 100%;
                height: 100%;
                display: block;
            }
            .up-ch-donut-bg {
                fill: none;
                stroke: #f0f1f6;
                stroke-width: 9;
            }
            .up-ch-donut-fg {
                fill: none;
                stroke: #eda423;
                stroke-width: 9;
                stroke-linecap: round;
                stroke-dasharray: 125.66;
                stroke-dashoffset: 125.66;
                transform: rotate(-90deg);
                transform-origin: 50% 50%;
                transition: stroke-dashoffset 1.2s cubic-bezier(0.22, 1, 0.36, 1);
            }
            .up-ch-donut.on .up-ch-donut-fg {
                stroke-dashoffset: var(--off, 125.66);
            }
            .up-ch-donut-num {
                position: absolute;
                inset: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--up-navy, #1c2a38);
                font-size: 18px;
                font-weight: 800;
            }
            .up-ch-donut-num svg {
                width: 20px;
                height: 20px;
            }
            .up-ch-donut-side {
                display: flex;
                flex-direction: column;
                gap: 3px;
                font-size: 10.5px;
                color: #8b93a6;
            }
            .up-ch-donut-side strong {
                color: var(--up-navy, #1c2a38);
                font-size: 12px;
            }

            .up-ch-wallet-link {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                margin-top: 10px;
                color: #b07708;
                font-size: 11px;
                font-weight: 800;
                letter-spacing: 0.5px;
                text-transform: uppercase;
                text-decoration: none;
            }
            .up-ch-wallet-link:hover {
                color: #1c2a38;
            }
            .up-ch-wallet-link svg {
                width: 12px;
                height: 12px;
            }

            .up-ch-stack {
                display: flex;
                height: 14px;
                background: #f0f1f6;
                border-radius: 999px;
                overflow: hidden;
            }
            .up-ch-stack span {
                width: 0%;
                transition: width 0.7s cubic-bezier(0.22, 1, 0.36, 1);
            }
            .up-ch-stack.on span {
                width: var(--w, 0%);
            }
            .up-ch-legend {
                display: flex;
                flex-wrap: wrap;
                gap: 5px 12px;
                margin-top: 10px;
            }
            .up-ch-legend span {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                font-size: 10px;
                color: #5d6875;
            }
            .up-ch-legend i {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                flex-shrink: 0;
            }
            .up-ch-empty {
                padding: 16px 4px;
                text-align: center;
                color: #8b93a6;
                font-size: 11px;
                font-style: italic;
            }

            svg.lucide {
                display: inline-block;
                vertical-align: -0.18em;
                flex-shrink: 0;
            }

            /* dark mode */
            body[data-theme="dark"] .up-chart-card,
            html[data-theme-preview="1"] .up-chart-card {
                background: #1a222b;
            }
            body[data-theme="dark"] .up-ch-bartrack,
            html[data-theme-preview="1"] .up-ch-bartrack,
            body[data-theme="dark"] .up-ch-stack,
            html[data-theme-preview="1"] .up-ch-stack {
                background: #0d1218;
            }
            body[data-theme="dark"] .up-ch-donut-bg,
            html[data-theme-preview="1"] .up-ch-donut-bg {
                stroke: #0d1218;
            }

            @media (prefers-reduced-motion: reduce) {
                .up-ch-bar,
                .up-ch-stack span,
                .up-ch-donut-fg {
                    transition: none !important;
                }
                .up-ch-bar {
                    height: var(--h, 4%) !important;
                }
                .up-ch-stack span {
                    width: var(--w, 0%) !important;
                }
                .up-ch-donut-fg {
                    stroke-dashoffset: var(--off, 125.66) !important;
                }
            }
        </style>
    </head>

    <body class="up-no-hero">

        {% include 'partials/navbar.html.twig' with {
        is_logged_in:       is_logged_in,
        nav_avatar:         nav_avatar,
        notification_count: notification_count,
        current_page:       current_page,
    } %}

        <main class="up-dashboard">

            {% include 'partials/sidebar.html.twig' with { active_sidebar: active_sidebar } %}

            <div class="up-content">

                <!-- ============ PROFILE CARD ============ -->
                <section class="up-card up-profile-card up-reveal">
                    <div class="up-profile-photo">
                        <span class="up-photo-hit" title="Profile photo">
                            <img src="{{ asset(user.avatar) }}" alt="{{ user.name }}" id="profileAvatarImg">
                            <span class="up-photo-edit">
                                <i data-lucide="camera" aria-hidden="true"></i>
                            </span>
                        </span>
                        {# Avatar upload endpoint not yet ported — wire
                       avatarFileInput to it when it is. #}
                    </div>

                    <div class="up-profile-info">
                        <div class="up-profile-name-row">
                            <h2>{{ user.name }}</h2>

                            {% if is_verified %}
                                <span class="up-badge-verified up-badge-id-verified" title="Identity verified by RoomHive">
                                    <i data-lucide="badge-check"></i> Verified
                                </span>
                            {% elseif has_pending_id %}
                                <a
                                    href="{{ path('app_settings') }}"
                                    class="up-badge-verified up-badge-id-pending"
                                    title="Complete your profile to get verified"
                                >
                                    <i data-lucide="clock"></i> Verification Pending
                                </a>
                            {% else %}
                                <a
                                    href="{{ path('app_settings') }}"
                                    class="up-badge-verified up-badge-id-none"
                                    title="Get verified to unlock listing"
                                >
                                    <i data-lucide="shield-check"></i> Get Verified
                                </a>
                            {% endif %}
                        </div>

                        <ul class="up-profile-meta">
                            {% if user.location %}
                                <li><i data-lucide="map-pin" aria-hidden="true"></i>{{ user.location }}</li>
                            {% endif %}
                            <li><i data-lucide="mail" aria-hidden="true"></i>{{ user.email }}</li>
                            {% if user.phone %}
                                <li><i data-lucide="phone" aria-hidden="true"></i>{{ user.phone }}</li>
                            {% endif %}
                            {% if user.age %}
                                <li><i data-lucide="calendar" aria-hidden="true"></i>{{ user.age }} years old</li>
                            {% endif %}
                            <li><i data-lucide="calendar-days" aria-hidden="true"></i>Member since {{ user.member_since }}</li>
                        </ul>
                    </div>

                    <div class="up-profile-about">
                        <h3>About Me</h3>
                        <p>No bio added yet.</p>
                    </div>

                    <a href="{{ path('app_settings') }}" class="up-btn-outline up-edit-profile">Edit Profile</a>
                </section>

                <!-- ============ 4 LIVE CHARTS ============ -->
                <section class="up-charts">

                    {# 1) BOOKINGS #}
                    <div class="up-chart-card up-reveal" style="--i: 0;">
                        <span class="up-ch-label">Bookings</span>
                        <strong class="up-ch-highlight up-hl-blue">{{ total_bookings_all|number_format }}</strong>
                        <span class="up-ch-sub">all-time total</span>

                        <div class="up-ch-bars" data-chart>
                            {% for m in chart_months %}
                                {% set h = max(5, (m.bookings / bk_max * 100)|round) %}
                                <div class="up-ch-barcol" title="{{ m.label }}: {{ m.bookings }}">
                                    <span class="up-ch-barval">{{ m.bookings }}</span>
                                    <div class="up-ch-bartrack">
                                        <div class="up-ch-bar gold" style="--h: {{ h }}%;"></div>
                                    </div>
                                    <span class="up-ch-barlbl">{{ m.label }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    {# 2) SPENDING #}
                    <div class="up-chart-card up-reveal" style="--i: 1;">
                        <span class="up-ch-label">Total Spent</span>
                        <strong class="up-ch-highlight up-hl-gold">&#8369;{{ spent_all_time }}</strong>
                        <span class="up-ch-sub">all-time (bookings)</span>

                        <div class="up-ch-bars" data-chart>
                            {% for m in chart_months %}
                                {% set h = max(4, (m.spend / sp_max * 100)|round) %}
                                <div class="up-ch-barcol" title="{{ m.label }}: ₱{{ m.spend|number_format(2) }}">
                                    <span class="up-ch-barval">&#8369;{{ m.spend >= 1000 ? (m.spend / 1000)|number_format(1) ~ 'K' : m.spend|number_format(0) }}</span>
                                    <div class="up-ch-bartrack">
                                        <div class="up-ch-bar green" style="--h: {{ h }}%;"></div>
                                    </div>
                                    <span class="up-ch-barlbl">{{ m.label }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    {# 3) WALLET DONUT #}
                    <div class="up-chart-card up-reveal" style="--i: 2;">
                        <span class="up-ch-label">Wallet Balance</span>
                        <strong class="up-ch-highlight up-hl-gold">&#8369;{{ wallet_balance|number_format(2) }}</strong>
                        <span class="up-ch-sub">available to spend</span>

                        {% if wallet_money_in > 0 %}
                            <div class="up-ch-donut-wrap">
                                <div class="up-ch-donut" data-donut style="--off: {{ wallet_donut_offset }};">
                                    <svg viewBox="0 0 48 48" aria-hidden="true">
                                        <circle class="up-ch-donut-bg" cx="24" cy="24" r="20"></circle>
                                        <circle class="up-ch-donut-fg" cx="24" cy="24" r="20"></circle>
                                    </svg>
                                    <span class="up-ch-donut-num"><i data-lucide="wallet" aria-hidden="true"></i></span>
                                </div>
                                <div class="up-ch-donut-side">
                                    <strong>&#8369;{{ wallet_money_in|number_format(2) }} loaded all-time</strong>
                                    <span>top-ups, refunds &amp; rewards</span>
                                    <span>({{ wallet_pct }}% still available)</span>
                                </div>
                            </div>
                        {% else %}
                            <div class="up-ch-empty">Your wallet is empty — top up to start booking.</div>
                        {% endif %}

                        <a href="/wallet" class="up-ch-wallet-link">
                            OPEN WALLET <i data-lucide="arrow-right" aria-hidden="true"></i>
                        </a>
                    </div>

                    {# 4) WISHLIST STACKED BAR #}
                    <div class="up-chart-card up-reveal" style="--i: 3;">
                        <span class="up-ch-label">Wishlist</span>
                        <strong class="up-ch-highlight up-hl-blue">{{ wishlist_total|number_format }}</strong>
                        <span class="up-ch-sub">saved propert{{ wishlist_total == 1 ? 'y' : 'ies' }}</span>

                        {% if wishlist_total > 0 and wl_cats|length > 0 %}
                            {% set wl_colors = ['#eda423', '#2F7DE1', '#1fa971', '#7a4bb0'] %}
                            <div class="up-ch-stack" data-chart>
                                {% for cat in wl_cats %}
                                    {% if cat.c > 0 %}
                                        <span
                                            style="--w: {{ (cat.c / max(1, wl_cat_total) * 100)|round(1) }}%; background: {{ wl_colors[loop.index0 % 4] }};"
                                            title="{{ cat.category|title }}: {{ cat.c }}"
                                        ></span>
                                    {% endif %}
                                {% endfor %}
                            </div>

                            <div class="up-ch-legend">
                                {% for cat in wl_cats %}
                                    <span>
                                        <i style="background: {{ wl_colors[loop.index0 % 4] }};"></i>
                                        {{ cat.category|title }}: {{ cat.c }}
                                    </span>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="up-ch-empty">Nothing saved yet — tap the heart on any listing.</div>
                        {% endif %}
                    </div>

                </section>

                <!-- ============ BOOKINGS + RIGHT COLUMN ============ -->
                <section class="up-two-col">

                    <div class="up-card up-bookings-card up-reveal" style="--i: 1;">
                        <div class="up-card-header">
                            <h3>Recent Bookings</h3>
                            <a href="/bookings" class="up-link-view-all">View All</a>
                        </div>

                        {% if bookings|length == 0 %}
                            <div class="up-bookings-empty">
                                <p class="up-bookings-empty-title">No bookings yet</p>
                                <p class="up-bookings-empty-text">Once you book a stay, it will show up here.</p>
                                <a href="{{ path('app_listings') }}" class="up-btn-outline">BROWSE LISTINGS</a>
                            </div>
                        {% else %}
                            {% for booking in bookings %}
                                <a href="{{ path('app_payment_confirmation', { booking: booking.id }) }}" class="up-booking-row">
                                    <img src="{{ asset(booking.thumb) }}" alt="{{ booking.title }}" class="up-booking-thumb">
                                    <div class="up-booking-info">
                                        <h4>{{ booking.title }}</h4>
                                        <p class="up-booking-location">{{ booking.location }}</p>
                                        <p class="up-booking-dates"><i data-lucide="calendar" aria-hidden="true"></i>{{ booking.dates }}</p>
                                    </div>
                                    <div class="up-booking-side">
                                        <span class="up-status up-status-{{ booking.status }}">{{ booking.status|title }}</span>

                                        {% if booking.pay_state == 'full' %}
                                            <strong>&#8369; {{ booking.total }}</strong>
                                            <span>Fully Paid</span>
                                        {% elseif booking.pay_state == 'advance' %}
                                            <strong>&#8369; {{ booking.paid }}</strong>
                                            <span>Reserve Paid</span>
                                        {% else %}
                                            <strong>&#8369; {{ booking.total }}</strong>
                                            <span>Booking Total</span>
                                        {% endif %}
                                    </div>
                                    <span class="up-booking-chevron">&#8250;</span>
                                </a>
                            {% endfor %}

                            <a href="/bookings" class="up-btn-outline up-view-all-bookings">VIEW ALL BOOKINGS</a>
                        {% endif %}
                    </div>

                    <div class="up-right-col">

                        {# ---- VERIFICATION CARD ---- #}
                        <div class="up-card up-account-security up-reveal" style="--i: 0;">
                            <div class="up-card-header">
                                <h3>Identity Verification</h3>
                                {% if is_verified %}
                                    <span class="up-badge-verified up-badge-id-verified"><i data-lucide="badge-check"></i> Verified</span>
                                {% elseif has_pending_id %}
                                    <span class="up-badge-verified up-badge-id-pending"><i data-lucide="clock"></i> Pending</span>
                                {% endif %}
                            </div>

                            {% if is_verified %}
                                <p style="font-size:13px; color:#178A50; font-weight:700; margin:0 0 12px;">
                                    &#10003; Your identity is verified — you can list spaces and
                                    enjoy faster booking approvals.
                                </p>
                            {% elseif has_pending_id %}
                                <p style="font-size:13px; color:#B07708; font-weight:600; margin:0 0 12px;">
                                    &#8987; Your ID is received — complete your profile
                                    (name, phone, age, location) in Edit Profile to be
                                    verified automatically.
                                </p>
                            {% else %}
                                <p style="font-size:13px; color:#777; margin:0 0 12px;">
                                    Verification is required before you can list a space.
                                    Upload one government-issued ID — it's free and automatic.
                                </p>
                            {% endif %}

                            <a href="{{ path('app_settings') }}" class="up-btn-solid" style="display:inline-block;">
                                {{ is_verified ? 'VIEW VERIFICATION' : 'VERIFY NOW' }}
                            </a>
                        </div>

                        {# ---- PAYMENT SUMMARY (week/pending tabs) ---- #}
                        <div class="up-card up-payment-summary up-reveal" style="--i: 2;">
                            <div class="up-card-header">
                                <h3>Payment Summary</h3>
                            </div>

                            <div class="up-summary-toggle" role="tablist">
                                <button type="button" class="up-summary-tab active" data-range="week">This Week</button>
                                <button type="button" class="up-summary-tab" data-range="pending">Pending to Pay</button>
                            </div>

                            <div class="up-payment-summary-body">
                                <div>
                                    <span class="up-muted up-summary-label">Total Spent</span>
                                    <strong>&#8369;
                                        <span
                                            class="up-summary-amount"
                                            data-week="{{ spent_this_week }}"
                                            data-pending="{{ pending_to_pay }}"
                                        >{{ spent_this_week }}</span>
                                    </strong>
                                    <span class="up-muted up-summary-range-label">Last 7 Days</span>
                                </div>
                                <i data-lucide="banknote" aria-hidden="true" style="width:38px;height:38px;color:#eda423;"></i>
                            </div>
                        </div>

                        {# ---- PAYMENT METHODS ---- #}
                        <div class="up-card up-payment-methods up-reveal" style="--i: 3;">
                            <div class="up-card-header">
                                <h3>Payment Methods</h3>
                            </div>
                            <div class="up-payment-methods-empty">
                                <p>No payment methods yet</p>
                                <p>Add a card to make booking faster.</p>
                            </div>
                        </div>

                        {# ---- NEED HELP ---- #}
                        <div class="up-need-help up-reveal" style="--i: 5;">
                            <div class="up-need-help-text">
                                <h3>Need Help?</h3>
                                <p>Our support team is here to assist you 24/7.</p>
                                <a href="{{ path('app_contacts') }}" class="up-btn-solid">CONTACT SUPPORT</a>
                            </div>
                        </div>

                    </div>
                </section>

                <!-- ============ WISHLIST ============ -->
                <section class="up-card up-wishlist up-reveal" style="--i: 1;">
                    <div class="up-card-header">
                        <h3>Wishlist (<span class="up-wishlist-count">{{ wishlist_total }}</span>)</h3>
                        <a href="/wishlist" class="up-link-view-all">View All</a>
                    </div>

                    <div class="up-wishlist-grid" id="up-wishlist-grid" {{ wishlist|length == 0 ? 'style="display:none;"' : '' }}>
                        {% for item in wishlist %}
                            <a href="{{ path('app_listing_detail', { id: item.id }) }}" class="listing-box" data-listing-id="{{ item.id }}">
                                <div class="up-wishlist-thumb">
                                    <img src="{{ asset(item.thumb) }}" alt="{{ item.title }}">
                                </div>
                                <h4>{{ item.title }}</h4>
                                <p class="up-wishlist-location">{{ item.location }}</p>
                                <div class="up-wishlist-meta">
                                    <span class="up-wishlist-price">&#8369; {{ item.price }} / month</span>
                                </div>
                            </a>
                        {% endfor %}
                    </div>

                    <div class="up-wishlist-empty" id="up-wishlist-empty" style="{{ wishlist|length == 0 ? '' : 'display:none;' }}">
                        <p style="margin:0 0 4px; font-weight:700; color:var(--up-navy, #1c2a38);">Your wishlist is empty</p>
                        <p style="margin:0; font-size:13px;">Save listings you like and they'll show up here.</p>
                    </div>
                </section>

            </div>
        </main>

        {% include 'partials/footer.html.twig' ignore missing %}

        <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>

        <script>
            (function () {
                "use strict";

                function icons() {
                    if (window.lucide && typeof lucide.createIcons === "function") {
                        lucide.createIcons();
                    }
                }
                icons();

                /* ---- Scroll reveal + chart activation ---- */
                var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                var reveals = document.querySelectorAll(".up-reveal");
                var charts = document.querySelectorAll("[data-chart], [data-donut]");

                function activateAll() {
                    reveals.forEach(function (el) {
                        el.classList.add("in-view");
                    });
                    charts.forEach(function (el) {
                        el.classList.add("on");
                    });
                }

                if (reduced || !("IntersectionObserver" in window)) {
                    activateAll();
                } else {
                    var io = new IntersectionObserver(
                        function (entries) {
                            entries.forEach(function (entry) {
                                if (!entry.isIntersecting) return;
                                var el = entry.target;
                                io.unobserve(el);
                                el.classList.add(
                                    el.hasAttribute("data-chart") ||
                                        el.hasAttribute("data-donut")
                                        ? "on"
                                        : "in-view",
                                );
                            });
                        },
                        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
                    );

                    reveals.forEach(function (el) {
                        io.observe(el);
                    });
                    charts.forEach(function (el) {
                        io.observe(el);
                    });
                }

                /* ---- Payment summary tabs (week / pending) ---- */
                var tabs = document.querySelectorAll(".up-summary-tab");
                var amountEl = document.querySelector(".up-summary-amount");
                var rangeEl = document.querySelector(".up-summary-range-label");

                tabs.forEach(function (tab) {
                    tab.addEventListener("click", function () {
                        tabs.forEach(function (t) {
                            t.classList.remove("active");
                        });
                        tab.classList.add("active");

                        if (!amountEl) return;
                        if (tab.dataset.range === "pending") {
                            amountEl.textContent = amountEl.dataset.pending;
                            if (rangeEl) rangeEl.textContent = "Pending to Pay";
                        } else {
                            amountEl.textContent = amountEl.dataset.week;
                            if (rangeEl) rangeEl.textContent = "Last 7 Days";
                        }
                    });
                });
            })();
        </script>

    </body>

</html>
