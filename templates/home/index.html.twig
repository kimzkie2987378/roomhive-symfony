{# =========================================================
   ROOMHIVE — GUEST LANDING (public homepage)
   templates/home/index.html.twig

   Rendered by HomeController for logged-OUT visitors.
   Logged-in users get templates/user/home.html.twig instead.

   === HARDENED NAVBAR INCLUDE ===
   The navbar include wraps every passed variable in
   |default() — a `with {}` include evaluates those in THIS
   template's scope first, so a missing variable throws
   "Variable ... does not exist" before the navbar's own
   session fallbacks can run. With the defaults, this page
   renders whether or not the controller passes variables.
   (The navbar still falls back to the session internally,
   so guests correctly see LIST YOUR SPACE.)

   === BFCACHE KILLER ADDED (logout fix, part 2) ===
   This template is standalone — it does NOT extend
   base.html.twig, so it carries its own copy of the
   pageshow guard. Without it, a back/forward cached
   guest page could be stale after login/logout.

   Sections mirror the logged-in user home (legacy index.php
   structure): hero, top listings, about, reasons,
   testimonials, final CTA, dual CTA, React islands.
========================================================= #}

<!doctype html>
<html lang="en">

    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>RoomHive | Find. Stay. Feel at Home.</title>

        <link
            href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
            rel="stylesheet"
        />
        <link rel="stylesheet" href="{{ asset('assets/style.css') }}"/>
        <link rel="stylesheet" href="{{ asset('assets/motion.css') }}"/>

        {# Tailwind (no preflight) — styles the React islands only.
           Requires public/assets/react/chunks/tw.css. #}
        <link rel="stylesheet" href="{{ asset('assets/react/chunks/tw.css') }}"/>

        <script>
            document.documentElement.classList.add("js-animations");
        </script>

        <style>
            /* =====================================================
                                                               SPONSORED AD WIDGET STYLES — rendered by the React
                                                               ad-carousel island using THESE classes. Cycle:
                                                               animate in -> hold 10s -> animate out -> next pair.
                                                            ====================================================== */
            .rh-ad-wrap {
                position: fixed;
                right: 18px;
                bottom: 18px;
                z-index: 900;

                display: flex;
                flex-direction: column;
                gap: 10px;

                width: 292px;

                pointer-events: none;
            }

            .rh-ad-header {
                display: flex;
                align-items: center;
                justify-content: space-between;

                pointer-events: auto;

                background: #1c2a38;
                border-radius: 10px;
                padding: 5px 10px;

                opacity: 0;
                transform: translateY(12px);
                transition:
                    opacity 0.45s ease,
                    transform 0.45s ease;
            }

            .rh-ad-wrap.show .rh-ad-header {
                opacity: 1;
                transform: none;
            }

            .rh-ad-header span {
                color: #f6c04e;
                font-size: 9.5px;
                font-weight: 800;
                letter-spacing: 0.18em;
                text-transform: uppercase;
            }

            .rh-ad-close {
                background: none;
                border: none;
                color: #aab6c2;
                font-size: 15px;
                line-height: 1;
                cursor: pointer;
                padding: 2px 4px;

                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

            .rh-ad-close:hover {
                color: #fff;
            }

            .rh-ad-close svg {
                width: 14px;
                height: 14px;
            }

            .rh-ad-card {
                pointer-events: auto;

                display: flex;
                gap: 10px;
                align-items: center;

                background: #fff;
                border: 1px solid rgba(28, 42, 56, 0.08);
                border-radius: 14px;
                padding: 8px;

                box-shadow: 0 14px 34px rgba(28, 42, 56, 0.2);

                text-decoration: none;

                opacity: 0;
                transform: translateY(18px) scale(0.97);

                transition:
                    opacity 0.5s ease,
                    transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
            }

            .rh-ad-card.show {
                opacity: 1;
                transform: translateY(0) scale(1);
            }

            .rh-ad-card.hide {
                opacity: 0;
                transform: translateY(10px) scale(0.98);
            }

            .rh-ad-card:nth-child(3) {
                transition-delay: 0.12s;
            }

            .rh-ad-thumb {
                width: 74px;
                height: 74px;
                border-radius: 10px;
                object-fit: cover;
                flex-shrink: 0;
                background: #f0eee6;
            }

            .rh-ad-body {
                min-width: 0;
                flex: 1;
            }

            .rh-ad-title {
                margin: 0;
                font-size: 12.5px;
                font-weight: 700;
                color: #1c2a38;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .rh-ad-loc {
                margin: 2px 0 0;
                font-size: 11px;
                color: #6b7684;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .rh-ad-price {
                margin: 4px 0 0;
                font-size: 12.5px;
                font-weight: 800;
                color: #b07708;
            }

            .rh-ad-cta {
                display: inline-block;
                margin-top: 3px;
                font-size: 10px;
                font-weight: 800;
                letter-spacing: 0.08em;
                color: #dd930f;
            }

            .rh-ad-cta svg {
                width: 11px;
                height: 11px;
                vertical-align: -1.5px;
            }

            .rh-ad-card:hover {
                border-color: rgba(237, 164, 35, 0.55);
            }

            @media (max-width: 640px) {
                .rh-ad-wrap {
                    width: 236px;
                    right: 12px;
                    bottom: 12px;
                }

                .rh-ad-thumb {
                    width: 60px;
                    height: 60px;
                }
            }

            @media (prefers-reduced-motion: reduce) {
                .rh-ad-card,
                .rh-ad-header {
                    transition: none !important;
                }
            }

            /* =====================================================
                                                               LUCIDE ICONS — page-level sizing
                                                            ====================================================== */
            svg.lucide {
                display: inline-block;
                vertical-align: -0.18em;
                flex-shrink: 0;
            }

            .btn-primary svg,
            .btn-secondary svg,
            .about-button svg,
            .cta-button svg {
                width: 15px;
                height: 15px;
            }

            .reason-icon {
                width: 30px;
                height: 30px;
                color: #eda423;
                stroke-width: 1.8;
            }

            .nav-arrow {
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

            .nav-arrow svg {
                width: 20px;
                height: 20px;
                color: #1c2a38;
            }

            .testimonial-author {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .testimonial-avatar {
                width: 36px;
                height: 36px;
                color: #eda423;
                stroke-width: 1.6;
            }

            .dual-cta-icon {
                width: 46px;
                height: 46px;
                stroke-width: 1.6;
            }

            /* gold door on the navy panel */
            .list-panel .dual-cta-icon {
                color: #f6c04e;
            }

            /* navy house on the amber panel */
            .host-panel .dual-cta-icon {
                color: #1c2a38;
            }
        </style>
    </head>

    <body>

        {# =====================================================
           REACT ISLAND MOUNT — scroll-progress
        ====================================================== #}
        <div id="react-scrollprogress"></div>

        {# ================= NAVBAR — HARDENED INCLUDE =================
           Every variable is |default()-guarded so this template
           can never crash on a missing variable, no matter what
           the controller passes. Guests see LIST YOUR SPACE
           (is_logged_in defaults false; the navbar's session
           fallback covers any template that passes nothing). #}
        {% include 'partials/navbar.html.twig' with {
            is_logged_in:       is_logged_in|default(false),
            current_page:       current_page|default('/'),
            nav_avatar:         nav_avatar|default(''),
            notification_count: notification_count|default(0),
        } %}

        {# ================= HERO (guest) ================= #}
        <section class="hero">
            <img class="hero-image" src="{{ asset('images/Living_Room.png') }}" alt="Living Room"/>
            <div class="hero-overlay"></div>
            <div class="hero-content">
                <p class="user-welcome">
                    Welcome to RoomHive!
                </p>
                <h1>
                    Find A Room<br/>
                    That Feels<br/>
                    Like Home
                </h1>
                <p>
                    Verified monthly rentals across Dumaguete and<br/>
                    Negros Oriental — hand-checked listings and<br/>
                    honest prices, ready for your move-in.
                </p>
                <div class="hero-buttons">
                    <a href="{{ path('app_host_apply') }}" class="btn-primary">
                        <i data-lucide="key-round" aria-hidden="true"></i> LIST YOUR SPACE
                    </a>
                    <a href="{{ path('app_listings') }}" class="btn-secondary">
                        <i data-lucide="search" aria-hidden="true"></i> BROWSE LISTINGS
                    </a>
                </div>
            </div>
        </section>

        {# ================= TOP LISTINGS =================
           Cards link with ?category= — the parameter
           app_listings actually reads. #}
        <section class="listings">
            <span class="listings-eyebrow">EXPLORE ROOMHIVE</span>
            <h2 class="listings-title">Browse Our Top Listings!</h2>
            <div class="listings-grid">
                {% set category_tiles = [
                    { name: 'STUDIO LOFT',    image: 'images/StudioLoft.png',    type: 'studio-loft' },
                    { name: 'SHARED ROOM',    image: 'images/SharedBedroom.png', type: 'shared-bedroom' },
                    { name: 'ENTIRE HOUSE',   image: 'images/EntireHouse.png',   type: 'entire-house' },
                    { name: 'PRIVATE ROOM',   image: 'images/PrivateRoom.png',   type: 'private-room' },
                    { name: 'BOARDING HOUSE', image: 'images/BoardingHouse.png', type: 'boarding-house' },
                    { name: 'APARTMENT',      image: 'images/Apartment.png',     type: 'apartment' },
                ] %}
                {% for listing in category_tiles %}
                    <a href="{{ path('app_listings', { category: listing.type }) }}" class="listing-card">
                        <img src="{{ asset(listing.image) }}" alt="{{ listing.name }}"/>
                        <div class="listing-info">
                            <span class="listing-name">{{ listing.name }}</span>
                            <span class="listing-link">VIEW LISTING</span>
                        </div>
                    </a>
                {% endfor %}
            </div>
        </section>

        {# ================= ABOUT US ================= #}
        <section class="about">
            <div class="about-text">
                <span class="about-eyebrow">WHO WE ARE</span>
                <h2>About RoomHive</h2>
                <p>
                    RoomHive is a homegrown rental platform for Negros
                    Oriental. We connect students, professionals, and
                    families with rooms, apartments, and houses for
                    rent — and every single listing is reviewed by our
                    team before it goes live.
                </p>
                <p>
                    From a shared room near campus to an entire house
                    for the whole family, RoomHive lets you browse real
                    photos, compare honest monthly rates, and reserve
                    your space securely online. No agents, no guesswork
                    — just a place you'll be happy to call home.
                </p>
                <a href="{{ path('app_about') }}" class="about-button">
                    ABOUT US <i data-lucide="arrow-right" aria-hidden="true"></i>
                </a>
            </div>
            <div class="about-image">
                <img src="{{ asset('images/3rdPageImage.png') }}" alt="RoomHive team handing over keys"/>
            </div>
        </section>

        {# ================= REASON WHY ================= #}
        <section class="reasons">
            <div class="reasons-header">
                <div class="reasons-heading">
                    <span class="reasons-eyebrow">WHY CHOOSE US</span>
                    <h2>Reason Why RoomHive Is The Best</h2>
                </div>
                <p class="reasons-desc">
                    Hand-reviewed listings, verified hosts, and secure
                    reservations — everything on RoomHive is built to
                    make renting simple, safe, and honest.
                </p>
            </div>
            <div class="reasons-grid">
                {% set reason_cards = [
                    { icon: 'headset',      title: '24/7 Support',      text: 'Our team is on call around the clock for hosts and tenants.' },
                    { icon: 'badge-check',  title: 'Verified Listings', text: 'Every listing is hand-reviewed and checked by our team before it goes live.' },
                    { icon: 'shield-check', title: 'Secure Payments',   text: 'Your booking and deposits are protected end-to-end.' },
                    { icon: 'receipt-text', title: 'No Hidden Fees',    text: 'What you see is what you pay — no surprise charges, ever.' },
                ] %}
                {% for reason in reason_cards %}
                    <div class="reason-card">
                        <i
                            data-lucide="{{ reason.icon }}"
                            class="reason-icon"
                            role="img"
                            aria-label="{{ reason.title }}"
                        ></i>
                        <div class="reason-text">
                            <h4>{{ reason.title }}</h4>
                            <p>{{ reason.text }}</p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>

        {# ================= TESTIMONIALS ================= #}
        <section class="testimonials">
            <div class="testimonials-text">
                <span class="testimonials-eyebrow">TESTIMONIALS</span>
                <h2>Our Happy Tenants</h2>
                <p>
                    Hear from tenants who found their home
                    through RoomHive.
                </p>
                <div class="testimonials-nav">
                    <button class="nav-arrow" aria-label="Previous testimonial">
                        <i data-lucide="chevron-left" aria-hidden="true"></i>
                    </button>
                    <div class="testimonials-dots">
                        {% set testimonial_cards = [
                            { quote: 'Booking my apartment through RoomHive was seamless.', body: 'The team was responsive from day one and the listing matched exactly what was shown. Moving in was stress-free.', author: 'Isabelle Cruz' },
                            { quote: 'RoomHive made finding a place stress-free.',          body: 'Verified listings and quick support meant I never had to worry about hidden costs or surprises on move-in day.', author: 'Miguel Santos' },
                            { quote: 'The verified listings gave me peace of mind.',        body: 'I was nervous about renting sight-unseen, but every photo and detail on RoomHive matched reality. Highly recommend.', author: 'Andrea Lopez' },
                            { quote: 'Customer support answered me at midnight.',           body: 'I had a payment issue right before move-in and the RoomHive team sorted it out within minutes, even that late.', author: 'Kevin Tan' },
                            { quote: 'No hidden fees, exactly as advertised.',              body: 'What I saw on the listing page was what I paid — no surprise charges at checkout or on my first invoice.', author: 'Grace Villanueva' },
                            { quote: 'Found my apartment in under a week.',                 body: 'The filters made it easy to narrow down listings by price and amenities, so I didn\'t waste time scrolling.', author: 'Paolo Reyes' },
                        ] %}
                        {% for testimonial in testimonial_cards %}
                            <span class="dot{{ loop.first ? ' active' : '' }}"></span>
                        {% endfor %}
                    </div>
                    <button class="nav-arrow" aria-label="Next testimonial">
                        <i data-lucide="chevron-right" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            <div class="testimonials-slider">
                <div class="testimonials-track">

                    {% for testimonial in testimonial_cards %}
                        <div class="testimonial-card">
                            <p class="testimonial-quote">
                                "{{ testimonial.quote }}"
                            </p>
                            <p class="testimonial-body">
                                {{ testimonial.body }}
                            </p>
                            <div class="testimonial-author">
                                <i data-lucide="circle-user-round" class="testimonial-avatar" aria-hidden="true"></i>
                                <span>{{ testimonial.author }}</span>
                            </div>
                        </div>
                    {% endfor %}

                </div>
            </div>
        </section>

        {# ================= FINAL CTA ================= #}
        <section class="final-cta">
            <div class="cta-image-strip">
                {% set cta_strip = [
                    'images/FirstImageLeft.jpg',
                    'images/SecondImageLeft.jpg',
                    'images/MiddleImage.avif',
                    'images/FirstImageRight.jpg',
                    'images/SecondImageRight.jpg',
                ] %}
                {% for image in cta_strip %}
                    <img src="{{ asset(image) }}" alt="RoomHive interior"/>
                {% endfor %}
            </div>
            <div class="cta-box">
                <span class="cta-eyebrow">READY TO MOVE?</span>
                <h2 class="cta-title">Find A Place You'll Love To Call Home</h2>
                <a href="{{ path('app_listings') }}" class="cta-button">
                    VIEW LISTINGS <i data-lucide="search" aria-hidden="true"></i>
                </a>
            </div>
        </section>

        {# ================= DUAL CTA ================= #}
        <section class="dual-cta">
            <div class="dual-cta-panel list-panel">
                <i
                    data-lucide="door-open"
                    class="dual-cta-icon"
                    role="img"
                    aria-label="List Your Space"
                ></i>
                <h3>List Now</h3>
                <p>
                    Got a room, apartment or house sitting empty?
                    Put it up in minutes and start receiving booking
                    enquiries from verified renters today.
                </p>
                <a
                    href="{{ path('app_host_apply') }}"
                    class="dual-cta-button list-button"
                >
                    LIST NOW
                </a>
            </div>
            <div class="dual-cta-panel host-panel">
                <i
                    data-lucide="house"
                    class="dual-cta-icon"
                    role="img"
                    aria-label="Become a Host"
                ></i>
                <h3>Become A Host</h3>
                <p>
                    Turn your empty room, unit, or floor into monthly
                    income. Apply in minutes, list your space, and let
                    verified renters come to you.
                </p>
                <a
                    href="{{ path('app_host_apply') }}"
                    class="dual-cta-button host-button"
                >
                    LIST YOUR SPACE
                </a>
            </div>
        </section>

        {# =====================================================
           SPONSORED AD WIDGET — REACT ISLAND (ad-carousel.js)
           Renders only when the controller passes ad_listings.
           Guests can see sponsored listings too — if you want
           ads here, have the guest branch of HomeController run
           the same ad query and pass ad_listings.
        ====================================================== #}
        {% if ad_listings is defined and ad_listings|length > 0 %}
            <div id="react-ads"></div>
            <script type="application/json" id="react-ads-props">
                {{ { pool: ad_listings }|json_encode(
                    constant('JSON_UNESCAPED_UNICODE')
                    b-or constant('JSON_HEX_TAG')
                    b-or constant('JSON_HEX_AMP')
                    b-or constant('JSON_HEX_APOS')
                    b-or constant('JSON_HEX_QUOT')
                )|raw }}
            </script>
            <script type="module" src="{{ asset('assets/react/ad-carousel.js') }}"></script>
        {% endif %}

        {# ================= FOOTER ================= #}
        {% include 'partials/footer.html.twig' ignore missing %}

        {# ================= LUCIDE LOADER ================= #}
        <script src="https://unpkg.com/lucide@0.469.0/dist/umd/lucide.min.js"></script>
        <script>
            /* Re-runnable: call rhRefreshIcons() any time you inject
                                                               HTML containing data-lucide */
            function rhRefreshIcons() {
                if (window.lucide && typeof lucide.createIcons === "function") {
                    lucide.createIcons();
                }
            }

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", rhRefreshIcons);
            } else {
                rhRefreshIcons();
            }
        </script>

        {# Testimonial slider — legacy javaScript.js #}
        <script src="{{ asset('assets/javaScript.js') }}"></script>

        {# REACT ISLAND — scroll-progress #}
        <script type="module" src="{{ asset('assets/react/scroll-progress.js') }}"></script>

        {# BFCache killer — same guard as base.html.twig (this
           template is standalone and does not extend base).
           After logout, a back/forward cached page must never
           be shown stale — force a real reload so the server
           re-checks the session. #}
        <script>
            window.addEventListener("pageshow", function (event) {
                if (event.persisted) {
                    window.location.reload();
                }
            });
        </script>

    </body>

</html>
