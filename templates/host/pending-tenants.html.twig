    /* ---- Dark mode (same approach as host/listings.html.twig) ---- */
    body[data-theme="dark"] .hp-page-title { color: #e8ecf1; }
    body[data-theme="dark"] .hp-empty-state { background: #141b24; border-color: #1a222b; color: #8d99a5; }
