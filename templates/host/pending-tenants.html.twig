    }

    /* SIGN-TO-ACCEPT MODAL */
    .pt-sign-sub {
        margin: -4px 0 14px;
        font-size: 12.5px;
        color: #6b7684;
        line-height: 1.6;
    }

    .pt-sign-sub b {
