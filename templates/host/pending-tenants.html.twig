{% endblock %}

{% block content %}
<div class="hp-page-header">
    <div>
        <h1 class="hp-page-title">Pending Tenants</h1>
        <p class="hp-page-subtitle">Tenants who applied for your spaces sit here until you accept or reject them. Accepting now requires signing the guest's receipt first. Verification badges show who completed ID + profile.</p>
    </div>
</div>

<div class="pt-list">
    {% if applications is empty %}

        <div class="hp-empty-state">
            <p class="hp-empty-state-title">No pending applications</p>
            <p>Once a tenant applies for one of your spaces, they'll show up here for you to accept or reject.</p>
        </div>

    {% else %}
        {% for app in applications %}
            <div
                class="pt-card"
                data-booking-id="{{ app.booking_id }}"
                data-booking-ref="{{ app.booking_ref }}"
                data-listing-title="{{ app.listing_title }}"
                data-listing-location="{{ app.listing_location }}"
                data-listing-photo="{{ app.listing_photo }}"
                data-tenant-name="{{ app.tenant_name }}"
                data-tenant-email="{{ app.tenant_email }}"
                data-tenant-avatar="{{ app.tenant_avatar }}"
                data-tenant-has-avatar="{{ app.tenant_has_avatar ? '1' : '0' }}"
                data-tenant-personal="{{ app.tenant_personal }}"
                data-tenant-verified="{{ app.tenant_verified ? '1' : '0' }}"
                data-checkin="{{ app.checkin_label }}"
                data-checkout="{{ app.checkout_label }}"
                data-daterange="{{ app.date_range }}"
                data-payment-status="{{ app.payment_status }}"
                data-payment-class="{{ app.payment_class }}"
                data-payment-time="{{ app.payment_time }}"
                data-guests="{{ app.guests }}"
                data-applied="{{ app.applied }}"
                data-total="{{ app.total }}"
                data-paid="{{ app.paid }}"
                data-balance="{{ app.balance }}"
                data-receipt-url="{{ app.receipt_url }}"
                tabindex="0"
                role="button"
                aria-label="View application details from {{ app.tenant_name }}">

                <img
                    class="pt-listing-photo"
                    src="{{ app.listing_photo }}"
                    alt="{{ app.listing_title }}"
                    onerror="this.onerror=null;this.src='/images/ListingPlaceholder.png';">

                <div class="pt-info">
                    <p class="pt-listing-title">{{ app.listing_title }}</p>
                    <p class="pt-listing-location">
                        {{ ui.icon('pin') }}
                        {{ app.listing_location }}
                    </p>

                    <div class="pt-tenant-row">
                        {# ★ TEMP PROFILE — real photo when one exists,
                           temporary icon otherwise #}
                        {% if app.tenant_has_avatar %}
                            <img
                                class="pt-tenant-avatar"
                                src="{{ app.tenant_avatar }}"
                                alt="{{ app.tenant_name }}"
                                onerror="this.onerror=null;this.src='/images/default-avatar.png';">
                        {% else %}
                            {{ ui.icon('circle-user-round', 'pt-avatar-icon') }}
                        {% endif %}
                        <div>
                            <p class="pt-tenant-name">
                                {{ app.tenant_name }}
                                {% if app.tenant_verified %}
                                    <span style="display:inline-flex;align-items:center;gap:4px;padding:2px 9px;background:#E8F8F1;color:#178A50;border:1px solid rgba(23,138,80,.35);border-radius:999px;font-size:10px;font-weight:800;vertical-align:middle;">&#10003; Verified</span>
                                {% else %}
                                    <span style="display:inline-flex;align-items:center;gap:4px;padding:2px 9px;background:#FFF4E0;color:#C77A00;border:1px dashed rgba(237,164,35,.5);border-radius:999px;font-size:10px;font-weight:800;vertical-align:middle;">Not Verified</span>
                                {% endif %}
                            </p>
                            <p class="pt-tenant-email">{{ app.tenant_email }}</p>
                        </div>
                    </div>

                    <p class="pt-applied-date">
                        Applied {{ app.applied }}
                    </p>
                </div>

                <div class="pt-payment">
                    <span class="pt-payment-status {{ app.payment_class }}">
                        {{ app.payment_status }}
                    </span>
                    <span class="pt-payment-time">{{ app.payment_time }}</span>
                    {% if app.receipt_url %}
                        <a
                            class="pt-receipt-link"
                            href="{{ app.receipt_url }}"
                            target="_blank"
                            rel="noopener"
                            title="Open the guest's official receipt">{{ ui.icon('file-text') }} View Receipt</a>
                    {% endif %}
                </div>

                <div class="pt-dates">
                    {{ ui.icon('calendar-days') }}
                    <span>{{ app.date_range }}</span>
                </div>

                <div class="pt-actions">
                    <strong class="pt-total">&#8369; {{ app.total }}</strong>
                    <div class="pt-buttons">
                        <button
                            type="button"
                            class="hp-btn-outline pt-btn-reject"
                            data-booking-id="{{ app.booking_id }}"
                            data-tenant-name="{{ app.tenant_name }}">
                            Reject
                        </button>
                        <button
                            type="button"
                            class="hp-btn-primary pt-btn-accept"
                            data-booking-id="{{ app.booking_id }}"
                            data-tenant-name="{{ app.tenant_name }}">
                            Accept
                        </button>
                    </div>
                </div>

            </div>
        {% endfor %}
    {% endif %}
</div>

<!-- =========================================================
     APPLICATION DETAILS MODAL
========================================================= -->
<div class="pt-modal-overlay" id="ptModalOverlay">
    <div class="pt-modal" role="dialog" aria-modal="true" aria-labelledby="ptModalTitle">

        <button type="button" class="pt-modal-close" id="ptModalClose" aria-label="Close">&times;</button>

        <div class="pt-modal-listing">
            <img class="pt-modal-listing-photo" id="ptModalListingPhoto" src="" alt="">
            <div>
                <p class="pt-modal-listing-title" id="ptModalListingTitle"></p>
                <p class="pt-modal-listing-location">
                    {{ ui.icon('pin') }}
                    <span id="ptModalListingLocation"></span>
                </p>
            </div>
        </div>

        <div class="pt-modal-tenant">
            <img class="pt-modal-tenant-avatar" id="ptModalTenantAvatar" src="" alt="">
            {# ★ TEMP PROFILE — icon variant, toggled by fillModal()
               from data-tenant-has-avatar #}
            <span class="pt-modal-avatar-icon" id="ptModalTenantAvatarIcon" style="display:none">{{ ui.icon('circle-user-round') }}</span>
            <div>
                <p class="pt-modal-tenant-name">
                    <span id="ptModalTenantName"></span>
                    <span id="ptModalTenantVerified" class="pt-verified-pill"></span>
                </p>
                <p class="pt-modal-tenant-email" id="ptModalTenantEmail"></p>
            </div>
        </div>

        <div id="ptModalTenantPersonalWrap" style="display:none; margin:-4px 0 14px;">
            <span style="display:block; font-size:11px; font-weight:700; letter-spacing:.6px; text-transform:uppercase; color:#8B93A6; margin-bottom:6px;">Guest Personal Photo</span>
            <a id="ptModalTenantPersonalLink" href="#" target="_blank" rel="noopener" title="Open full size">
                <img id="ptModalTenantPersonal" src="" alt="Personal photo"
                    style="width:100%; max-width:380px; height:170px; object-fit:cover; object-position:center; border-radius:10px; border:1px solid #EEF1F6; display:block;">
            </a>
            <span style="display:block; margin-top:5px; font-size:11px; color:#8B93A6;">
                Used to recognize the guest in person. Click to open full size.
            </span>
        </div>

        <h3 class="pt-modal-heading" id="ptModalTitle">Application Details</h3>

        <div class="pt-modal-payment">
            <span class="pt-modal-payment-status" id="ptModalPaymentStatus"></span>
            <span class="pt-modal-payment-time" id="ptModalPaymentTime"></span>
        </div>

        <a class="pt-modal-receipt-link" id="ptModalReceiptLink" href="#" target="_blank" rel="noopener" style="display:none;">
            {{ ui.icon('file-text') }} View Guest Receipt
        </a>

        <div class="pt-modal-paid-row">
            <div>
                <span class="pt-modal-muted">Paid so far</span>
                <strong>&#8369; <span id="ptModalPaid"></span></strong>
            </div>
            <div>
                <span class="pt-modal-muted">Balance</span>
                <strong>&#8369; <span id="ptModalBalance"></span></strong>
            </div>
        </div>

        <div class="pt-modal-daterange">
            <span class="pt-modal-muted">Dates</span>
            <strong id="ptModalDateRange"></strong>
        </div>

        <div class="pt-modal-grid">
            <div class="pt-modal-detail">
                <span class="pt-modal-muted">Check-in</span>
                <strong id="ptModalCheckin"></strong>
            </div>
            <div class="pt-modal-detail">
                <span class="pt-modal-muted">Check-out</span>
                <strong id="ptModalCheckout"></strong>
            </div>
            <div class="pt-modal-detail">
                <span class="pt-modal-muted">Guests</span>
                <strong id="ptModalGuests"></strong>
            </div>
            <div class="pt-modal-detail">
                <span class="pt-modal-muted">Applied On</span>
                <strong id="ptModalApplied"></strong>
            </div>
        </div>

        <div class="pt-modal-total-row">
            <span class="pt-modal-muted">Total</span>
            <strong>&#8369; <span id="ptModalTotal"></span></strong>
        </div>

        <div class="pt-buttons pt-modal-buttons">
            <button type="button" class="hp-btn-outline pt-btn-reject" id="ptModalReject">
                Reject
            </button>
            <button type="button" class="hp-btn-primary pt-btn-accept" id="ptModalAccept">
                Accept
            </button>
        </div>

    </div>
</div>

<!-- =========================================================
     SIGN-TO-ACCEPT MODAL (signature pad)
========================================================= -->
<div class="pt-modal-overlay" id="ptSignOverlay">
    <div class="pt-modal pt-sign-modal" role="dialog" aria-modal="true" aria-labelledby="ptSignTitle">

        <button type="button" class="pt-modal-close" id="ptSignClose" aria-label="Close">&times;</button>

        <h3 class="pt-modal-heading" id="ptSignTitle">Sign the receipt to accept</h3>
        <p class="pt-sign-sub">
            Your signature will be stamped on the guest's official receipt for
            booking <b id="ptSignBookingRef">#000000</b>. Signing also accepts this application.
        </p>

        <div class="pt-sign-summary">
            <div><span class="pt-modal-muted">Tenant</span><strong id="ptSignTenant"></strong></div>
            <div><span class="pt-modal-muted">Listing</span><strong id="ptSignListing"></strong></div>
            <div><span class="pt-modal-muted">Paid so far</span><strong>&#8369; <span id="ptSignPaid"></span></strong></div>
            <div><span class="pt-modal-muted">Total</span><strong>&#8369; <span id="ptSignTotal"></span></strong></div>
        </div>

        <a class="pt-modal-receipt-link" id="ptSignViewReceipt" href="#" target="_blank" rel="noopener" style="display:none;">
            {{ ui.icon('file-text') }} View full receipt
        </a>

        <div class="pt-sign-canvas-wrap">
            <canvas id="ptSignCanvas"></canvas>
            <span class="pt-sign-hint" id="ptSignHint">{{ ui.icon('pen-line') }} Draw your signature here</span>
        </div>

        <div class="pt-sign-tools">
            <button type="button" class="hp-btn-outline" id="ptSignClear">Clear</button>
        </div>

        <div class="pt-buttons pt-modal-buttons">
            <button type="button" class="hp-btn-outline" id="ptSignCancel">Cancel</button>
            <button type="button" class="hp-btn-primary" id="ptSignConfirm" disabled>
                Sign &amp; Accept
            </button>
        </div>

    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    (function() {
        "use strict";

        /* =========================================================
           SHARED HELPERS
        ========================================================= */
        function openOverlay(el) {
            if (el) el.classList.add('open');
        }

        function closeOverlay(el) {
            if (el) el.classList.remove('open');
        }

        /* Keep the sidebar "Pending Tenants" badge in sync after
           an accept/reject without a page reload. */
        function refreshBadges() {
            var link = document.querySelector('a[href="/host/pending-tenants"]');
            if (!link) {
                return;
            }
            var badge = link.querySelector('.hp-side-badge');
            if (!badge) {
                return;
            }
            var n = (parseInt(badge.textContent, 10) || 0) - 1;
            if (n <= 0) {
                badge.remove();
            } else {
                badge.textContent = n;
            }
        }

        /* =========================================================
           ACCEPT / REJECT (reject goes through here directly;
           accept goes through the signature pad instead)
           Symfony URL map: POST /host/bookings/{id}/reject
           (legacy reject-booking.php). Responses {success} |
           {message}.
        ========================================================= */
        function handleDecision(bookingId, tenantName, buttons, card, endpoint, confirmMessage, busyText, onSuccess) {
            if (!confirm(confirmMessage.replace('%s', tenantName || 'this tenant'))) {
                return;
            }

            buttons.forEach(function(b) {
                b.disabled = true;
            });
            buttons.forEach(function(b) {
                if (b.classList.contains('pt-btn-accept') || b.classList.contains('pt-btn-reject')) {
                    b.textContent = busyText;
                }
            });

            fetch(endpoint.replace('{id}', encodeURIComponent(bookingId)), {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: 'booking_id=' + encodeURIComponent(bookingId)
                })
                .then(function(res) {
                    return res.json();
                })
                .then(function(data) {
                    if (data.success) {
                        if (card) card.remove();
                        if (onSuccess) onSuccess();
                    } else {
                        alert(data.error || data.message || 'Something went wrong. Please try again.');
                    }
                })
                .catch(function() {
                    alert('Something went wrong. Please try again.');
                })
                .finally(function() {
                    buttons.forEach(function(b) {
                        if (!b || !document.body.contains(b)) {
                            return;
                        }
                        b.disabled = false;
                        if (b.classList.contains('pt-btn-accept')) {
                            b.textContent = 'Accept';
                        }
                        if (b.classList.contains('pt-btn-reject')) {
                            b.textContent = 'Reject';
                        }
                    });
                });
        }

        /* Remove a card by booking id (used by the signature
           confirm, where the triggering card may not be in scope) */
        function removeCard(bookingId) {
            var card = document.querySelector('.pt-card[data-booking-id="' + bookingId + '"]');
            if (card) {
                card.remove();
            }
        }

        /* =========================================================
           DETAILS MODAL
        ========================================================= */
        var ptOverlay = document.getElementById('ptModalOverlay');
        var ptClose = document.getElementById('ptModalClose');

        function fillModal(card) {
            var d = card.dataset;

            document.getElementById('ptModalListingPhoto').src = d.listingPhoto;
            document.getElementById('ptModalListingTitle').textContent = d.listingTitle;
            document.getElementById('ptModalListingLocation').textContent = d.listingLocation;

            /* ★ TEMP PROFILE — img vs icon, per applicant */
            var avImg = document.getElementById('ptModalTenantAvatar');
            var avIco = document.getElementById('ptModalTenantAvatarIcon');
            if (d.tenantHasAvatar === '1') {
                avImg.style.display = '';
                avIco.style.display = 'none';
                avImg.src = d.tenantAvatar;
            } else {
                avImg.style.display = 'none';
                avIco.style.display = '';
            }

            document.getElementById('ptModalTenantName').textContent = d.tenantName;
            document.getElementById('ptModalTenantEmail').textContent = d.tenantEmail;

            var pill = document.getElementById('ptModalTenantVerified');
            pill.textContent = d.tenantVerified === '1' ? '\u2713 Verified' : 'Not Verified';
            pill.className = 'pt-verified-pill ' + (d.tenantVerified === '1' ? 'yes' : 'no');

            var wrap = document.getElementById('ptModalTenantPersonalWrap');
            if (d.tenantPersonal) {
                wrap.style.display = 'block';
                document.getElementById('ptModalTenantPersonal').src = d.tenantPersonal;
                document.getElementById('ptModalTenantPersonalLink').href = d.tenantPersonal;
            } else {
                wrap.style.display = 'none';
            }

            var status = document.getElementById('ptModalPaymentStatus');
            status.textContent = d.paymentStatus;
            status.className = 'pt-modal-payment-status ' + (d.paymentClass === 'pt-payment-paid' ? 'pt-payment-paid' : 'pt-payment-pending');
            document.getElementById('ptModalPaymentTime').textContent = d.paymentTime;

            var receipt = document.getElementById('ptModalReceiptLink');
            if (d.receiptUrl) {
                receipt.style.display = 'inline-flex';
                receipt.href = d.receiptUrl;
            } else {
                receipt.style.display = 'none';
            }

            document.getElementById('ptModalPaid').textContent = d.paid;
            document.getElementById('ptModalBalance').textContent = d.balance;
            document.getElementById('ptModalDateRange').textContent = d.daterange;
            document.getElementById('ptModalCheckin').textContent = d.checkin;
            document.getElementById('ptModalCheckout').textContent = d.checkout;
            document.getElementById('ptModalGuests').textContent = d.guests;
            document.getElementById('ptModalApplied').textContent = d.applied;
            document.getElementById('ptModalTotal').textContent = d.total;

            ptOverlay.dataset.bookingId = d.bookingId;
            ptOverlay.dataset.bookingRef = d.bookingRef;
            ptOverlay.dataset.tenantName = d.tenantName;
            ptOverlay.dataset.receiptUrl = d.receiptUrl || '';
        }

        function openDetails(card) {
            fillModal(card);
            openOverlay(ptOverlay);
        }

        Array.prototype.forEach.call(document.querySelectorAll('.pt-card'), function(card) {
            card.addEventListener('click', function(event) {
                if (event.target.closest('a, button')) {
                    return;
                }
                openDetails(card);
            });
            card.addEventListener('keydown', function(event) {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    openDetails(card);
                }
            });
        });

        ptClose.addEventListener('click', function() {
            closeOverlay(ptOverlay);
        });
        ptOverlay.addEventListener('click', function(event) {
            if (event.target === ptOverlay) {
                closeOverlay(ptOverlay);
            }
        });

        /* =========================================================
           REJECT (card buttons + details modal)
        ========================================================= */
        Array.prototype.forEach.call(document.querySelectorAll('.pt-btn-reject'), function(btn) {
            btn.addEventListener('click', function(event) {
                event.stopPropagation();

                var card = btn.closest('.pt-card');
                var bookingId, tenantName, buttons;

                if (card) {
                    bookingId = card.dataset.bookingId;
                    tenantName = card.dataset.tenantName;
                    buttons = Array.prototype.slice.call(card.querySelectorAll('.pt-btn-reject, .pt-btn-accept'));
                } else {
                    bookingId = ptOverlay.dataset.bookingId;
                    tenantName = ptOverlay.dataset.tenantName;
                    buttons = [document.getElementById('ptModalReject'), document.getElementById('ptModalAccept')];
                }

                handleDecision(
                    bookingId,
                    tenantName,
                    buttons,
                    card,
                    '/host/bookings/{id}/reject',
                    "Reject %s's application for this listing? Their reserve will be refunded in full.",
                    'Rejecting...',
                    refreshBadges
                );
            });
        });

        /* =========================================================
           ACCEPT — opens the signature pad (card + modal)
        ========================================================= */
        var ptSignOverlay = document.getElementById('ptSignOverlay');
        var ptSignCanvas = document.getElementById('ptSignCanvas');
        var ptSignHint = document.getElementById('ptSignHint');
        var ptSignConfirm = document.getElementById('ptSignConfirm');
        var ptSignCtx = ptSignCanvas ? ptSignCanvas.getContext('2d') : null;
        var ptHasInk = false;

        Array.prototype.forEach.call(document.querySelectorAll('.pt-btn-accept'), function(btn) {
            btn.addEventListener('click', function(event) {
                event.stopPropagation();

                var card = btn.closest('.pt-card');
                var bookingId, tenantName, bookingRef, listingTitle, paid, total, receiptUrl;

                if (card) {
                    bookingId = card.dataset.bookingId;
                    tenantName = card.dataset.tenantName;
                    bookingRef = card.dataset.bookingRef;
                    listingTitle = card.dataset.listingTitle;
                    paid = card.dataset.paid;
                    total = card.dataset.total;
                    receiptUrl = card.dataset.receiptUrl;
                } else {
                    bookingId = ptOverlay.dataset.bookingId;
                    tenantName = ptOverlay.dataset.tenantName;
                    bookingRef = ptOverlay.dataset.bookingRef;
                    listingTitle = document.getElementById('ptModalListingTitle').textContent;
                    paid = document.getElementById('ptModalPaid').textContent;
                    total = document.getElementById('ptModalTotal').textContent;
                    receiptUrl = ptOverlay.dataset.receiptUrl || '';
                }

                document.getElementById('ptSignBookingRef').textContent = '#' + bookingRef;
                document.getElementById('ptSignTenant').textContent = tenantName;
                document.getElementById('ptSignListing').textContent = listingTitle;
                document.getElementById('ptSignPaid').textContent = paid;
                document.getElementById('ptSignTotal').textContent = total;

                var viewLink = document.getElementById('ptSignViewReceipt');
                if (receiptUrl) {
                    viewLink.style.display = 'inline-flex';
                    viewLink.href = receiptUrl;
                } else {
                    viewLink.style.display = 'none';
                }

                ptSignOverlay.dataset.bookingId = bookingId;
                ptSignOverlay.dataset.bookingRef = bookingRef;

                closeOverlay(ptOverlay);
                openOverlay(ptSignOverlay);

                /* ★ CANVAS FIX — size NOW, while the overlay is
                   visible. Sizing at page load (overlay hidden)
                   produced a 0x0 bitmap that could never draw. */
                signSizeCanvas();
            });
        });

        /* =========================================================
           SIGNATURE PAD — canvas draw (pointer events, HiDPI)
           ★ CANVAS FIX: skip sizing while hidden (0x0 bitmap),
           and re-apply stroke settings after every resize —
           resizing a canvas wipes its 2D context state.
        ========================================================= */
        function signSizeCanvas() {
            if (!ptSignCanvas || !ptSignCtx) {
                return;
            }

            var ratio = window.devicePixelRatio || 1;
            var rect = ptSignCanvas.getBoundingClientRect();

            /* Skip while hidden — sizing a display:none canvas
               produces a 0x0 bitmap that can never draw */
            if (rect.width === 0 || rect.height === 0) {
                return;
            }

            var data = ptHasInk ? ptSignCanvas.toDataURL() : null;

            ptSignCanvas.width = Math.round(rect.width * ratio);
            ptSignCanvas.height = Math.round(rect.height * ratio);
            ptSignCtx.scale(ratio, ratio);

            /* Resizing wipes context state — re-apply stroke
               settings */
            ptSignCtx.lineWidth = 2.2;
            ptSignCtx.lineCap = 'round';
            ptSignCtx.lineJoin = 'round';
            ptSignCtx.strokeStyle = '#1c2a38';

            if (data) {
                var img = new Image();
                img.onload = function() {
                    ptSignCtx.drawImage(img, 0, 0, rect.width, rect.height);
                };
                img.src = data;
            }
        }

        function signStrokeStart(x, y) {
            ptHasInk = true;
            ptSignHint.classList.add('hidden');
            ptSignConfirm.disabled = false;
            ptSignCtx.beginPath();
            ptSignCtx.moveTo(x, y);
        }

        function signStrokeMove(x, y) {
            ptSignCtx.lineTo(x, y);
            ptSignCtx.stroke();
        }

        if (ptSignCanvas && ptSignCtx) {

            /* Initial call is now harmless — the zero-size guard
               skips it while the overlay is hidden */
            signSizeCanvas();

            var signResizeTimer = null;
            window.addEventListener('resize', function() {
                window.clearTimeout(signResizeTimer);
                signResizeTimer = window.setTimeout(signSizeCanvas, 150);
            });

            ptSignCanvas.addEventListener('pointerdown', function(e) {
                e.preventDefault();
                var r = ptSignCanvas.getBoundingClientRect();
                signStrokeStart(e.clientX - r.left, e.clientY - r.top);
                ptSignCanvas.setPointerCapture(e.pointerId);
            });

            ptSignCanvas.addEventListener('pointermove', function(e) {
                if (!ptHasInk || e.buttons === 0) {
                    return;
                }
                var r = ptSignCanvas.getBoundingClientRect();
                signStrokeMove(e.clientX - r.left, e.clientY - r.top);
            });

            window.addEventListener('pointerup', function() {
                if (ptSignCtx) {
                    ptSignCtx.beginPath();
                }
            });
        }

        function signReset() {
            if (ptSignCtx && ptSignCanvas) {
                var rect = ptSignCanvas.getBoundingClientRect();
                ptSignCtx.clearRect(0, 0, rect.width, rect.height);
            }
            ptHasInk = false;
            if (ptSignHint) {
                ptSignHint.classList.remove('hidden');
            }
            if (ptSignConfirm) {
                ptSignConfirm.disabled = true;
                ptSignConfirm.textContent = 'Sign & Accept';
            }
        }

        function closeSign() {
            closeOverlay(ptSignOverlay);
            signReset();
        }

        var ptSignClear = document.getElementById('ptSignClear');
        var ptSignClose = document.getElementById('ptSignClose');
        var ptSignCancel = document.getElementById('ptSignCancel');

        if (ptSignClear) {
            ptSignClear.addEventListener('click', signReset);
        }
        if (ptSignClose) {
            ptSignClose.addEventListener('click', closeSign);
        }
        if (ptSignCancel) {
            ptSignCancel.addEventListener('click', closeSign);
        }

        ptSignOverlay.addEventListener('click', function(event) {
            if (event.target === ptSignOverlay) {
                closeSign();
            }
        });

        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                closeOverlay(ptOverlay);
                closeSign();
            }
        });

        /* =========================================================
           CONFIRM — save the signature
           (POST /host/bookings/{id}/sign, legacy sign-receipt.php),
           then accept (POST /host/bookings/{id}/accept, legacy
           accept-booking.php), then open the receipt
           (/payment/confirmation/{id}, legacy
           payment-confirmation.php?id=N).
        ========================================================= */
        if (ptSignConfirm) {
            ptSignConfirm.addEventListener('click', function() {

                if (!ptHasInk) {
                    return;
                }

                var bookingId = ptSignOverlay.dataset.bookingId;
                if (!bookingId) {
                    return;
                }

                ptSignConfirm.disabled = true;
                ptSignConfirm.textContent = 'Signing\u2026';

                var dataUrl = ptSignCanvas.toDataURL('image/png');

                fetch('/host/bookings/' + encodeURIComponent(bookingId) + '/sign', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                        body: 'booking_id=' + encodeURIComponent(bookingId) +
                            '&signature=' + encodeURIComponent(dataUrl),
                        credentials: 'same-origin'
                    })
                    .then(function(res) {
                        return res.json();
                    })
                    .then(function(data) {
                        if (!data || !data.success) {
                            throw new Error((data && (data.error || data.message)) || 'Signing failed.');
                        }
                        return fetch('/host/bookings/' + encodeURIComponent(bookingId) + '/accept', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded'
                            },
                            body: 'booking_id=' + encodeURIComponent(bookingId),
                            credentials: 'same-origin'
                        }).then(function(res) {
                            return res.json();
                        });
                    })
                    .then(function(data) {
                        if (data && data.success) {
                            removeCard(bookingId);
                            refreshBadges();
                            closeSign();
                            window.location.href =
                                '/payment/confirmation/' + encodeURIComponent(bookingId);
                        } else {
                            throw new Error((data && (data.error || data.message)) || 'Could not accept the application.');
                        }
                    })
                    .catch(function(err) {
                        window.alert(err.message || 'Something went wrong. Please try again.');
                        ptSignConfirm.disabled = false;
                        ptSignConfirm.textContent = 'Sign & Accept';
                    });
            });
        }

    })();
</script>
{% endblock %}
