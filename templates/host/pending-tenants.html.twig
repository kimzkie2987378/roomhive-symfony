        font-size: 11px;
        font-weight: 700;
    }

    .pt-modal-payment-time {
        font-size: 12px;
        color: #6b7684;
    }

    .pt-modal-receipt-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 10px;
        padding: 9px 14px;
        border-radius: 10px;
        background: #FDF1DC;
