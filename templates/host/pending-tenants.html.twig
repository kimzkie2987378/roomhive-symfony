    body[data-theme="dark"] .pt-modal-payment-time,
    body[data-theme="dark"] .pt-sign-sub { color: #8d99a5; }
    body[data-theme="dark"] .pt-card,
    body[data-theme="dark"] .pt-modal-listing,
    body[data-theme="dark"] .pt-modal-tenant,
    body[data-theme="dark"] .pt-modal-payment,
    body[data-theme="dark"] .pt-modal-paid-row,
    body[data-theme="dark"] .pt-modal-daterange,
    body[data-theme="dark"] .pt-sign-summary { border-color: #1a222b; }
    body[data-theme="dark"] .pt-modal-payment,
