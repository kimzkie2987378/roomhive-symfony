{# roomhive/host/reviews.html.twig
   Host › Reviews — 1:1 port of legacy host/hostreviews.php.

   Two cards:
     • Rating summary — big average (number_format 1), Lucide star
       row, "N review(s)" caption, and the 5★→1★ distribution bars
       (count + percentage pre-computed in the controller).
     • All Reviews — list of every review left on the host's
       listings (avatar, name, optional "Verified stay" badge,
       inline stars + N.N/5, M j, Y date, "on {listing}", comment
       text or the "(No written comment)" italic placeholder).

   hp_stars() — a Twig macro that mirrors the legacy helper
   exactly: 5 stars, full = floor(rating) capped 0..5, filled
   stars get fill:currentColor, empty stars dim to 30% opacity.
   Color inherits from the .hp-stars container (gold). Same
   approach as the Lucide icons in the macros file: a single SVG,
   fill toggled by class — no JS touches them.

   ICON SUBSTITUTIONS — same rule as the other host pages
   (the macros file uses the older lucide.dev names the rest of
   the shell standardized on):
     legacy `star`        → macro 'star'        (exists)
     legacy `badge-check` → macro 'check-circle' (same substitution
                            host/bookings.html.twig documents for
                            the Confirmed Stays pill — a check
                            inside a circle reads the same as
                            badge-check)
   No page-level lucide loader needed — the shared navbar ships
   the guarded loader.

   Pairs with: HostReviewsController
     GET /host/reviews   name app_host_reviews
#}
{% extends 'host/base.html.twig' %}
{% import 'admin/_macros.html.twig' as ui %}

{% set active_nav = 'reviews' %}

{% block page_title %}Reviews — RoomHive{% endblock %}

{% block styles %}
<style>
    /* ---- Page header (same values as the other host pages) ---- */
    .hp-page-header {
        display: flex; align-items: center; justify-content: space-between;
        gap: 16px; flex-wrap: wrap;
    }
    .hp-page-title { margin: 0; font-size: 24px; font-weight: 800; color: var(--rh-ink); }
    .hp-page-subtitle { margin: 4px 0 0; font-size: 13px; color: var(--rh-muted); max-width: 680px; }

    /* ---- Empty state ---- */
    .hp-empty-state {
        text-align: center; padding: 56px 20px;
        background: #fff; border: 1px dashed var(--rh-line);
        border-radius: var(--rh-radius);
        font-size: 13.5px; color: var(--rh-muted);
    }
    .hp-empty-state p { margin: 0; }
    .hp-empty-state-title {
        font-size: 15px; font-weight: 700; color: var(--rh-ink); margin-bottom: 6px;
    }

    /* =========================================================
       RATING HERO + DISTRIBUTION
    ========================================================= */
    .hp-rating-hero {
        display: grid;
        grid-template-columns: minmax(180px, 220px) 1fr;
        gap: 28px;
        align-items: center;
    }
    @media (max-width: 640px) {
        .hp-rating-hero { grid-template-columns: 1fr; gap: 18px; }
    }
    .hp-rating-big {
        font-size: 48px; font-weight: 800; line-height: 1;
        color: var(--rh-ink); letter-spacing: -0.02em;
    }
    .hp-stars {
        color: #eda423;     /* gold — inherited by the star SVGs */
        display: inline-flex;
        align-items: center;
        margin-top: 6px;
    }
    .hp-rating-count {
        margin-top: 4px; font-size: 12px; font-weight: 600;
        color: var(--rh-muted);
    }

    /* Star row output by the hp_stars macro */
    .hp-stars-row {
        display: inline-flex;
        align-items: center;
        gap: 1px;
    }
    .hp-stars-row svg {
        width: 14px; height: 14px;
        color: #eda423;
    }
    .hp-stars-row .hp-star-full  { fill: currentColor; }
    .hp-stars-row .hp-star-empty { opacity: .3; }

    /* Hero stars slightly larger — the .hp-rating-big + .hp-stars
       selector legacy used doesn't apply here (separate siblings),
       so we target the hero's .hp-stars directly. */
    .hp-rating-hero .hp-stars .hp-stars-row svg {
        width: 17px; height: 17px;
    }

    /* Distribution */
    .hp-distribution { display: flex; flex-direction: column; gap: 6px; }
    .hp-dist-row {
        display: flex; align-items: center; gap: 10px;
        font-size: 12px; color: var(--rh-muted); font-weight: 600;
    }
    .hp-dist-track {
        flex: 1; height: 8px; border-radius: 4px;
        background: #F0F1F6; overflow: hidden;
    }
    .hp-dist-fill {
        height: 100%; border-radius: 4px;
        background: linear-gradient(90deg, #f6c04e, #eda423);
        transition: width 0.6s cubic-bezier(.22,1,.36,1);
    }

    /* =========================================================
       REVIEW LIST
    ========================================================= */
    .hp-review-item {
        display: flex; gap: 12px; align-items: flex-start;
        padding: 16px 0;
        border-bottom: 1px solid #F6F7FB;
    }
    .hp-review-item:last-child { border-bottom: none; padding-bottom: 0; }
    .hp-review-item:first-child { padding-top: 0; }

    .hp-review-avatar {
        width: 40px; height: 40px; border-radius: 50%;
        object-fit: cover; flex-shrink: 0;
        background: #F0F1F6;
    }

    .hp-review-head {
        display: flex; align-items: center; flex-wrap: wrap; gap: 8px;
        font-size: 13px;
    }
    .hp-review-head strong { color: var(--rh-ink); font-size: 14px; }

    /* Verified-stay badge (badge-check → check-circle macro) */
    .hp-verified-stay {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 2px 9px; border-radius: 999px;
        background: #E7F7EC; color: #1fa971;
        font-size: 10px; font-weight: 700;
    }
    .hp-verified-stay svg {
        width: 11px; height: 11px;
        vertical-align: -1.5px;
    }

    /* Inline stars next to the rating number (smaller row, same
       gold color — color inherits from .hp-stars) */
    .hp-review-head .hp-stars .hp-stars-row svg {
        width: 13px; height: 13px;
    }

    .hp-review-date {
        margin-left: auto;
        color: var(--rh-muted); font-size: 12px;
    }
    .hp-review-listing {
        display: block; margin-top: 2px;
        font-size: 12px; color: var(--rh-muted); font-weight: 600;
    }
    .hp-review-text {
        margin: 8px 0 0; font-size: 13.5px; line-height: 1.55;
        color: var(--rh-ink);
    }

    /* ---- Icon baseline ---- */
    svg.icon { display: inline-block; vertical-align: -0.18em; flex-shrink: 0; }

    /* ---- Dark mode ---- */
    body[data-theme="dark"] .hp-page-title { color: #e8ecf1; }
    body[data-theme="dark"] .hp-rating-big { color: #e8ecf1; }
    body[data-theme="dark"] .hp-rating-count { color: #8d99a5; }
    body[data-theme="dark"] .hp-dist-row { color: #8d99a5; }
    body[data-theme="dark"] .hp-dist-track { background: #1a222b; }
    body[data-theme="dark"] .hp-review-head strong { color: #e8ecf1; }
    body[data-theme="dark"] .hp-review-date { color: #8d99a5; }
    body[data-theme="dark"] .hp-review-listing { color: #8d99a5; }
    body[data-theme="dark"] .hp-review-text { color: #e8ecf1; }
    body[data-theme="dark"] .hp-review-avatar { background: #1a222b; }
    body[data-theme="dark"] .hp-verified-stay { background: rgba(47, 190, 125, 0.15); color: #4ade80; }
    body[data-theme="dark"] .hp-review-item { border-bottom-color: #1a222b; }
    body[data-theme="dark"] .hp-empty-state { background: #141b24; border-color: #1a222b; color: #8d99a5; }
    body[data-theme="dark"] .hp-empty-state-title { color: #e8ecf1; }
</style>
{% endblock %}

{# =========================================================
   hp_stars macro — mirrors legacy hp_stars() exactly.
   Renders 5 Lucide stars in a row: stars 1..stars_full get the
   'hp-star-full' class (fill: currentColor), the rest get
   'hp-star-empty' (opacity: .3). Color inherits from the
   enclosing .hp-stars container (gold).

   The star SVG is the same markup ui.icon('star') emits — pulled
   directly from the macros file's data so any future path update
   in admin/_macros.html.twig propagates here automatically.
========================================================= #}
{% macro hp_stars(stars_full) %}
{% set star_path = '<path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/>' %}
<span class="hp-stars-row" aria-hidden="true">
    {% for s in 1..5 %}
        <svg class="icon hp-star {{ s <= stars_full ? 'hp-star-full' : 'hp-star-empty' }}"
             width="24" height="24" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round">{{ star_path|raw }}</svg>
    {% endfor %}
</span>
{% endmacro %}

{% import _self as page %}

{% block content %}
<div class="hp-page-header">
    <div>
        <h1 class="hp-page-title">Reviews</h1>
        <p class="hp-page-subtitle">What tenants say about your listings.</p>
    </div>
</div>

<!-- Rating summary -->
<section class="hp-card">
    <div class="hp-rating-hero">
        <div style="text-align:center;">
            <div class="hp-rating-big">{{ avg_display }}</div>
            <div class="hp-stars">{{ page.hp_stars(stars_full) }}</div>
            <div class="hp-rating-count">{{ total_reviews }} {{ review_word }}</div>
        </div>
        <div class="hp-distribution">
            {% for row in dist_rows %}
                <div class="hp-dist-row">
                    <span style="width:52px;">{{ row.star }} {{ row.star_word }}</span>
                    <div class="hp-dist-track">
                        <div class="hp-dist-fill" style="width: {{ row.pct }}%;"></div>
                    </div>
                    <span style="width:30px;text-align:right;">{{ row.count }}</span>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- Review list -->
<section class="hp-card">
    <div class="hp-card-header">
        <h3>All Reviews</h3>
    </div>

    {% if reviews is empty %}
        <div class="hp-empty-state">
            <p class="hp-empty-state-title">No reviews yet</p>
            <p>After tenants rate your listings, their feedback will appear here.</p>
        </div>
    {% else %}
        {% for r in reviews %}
            <div class="hp-review-item">
                <img class="hp-review-avatar" src="{{ r.reviewer_avatar }}" alt="">

                <div style="flex:1;min-width:0;">
                    <div class="hp-review-head">
                        <strong>{{ r.reviewer_name }}</strong>

                        {% if r.verified_stay %}
                            <span class="hp-verified-stay">
                                {{ ui.icon('check-circle') }} Verified stay
                            </span>
                        {% endif %}

                        <span class="hp-stars">{{ page.hp_stars(r.stars_full) }}</span>
                        <span style="color:var(--rh-muted);font-size:12px;">{{ r.rating_display }}/5</span>
                        <span class="hp-review-date">{{ r.created_display }}</span>
                    </div>
                    <span class="hp-review-listing">on {{ r.listing_title }}</span>

                    {% if r.has_comment %}
                        <p class="hp-review-text">{{ r.comment }}</p>
                    {% else %}
                        <p class="hp-review-text" style="color:var(--rh-muted);font-style:italic;">(No written comment)</p>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    {% endif %}
</section>
{% endblock %}
