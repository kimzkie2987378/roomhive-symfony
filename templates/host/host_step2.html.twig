                    { name: "Pagadian City", province: "Zamboanga del Sur" },
                    { name: "Ipil", province: "Zamboanga Sibugay" },
                    /* Region X */
                    { name: "Cagayan de Oro City", province: "Misamis Oriental" },
                    { name: "El Salvador City", province: "Misamis Oriental" },
                    { name: "Gingoog City", province: "Misamis Oriental" },
                    { name: "Iligan City", province: "Lanao del Norte" },
                    { name: "Malaybalay City", province: "Bukidnon" },
                    { name: "Valencia City", province: "Bukidnon" },
                    { name: "Oroquieta City", province: "Misamis Occidental" },
                    { name: "Ozamiz City", province: "Misamis Occidental" },
                    { name: "Tangub City", province: "Misamis Occidental" },
                    { name: "Mambajao", province: "Camiguin" },
                    /* Region XI */
                    { name: "Davao City", province: "Davao del Sur" },
                    { name: "Tagum City", province: "Davao del Norte" },
                    { name: "Panabo City", province: "Davao del Norte" },
                    { name: "Samal City", province: "Davao del Norte" },
                    { name: "Mati City", province: "Davao Oriental" },
                    { name: "Digos City", province: "Davao del Sur" },
                    { name: "Nabunturan", province: "Davao de Oro" },
                    { name: "Malita", province: "Davao Occidental" },
                    /* Region XII */
                    { name: "General Santos City", province: "South Cotabato" },
                    { name: "Koronadal City", province: "South Cotabato" },
                    { name: "Kidapawan City", province: "Cotabato" },
                    { name: "Tacurong City", province: "Sultan Kudarat" },
                    { name: "Alabel", province: "Sarangani" },
                    /* Caraga */
                    { name: "Butuan City", province: "Agusan del Norte" },
                    { name: "Cabadbaran City", province: "Agusan del Norte" },
                    { name: "Bayugan City", province: "Agusan del Sur" },
                    { name: "Surigao City", province: "Surigao del Norte" },
                    { name: "Bislig City", province: "Surigao del Sur" },
                    { name: "Tandag City", province: "Surigao del Sur" },
                    /* BARMM */
                    { name: "Marawi City", province: "Lanao del Sur" },
                    { name: "Lamitan City", province: "Basilan" },
                    { name: "Jolo", province: "Sulu" },
                    { name: "Bongao", province: "Tawi-Tawi" },
                ];

                /* =====================================================
                                                   SHARED PICKER FACTORY (cont-48 — Step 1's
                                                   createRhDropdown ported over with all its fixes:
                                                   cont-44 var-in-applyPick + stacking lift, cont-45
                                                   input-dispatch on pick, cont-46 touch-to-open +
                                                   stale-list focus + guarded blur, open-implies-focus)
                                                   Creates one single-panel dropdown under the given
                                                   input. opts:
                                                     input        HTMLInputElement (required)
                                                     headerLabel  string shown in the sticky header
                                                     tag          pill text ("Province" / "City")
                                                     findMatches  function(query) → [{ name, sub?, lat?, lng? }]
                                                     allMatches   function() → full touch-to-open list
                                                     applyPick    function(item) → sets input value
                                                ===================================================== */
                function createRhPicker(opts) {
                    var input = opts.input;
                    if (!input) return;

                    var wrapper = input.closest(".input-with-icon") || input.parentElement;
                    if (!wrapper) return;

                    /* STACKING LIFT host: the .input-group around the
                                                       input is raised (z-index 5000) while the dropdown
                                                       is open — later sibling groups (Exact Address,
                                                       map pin) that style.css may put in their own
                                                       stacking contexts can then never paint over the
                                                       open list (cont-44 cure). */
                    var group = input.closest(".input-group");

                    var dropdown = document.createElement("div");
                    dropdown.className = "rh-province-dropdown";
                    dropdown.setAttribute("role", "listbox");
                    dropdown.setAttribute("aria-label", opts.headerLabel);
                    dropdown.id = "rhDd_" + input.id;

                    var header = document.createElement("div");
                    header.className = "rh-province-header";
                    header.textContent = opts.headerLabel;

                    var listEl = document.createElement("div");
                    listEl.className = "rh-province-list";

                    dropdown.appendChild(header);
                    dropdown.appendChild(listEl);
                    wrapper.appendChild(dropdown);

                    var highlightedIndex = -1;
                    var currentItems = [];

                    function escapeHtml(s) {
                        return String(s).replace(/[&<>"']/g, function (c) {
                            return {
                                "&": "&amp;",
                                "<": "&lt;",
                                ">": "&gt;",
                                '"': "&quot;",
                                "'": "&#39;",
                            }[c];
                        });
                    }

                    var MAP_PIN_SVG =
                        '<span class="rh-province-icon">' +
                        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" ' +
                        'fill="none" stroke="currentColor" stroke-width="2" ' +
                        'stroke-linecap="round" stroke-linejoin="round">' +
                        '<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>' +
                        '<circle cx="12" cy="10" r="3"/></svg></span>';

                    function open() {
                        dropdown.classList.add("is-open");
                        /* while one of our dropdowns is open, hide
                                                           Google's .pac-container so the two never
                                                           overlap (cont-37 rule) */
                        document.body.classList.add("rh-province-active");
                        /* STACKING LIFT (cont-44 cure) */
                        wrapper.classList.add("rh-dd-host");
                        if (group) group.classList.add("rh-dd-host-group");
                    }

                    function close() {
                        dropdown.classList.remove("is-open");
                        wrapper.classList.remove("rh-dd-host");
                        if (group) group.classList.remove("rh-dd-host-group");
                        highlightedIndex = -1;
                        /* cont-48: TWO dropdowns share
                                                           body.rh-province-active — drop it only when
                                                           neither list is open any more. Switching
                                                           boxes re-opens the new list before the old
                                                           one's blur-close fires, so an unconditional
                                                           remove would expose Google's pac-container
                                                           while the second list is still open. */
                        if (!document.querySelector(".rh-province-dropdown.is-open")) {
                            document.body.classList.remove("rh-province-active");
                        }
                    }

                    function updateHighlight() {
                        var items = listEl.querySelectorAll(".rh-province-item");
                        items.forEach(function (el, i) {
                            el.classList.toggle("is-highlighted", i === highlightedIndex);
                        });
                        if (highlightedIndex >= 0 && items[highlightedIndex]) {
                            items[highlightedIndex].scrollIntoView({ block: "nearest" });
                        }
                    }

                    function render(matches) {
                        currentItems = matches;
                        highlightedIndex = -1;
                        listEl.innerHTML = "";

                        if (matches.length === 0) {
                            close();
                            return;
                        }

                        matches.forEach(function (item) {
                            var el = document.createElement("div");
                            el.className = "rh-province-item";
                            el.setAttribute("role", "option");
                            el.setAttribute("tabindex", "-1");

                            var nameHtml = escapeHtml(item.name);
                            if (item.sub) {
                                nameHtml +=
                                    '<span class="rh-province-sub"> — ' +
                                    escapeHtml(item.sub) +
                                    "</span>";
                            }

                            el.innerHTML =
                                MAP_PIN_SVG +
                                '<span class="rh-province-name">' +
                                nameHtml +
                                "</span>" +
                                '<span class="rh-province-tag">' +
                                escapeHtml(opts.tag) +
                                "</span>";

                            /* mousedown (not click) so the input hasn't
                                                               lost focus yet when we fill it — prevents
                                                               the blur handler from racing the pick. */
                            el.addEventListener("mousedown", function (e) {
                                e.preventDefault();
                                opts.applyPick(item);
                                /* cont-45: programmatic value changes fire
                                                                   no events — dispatch `input` so the
                                                                   hidden location composer + the live
                                                                   listing preview stay in sync. (The
                                                                   factory's own input listener re-renders
                                                                   + re-opens; close() below runs last, so
                                                                   the dropdown still ends closed.) */
                                input.dispatchEvent(new Event("input", { bubbles: true }));
                                close();
                            });

                            listEl.appendChild(el);
                        });

                        open();
                    }

                    /* cont-46/47: touch-to-open — the full list on
                                                       focus, no typing needed. */
                    function showAll() {
                        render(opts.allMatches());
                    }

                    input.addEventListener("input", function () {
                        var q = this.value.trim().toLowerCase();
                        if (q.length < 1) {
                            /* clearing the text while the box is still
                                                               focused (backspace to empty) re-shows the
                                                               full list instead of closing */
                            if (document.activeElement === input) {
                                showAll();
                            } else {
                                close();
                            }
                            return;
                        }
                        render(opts.findMatches(q));
                    });

                    /* focus = touching/clicking/tabbing into the box —
                                                       ALWAYS refresh to the full list. No is-open guard:
                                                       when switching boxes the old dropdown can still
                                                       be "open" (its blur-close is pending) and a
                                                       guarded focus would show a STALE list (cont-46). */
                    input.addEventListener("focus", function () {
                        showAll();
                    });

                    /* Second click/tap on an ALREADY-focused input fires
                                                       no focus event — mousedown reopens the full list
                                                       in that case. When the list is already open this
                                                       is a no-op (keeps any typed filter). focus() runs
                                                       first when the input somehow isn't focused yet:
                                                       opening must always leave the field focused,
                                                       otherwise no blur ever fires on it and the
                                                       guarded blur-close below could never close the
                                                       list. */
                    input.addEventListener("mousedown", function () {
                        if (document.activeElement !== input) input.focus();
                        if (!dropdown.classList.contains("is-open")) showAll();
                    });

                    input.addEventListener("keydown", function (e) {
                        if (e.key === "Escape") {
                            close();
                            return;
                        }
                        if (!dropdown.classList.contains("is-open")) return;

                        if (e.key === "ArrowDown") {
                            e.preventDefault();
                            highlightedIndex = Math.min(
                                highlightedIndex + 1,
                                currentItems.length - 1,
                            );
                            updateHighlight();
                        } else if (e.key === "ArrowUp") {
                            e.preventDefault();
                            highlightedIndex = Math.max(highlightedIndex - 1, 0);
                            updateHighlight();
                        } else if (e.key === "Enter" && highlightedIndex >= 0) {
                            e.preventDefault();
                            opts.applyPick(currentItems[highlightedIndex]);
                            /* cont-45: same sync as the mousedown pick */
                            input.dispatchEvent(new Event("input", { bubbles: true }));
                            close();
                        }
                    });

                    input.addEventListener("blur", function () {
                        /* cont-46: only close if focus did NOT come back
                                                           within the grace period — switching boxes
                                                           within 150ms must not close the freshly
                                                           opened list. */
                        window.setTimeout(function () {
                            if (document.activeElement !== input) close();
                        }, 150);
                    });

                    document.addEventListener("click", function (e) {
                        /* ignore clicks on the field's own label —
                                                           clicking it focuses the input (which opens
                                                           the list) and must not instantly close it
                                                           again via this outside-click closer. */
                        var labelGroup = input.closest(".input-group");
                        var label = labelGroup ? labelGroup.querySelector("label") : null;
                        if (
                            !dropdown.contains(e.target) &&
                            e.target !== input &&
                            !(label && label.contains(e.target))
                        ) {
                            close();
                        }
                    });
                }

                /* =====================================================
                                                   INSTANCE 1 — PROVINCE dropdown on the UPPER box
                                                   Picking a province pans/drops the Leaflet pin via
                                                   the same window.rhStep2PlaceSelected() bridge the
                                                   Google Places script uses (cont-37 behaviour kept).
                                                ===================================================== */
                createRhPicker({
                    input: provInput,
                    headerLabel: "Provinces",
                    tag: "Province",
                    findMatches: function (q) {
                        return PROVINCES.filter(function (p) {
                            return p.name.toLowerCase().indexOf(q) !== -1;
                        })
                            .slice(0, 7)
                            .map(function (p) {
                                return { name: p.name, lat: p.lat, lng: p.lng };
                            });
                    },
                    /* touch-to-open shows ALL 83 provinces, scrollable */
                    allMatches: function () {
                        return PROVINCES.slice();
                    },
                    applyPick: function (item) {
                        /* cont-44 CRITICAL: `var` — this handler is
                                                           defined OUTSIDE createRhPicker and cannot see
                                                           the factory's locals; a bare assignment throws
                                                           a silent strict-mode ReferenceError on EVERY
                                                           pick (the suggestion visibly does nothing). */
                        var input = document.getElementById("province");
                        if (input) input.value = item.name;

                        if (typeof window.rhStep2PlaceSelected === "function") {
                            window.rhStep2PlaceSelected(item.lat, item.lng);
                        }
                    },
                });

                /* =====================================================
                                                   CITY POOL — narrows to the selected province's
                                                   cities when #province holds a known province name,
                                                   else all cities (same rule as Step 1's rhCityPool).
                                                ===================================================== */
                function rhCityPool() {
                    var provVal = provInput.value.trim().toLowerCase();
                    var pool = CITIES;

                    if (provVal !== "") {
                        var inProv = CITIES.filter(function (c) {
                            return c.province.toLowerCase() === provVal;
                        });
                        /* only narrow when the province value actually
                                                           matches a known province — free-typed text
                                                           that matches nothing keeps the full list */
                        if (inProv.length > 0) pool = inProv;
                    }

                    return pool;
                }

                /* =====================================================
                                                   INSTANCE 2 — CITY dropdown on the LOWER box
                                                   Typing narrows to the top 7; touch-to-open shows the
                                                   FULL pool (the province's cities when one is picked,
                                                   else all of them).
                                                ===================================================== */
                createRhPicker({
                    input: cityInput,
                    headerLabel: "Cities",
                    tag: "City",
                    findMatches: function (q) {
                        return rhCityPool()
                            .filter(function (c) {
                                return c.name.toLowerCase().indexOf(q) !== -1;
                            })
                            .slice(0, 7)
                            .map(function (c) {
                                return { name: c.name, sub: c.province };
                            });
                    },
                    allMatches: function () {
                        return rhCityPool().map(function (c) {
                            return { name: c.name, sub: c.province };
                        });
                    },
                    applyPick: function (item) {
                        var input = document.getElementById("city");
                        if (input) input.value = item.name;
                    },
                });

                /* =====================================================
                                                   HIDDEN location COMPOSER (cont-48 — Step 1's cont-45
                                                   pattern). The visible form posts `province` + `city`,
                                                   but the controller still validates/saves the legacy
                                                   single `location` key. This keeps #rhLocationField
                                                   composed as "City, Province" on every keystroke AND
                                                   at submit time, so the controller's location check
                                                   keeps passing with NO controller change. Controllers
                                                   reading province + city directly simply ignore it.
                                                ===================================================== */
                var locationField = document.getElementById("rhLocationField");

                function syncLocationField() {
                    if (!locationField) return;

                    var parts = [];
                    if (cityInput && cityInput.value.trim() !== "") {
                        parts.push(cityInput.value.trim());
                    }
                    if (provInput && provInput.value.trim() !== "") {
                        parts.push(provInput.value.trim());
                    }
                    locationField.value = parts.join(", ");
                }

                if (provInput) provInput.addEventListener("input", syncLocationField);
                if (cityInput) cityInput.addEventListener("input", syncLocationField);

                /* belt and suspenders: re-compose right before the
                                                   POST even if some path changed a value without an
                                                   input event */
                var rhForm = document.getElementById("hostStep2Form");
                if (rhForm) rhForm.addEventListener("submit", syncLocationField);
            })();
        </script>


    </body>

