        {{ include('partials/footer.html.twig') }}

        <!-- =========================================================
         SCRIPTS
    ========================================================== -->

        <!-- Lucide icons — guarded loader (same key as navbar: never
         double-runs). hs2RefreshIcons is kept as a thin alias so
         any page reference keeps working. -->
        <script>
            (function () {
                "use strict";

                function renderRhIcons() {
                    if (window.lucide && typeof window.lucide.createIcons === "function") {
                        window.lucide.createIcons();
                    }
                }

                /* legacy alias — the page previously defined
                                                   hs2RefreshIcons(); keep the same contract */
                window.hs2RefreshIcons = renderRhIcons;

                if (!window.__rhNavbarLucide) {
                    window.__rhNavbarLucide = true;
                    var s = document.createElement("script");
                    s.src = "https://unpkg.com/lucide@0.469.0/dist/umd/lucide.min.js";
                    s.addEventListener("load", renderRhIcons);
                    document.head.appendChild(s);
                }

                if (document.readyState === "loading") {
                    document.addEventListener("DOMContentLoaded", renderRhIcons);
                } else {
                    renderRhIcons();
                }
                window.addEventListener("load", renderRhIcons);
            })();
        </script>

        <!-- Leaflet (free map) -->
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

        <script>
        (function() {
            "use strict";

            /* =========================================================
               PHP STATE — failed-POST restore + label maps.
               Flags 15 = JSON_HEX_TAG|JSON_HEX_AMP|JSON_HEX_APOS|
               JSON_HEX_QUOT (the legacy $rh2JsonFlags) + |raw —
               under autoescape:on the structural quotes would
               otherwise become &quot; and kill every script on
               the page; the HEX flags make the closing-script
               sequence breakout impossible either way.
               (NOTE: do NOT write the literal closing-tag sequence
                inside a script body — the HTML parser closes the
                script tag on sight, even inside JS comments.)
            ========================================================= */
            var RH2 = {
                initial: {{ rh2_initial|default({'lat': null, 'lng': null})|json_encode(15)|raw }},
                categories: {{ listing_categories|json_encode(15)|raw }},
                propertyTypes: {{ property_types|json_encode(15)|raw }}
            };

            /* =========================================================
               LIVE LISTING PREVIEW
            ========================================================= */
            var titleInput = document.getElementById('title');
            var provinceIn = document.getElementById('province');
            var cityIn = document.getElementById('city');
            var categorySel = document.getElementById('category');
            var propTypeSel = document.getElementById('property_type');
            var priceInput = document.getElementById('price');

            var previewTitle = document.getElementById('previewTitle');
            var previewMeta = document.getElementById('previewMeta');
            var previewTags = document.getElementById('previewTags');
            var previewPrice = document.getElementById('previewPrice');

            function labelByValue(map, value) {
                if (!value) return '';
                var keys = Object.keys(map);
                for (var i = 0; i < keys.length; i++) {
                    if (map[keys[i]] === value) return keys[i];
                }
                return '';
            }

            function syncPreviewMeta() {
                if (!previewMeta) return;

                /* cont-48: two-box location — preview shows
                   "City, Province" composed from both boxes */
                var locParts = [];
                if (cityIn && cityIn.value.trim() !== '') {
                    locParts.push(cityIn.value.trim());
                }
                if (provinceIn && provinceIn.value.trim() !== '') {
                    locParts.push(provinceIn.value.trim());
                }
                var loc = locParts.length > 0 ?
                    locParts.join(', ') :
                    'Location appears here';

                var cat = labelByValue(RH2.categories, categorySel && categorySel.value);
                var pt = labelByValue(RH2.propertyTypes, propTypeSel && propTypeSel.value);

                var bits = [loc];
                if (cat) bits.push(cat);
                if (pt) bits.push(pt);

                previewMeta.textContent = bits.join(' · ');
            }

            function syncPreviewTags() {
                if (!previewTags) return;

                previewTags.innerHTML = '';

                var boxes = document.querySelectorAll('.amenity-checkbox input[type="checkbox"]:checked');

                Array.prototype.forEach.call(boxes, function(box) {
                    var tag = document.createElement('span');
                    tag.className = 'listing-preview-tag';
                    tag.textContent = box.getAttribute('data-label') || box.value;
                    previewTags.appendChild(tag);
                });
            }

            function syncPreviewPrice() {
                if (!previewPrice || !priceInput) return;

                var v = parseFloat(priceInput.value);
                previewPrice.textContent = (v > 0) ?
                    '₱ ' + v.toLocaleString('en-US', {
                        maximumFractionDigits: 2
                    }) :
                    '₱ 0';
            }

            if (titleInput && previewTitle) {
                titleInput.addEventListener('input', function() {
                    previewTitle.textContent = titleInput.value.trim() !== '' ?
                        titleInput.value.trim() :
                        'Your space title';
                });
            }

            [provinceIn, cityIn, categorySel, propTypeSel].forEach(function(el) {
                if (el) el.addEventListener('change', syncPreviewMeta);
            });
            if (provinceIn) provinceIn.addEventListener('input', syncPreviewMeta);
            if (cityIn) cityIn.addEventListener('input', syncPreviewMeta);

            Array.prototype.forEach.call(
                document.querySelectorAll('.amenity-checkbox input[type="checkbox"]'),
                function(box) {
                    box.addEventListener('change', syncPreviewTags);
                }
            );

            if (priceInput) priceInput.addEventListener('input', syncPreviewPrice);

            /* initial sync (covers restored POST values) */
            syncPreviewMeta();
            syncPreviewTags();
            syncPreviewPrice();

            /* =========================================================
               STICKY PREVIEW — .is-pinned at top:90px once scrolled.
               Fixed positioning drops width, so it's applied inline.
            ========================================================= */
            var previewCard = document.getElementById('listingPreview');
            var previewRail = document.querySelector('.listing-preview-rail');

            if (previewCard && previewRail && window.innerWidth > 900) {

                var railTop = previewRail.getBoundingClientRect().top + window.scrollY;
                var cardWidth = previewCard.offsetWidth;

                var onPreviewScroll = function() {
                    var pinned = window.scrollY > (railTop - 100);

                    previewCard.classList.toggle('is-pinned', pinned);
                    previewCard.style.width = pinned ? cardWidth + 'px' : '';
                };

                window.addEventListener('scroll', onPreviewScroll, {
                    passive: true
                });

                window.addEventListener('resize', function() {
                    if (!previewCard.classList.contains('is-pinned')) {
                        cardWidth = previewCard.offsetWidth;
                        railTop = previewRail.getBoundingClientRect().top + window.scrollY;
                    }
                });
            }

            /* =========================================================
               MAP PIN — Leaflet + OpenStreetMap
               Click to pin, drag to adjust, "use my location",
               reverse-geocode the address preview (Nominatim).
            ========================================================= */
            var mapEl = document.getElementById('locationMap');

            if (mapEl && typeof L !== 'undefined') {

                var map = L.map('locationMap').setView([9.3068, 123.3049], 12);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap contributors'
                }).addTo(map);

                var pinStatus = document.getElementById('pinStatus');
                var latInput = document.getElementById('latitudeInput');
                var lngInput = document.getElementById('longitudeInput');
                var addrPrev = document.getElementById('pinAddressPreview');
                var locateBtn = document.getElementById('mapLocateBtn');

                var marker = null;
                var geocodeTimer = null;

                function pinIcon() {
                    return L.divIcon({
                        className: 'rh-pin-icon',
                        html: '<div class="rh-pin">📍</div>',
                        iconSize: [30, 30],
                        iconAnchor: [15, 30]
                    });
                }

                function setPin(lat, lng, fromGps) {
                    if (marker) {
                        marker.setLatLng([lat, lng]);
                    } else {
                        marker = L.marker([lat, lng], {
                            icon: pinIcon(),
                            draggable: true
                        }).addTo(map);

                        marker.on('dragend', function() {
                            var p = marker.getLatLng();
                            commitPin(p.lat, p.lng, false);
                        });
                    }

                    commitPin(lat, lng, fromGps);
                }

                function commitPin(lat, lng, fromGps) {
                    if (latInput) latInput.value = lat.toFixed(6);
                    if (lngInput) lngInput.value = lng.toFixed(6);

                    if (pinStatus) {
                        pinStatus.classList.add('has-pin');
                        pinStatus.textContent = 'Pin set' +
                            (fromGps ? ' (your location)' : '') +
                            ' — drag or click to adjust';
                    }

                    if (addrPrev) {
                        addrPrev.hidden = false;
                        addrPrev.textContent = 'Looking up address…';
                    }

                    if (geocodeTimer) window.clearTimeout(geocodeTimer);
                    geocodeTimer = window.setTimeout(function() {
                        reverseGeocode(lat, lng);
                    }, 500);
                }

                function reverseGeocode(lat, lng) {
                    fetch('https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=' + lat + '&lon=' + lng)
                        .then(function(res) {
                            return res.json();
                        })
                        .then(function(data) {
                            if (addrPrev) {
                                addrPrev.textContent = data && data.display_name ?
                                    data.display_name :
                                    'Pin set at ' + lat.toFixed(5) + ', ' + lng.toFixed(5);
                            }
                        })
                        .catch(function() {
                            if (addrPrev) {
                                addrPrev.textContent = 'Pin set at ' + lat.toFixed(5) + ', ' + lng.toFixed(5);
                            }
                        });
                }

                map.on('click', function(e) {
                    setPin(e.latlng.lat, e.latlng.lng, false);
                });

                if (RH2.initial.lat !== null && RH2.initial.lng !== null) {
                    setPin(RH2.initial.lat, RH2.initial.lng, false);
                    map.setView([RH2.initial.lat, RH2.initial.lng], 16);
                }

                if (locateBtn) {
                    locateBtn.addEventListener('click', function() {

                        if (!navigator.geolocation) {
                            if (pinStatus) pinStatus.textContent = 'Geolocation not supported — click the map instead';
                            return;
                        }

                        locateBtn.disabled = true;
                        if (pinStatus) {
                            pinStatus.classList.remove('has-pin');
                            pinStatus.textContent = 'Finding your location…';
                        }

                        navigator.geolocation.getCurrentPosition(
                            function(pos) {
                                locateBtn.disabled = false;

                                var lat = pos.coords.latitude;
                                var lng = pos.coords.longitude;

                                map.setView([lat, lng], 16);
                                setPin(lat, lng, true);
                            },
                            function() {
                                locateBtn.disabled = false;
                                if (pinStatus) {
                                    pinStatus.textContent = 'Could not get your location — click the map instead';
                                }
                            }, {
                                enableHighAccuracy: true,
                                timeout: 10000
                            }
                        );
                    });
                }

                /* =========================================================
                   PLACES AUTOCOMPLETE BRIDGE (cont-36)
                   Exposes a single callback on window so the Google
                   Places Autocomplete script (loaded separately,
                   below) can drive the Leaflet pin without breaking
                   this IIFE's scope. The bridge closes over `map`
                   and `setPin`, both of which are guaranteed to be
                   defined when the bridge fires (the outer if-block
                   has already executed). Places loader checks
                   `typeof window.rhStep2PlaceSelected` before
                   calling — graceful no-op if the map block never
                   ran (e.g. Leaflet CDN failed to load).
                ========================================================= */
                window.rhStep2PlaceSelected = function(lat, lng) {
                    if (!map || typeof setPin !== 'function') return;
                    map.setView([lat, lng], 16);
                    setPin(lat, lng, false);
                };

                /* reveal animation can size the container late */
                window.setTimeout(function() {
                    map.invalidateSize();
                }, 250);
            }
        })();
    </script>

        {# =========================================================
       GOOGLE PLACES AUTOCOMPLETE (cont-36)
       Loads the Maps JS API + Places library only when:
         (1) an API key was passed from the controller, AND
         (2) the #location input actually exists on the page.
       Graceful degradation: no key OR no input → script exits
       early, location field stays a plain text input.

       On place_changed:
         - fills #location with formatted_address (falls back to
           place.name for POIs without a street address)
         - calls window.rhStep2PlaceSelected(lat, lng) — the
           bridge above — which drops the Leaflet marker at the
           chosen place and writes the hidden lat/lng inputs.

       Philippines-only via componentRestrictions country: 'ph'.
       types: ['geocode', 'establishment'] lets the dropdown
       return both addresses (city/province/street) AND named
       POIs (airport, market, mall) — matches the user's
       "Dumaguete City / Dumaguete Airport / Dumaguete Public
       Market" examples.

       Cost note: Autocomplete is billed per session (a session
       = one user typing until they pick a result). Free tier
       gives $200/mo credit ≈ 10k sessions. Set a daily quota
       cap in Google Cloud Console to prevent runaway bills.
    ========================================================= #}
        <script>
            (function () {
                "use strict";

                var API_KEY = "{{ google_maps_api_key|default('') }}";
                /* cont-48: Places now targets the CITY box — typing
                                                   "Dumaguete" still returns city / airport / market
                                                   matches, and the picked value lands in the lower
                                                   box (the hidden location composer syncs from it). */
                var locInput = document.getElementById("city");

                if (!API_KEY || !locInput) {
                    /* no key, or no input on this page — leave the
                                                       field as a plain text input (legacy behaviour) */
                    return;
                }

                if (window.__rhGoogleMapsLoaded) return;
                window.__rhGoogleMapsLoaded = true;

                /* The Maps API needs a global callback to invoke when
                                                   it finishes loading. We define it BEFORE injecting
                                                   the <script> tag so the callback always exists when
                                                   the API calls it (race-free). */
                window.initRhPlacesAutocomplete = function () {
                    if (!window.google || !google.maps || !google.maps.places) {
                        return;
                    }
                    if (!locInput) return;

                    try {
                        var autocomplete = new google.maps.places.Autocomplete(locInput, {
                            types: ["geocode", "establishment"],
                            componentRestrictions: { country: "ph" },
                            fields: ["formatted_address", "geometry", "name"],
                        });

                        autocomplete.addListener("place_changed", function () {
                            var place = autocomplete.getPlace();
                            if (!place || !place.geometry) return;

                            var lat = place.geometry.location.lat();
                            var lng = place.geometry.location.lng();

                            /* Fill the visible #city input with the
                                                               formatted_address Google returns; for POIs
                                                               that have no formatted_address (some
                                                               airports/markets), fall back to place.name.
                                                               cont-45 lesson: programmatic value changes
                                                               fire no events — dispatch `input` so the
                                                               hidden location composer + the live
                                                               listing preview stay in sync. */
                            if (place.formatted_address) {
                                locInput.value = place.formatted_address;
                            } else if (place.name) {
                                locInput.value = place.name;
                            }
                            locInput.dispatchEvent(new Event("input", { bubbles: true }));

                            /* Drive the Leaflet map + hidden lat/lng via
                                                               the bridge the main IIFE exposed. */
                            if (typeof window.rhStep2PlaceSelected === "function") {
                                window.rhStep2PlaceSelected(lat, lng);
                            }
                        });
                    } catch (err) {
                        /* API key invalid, billing disabled, or similar —
                                                           fail silently so the rest of the page still
                                                           works. Check browser console for the actual
                                                           Google error message. */
                        if (window.console && console.warn) {
                            console.warn("Places Autocomplete init failed:", err);
                        }
                    }
                };

                /* Inject the Maps JS script with `callback=` so it
                                                   calls our initRhPlacesAutocomplete once loaded.
                                                   async+defer so it doesn't block the page render. */
                var s = document.createElement("script");
                s.src =
                    "https://maps.googleapis.com/maps/api/js?key=" +
                    encodeURIComponent(API_KEY) +
                    "&libraries=places&callback=initRhPlacesAutocomplete";
                s.async = true;
                s.defer = true;
                document.head.appendChild(s);
            })();
        </script>

