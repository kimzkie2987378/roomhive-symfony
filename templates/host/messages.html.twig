{# roomhive/host/messages.html.twig
   Host › Messages — 1:1 port of legacy host/hostmessages.php
   (SUPPORT CHAT VISIBILITY edition).

   Two-pane chat: conversation list (left) + thread (right).
   Conversations include BOTH normal tenant chats (host_id = me)
   AND support chats (user_id = me, partner = the system
   RoomHive Admin account). Support chats render with a
   RoomHive Admin · SUPPORT header and no listing tag.

   SUPPORT CHAT VISIBILITY (S1–S4):
     • S1 — list shows chats where the host is the user_id
       (support chats), not just host_id = me.
     • S2 — support chats render with a SUPPORT pill + "Official
       support · we usually reply within 24 hours" subtitle.
     • S3 — send handler accepts either side; replies inside a
       support chat skip notifying the support account (the
       admin panel's unread badge picks them up).
     • S4 — navbar bell counts unread across BOTH roles.

   SEND (POST, PRG): CSRF-verified (hp_csrf hidden field).
   Body trimmed non-empty. Ownership check accepts either side.
   On success: INSERT message + UPDATE last_message_at + notify
   the other party (unless it's the support account), then PRG
   back to ?c={convId}.

   ICON SUBSTITUTIONS — the macros file uses the older lucide.dev
   names the rest of the shell standardized on:
     legacy `message-circle` → macro 'message'      (rounded
                                 chat bubble — keeps empty-state
                                 art distinct from the sidebar's
                                 'message-square' icon)
     legacy `search`         → macro 'search'        (exists)
     legacy `info`           → macro 'circle-help'    (closest
                                 affordance for "View listing";
                                 'info' isn't in the macro table)
     legacy `chevron-left`   → macro 'chevron-left'  (exists)
     legacy `send`           → macro 'arrow-up'      (closest
                                 send affordance; CSS keeps it
                                 SOLID via fill: currentColor)

   Pairs with: HostMessagesController
     GET|POST /host/messages   name app_host_messages
#}
{% extends 'host/base.html.twig' %}
{% import 'admin/_macros.html.twig' as ui %}

{% set active_nav = 'messages' %}

{% block page_title %}Messages — RoomHive{% endblock %}

{% block styles %}
<style>
    /* ---- Page header (same values as the other host pages) ---- */
    .hp-page-header {
        display: flex; align-items: center; justify-content: space-between;
        gap: 16px; flex-wrap: wrap;
    }
    .hp-page-title { margin: 0; font-size: 24px; font-weight: 800; color: var(--rh-ink); }
    .hp-page-subtitle { margin: 4px 0 0; font-size: 13px; color: var(--rh-muted); max-width: 680px; }

    /* ---- Flash messages ---- */
    .hp-flash {
        margin: 0 0 14px; padding: 12px 14px; border-radius: 10px;
        font-size: 13px; font-weight: 600;
    }
    .hp-flash-success { background: #E7F7EC; color: #1E7A3D; border: 1px solid #BFE8CF; }
    .hp-flash-error   { background: #FCEAEA; color: #C4302F; border: 1px solid #F3B9B9; }

    /* ---- S2 — support badge (host side) ---- */
    .hp-support-tag {
        display: inline-block;
        font-size: .58rem;
        font-weight: 800;
        letter-spacing: .07em;
        color: #fff;
        background: linear-gradient(135deg, #f6b93b, #eda423);
        border-radius: 999px;
        padding: 2px 8px;
        margin-left: 6px;
        vertical-align: middle;
        white-space: nowrap;
    }

    /* =========================================================
       CHAT CARD — two-pane layout
    ========================================================= */
    .hp-msg-card {
        display: grid;
        grid-template-columns: minmax(260px, 320px) 1fr;
        background: #fff;
        border: 1px solid var(--rh-line);
        border-radius: var(--rh-radius);
        overflow: hidden;
        min-height: 560px;
        max-height: calc(100vh - 220px);
    }
    @media (max-width: 760px) {
        .hp-msg-card { grid-template-columns: 1fr; }
        /* Mobile: list and thread stack; .hp-msg-mobile-open
           hides the list so the thread takes the full card. */
        .hp-msg-mobile-open .hp-msg-list-pane { display: none; }
        .hp-msg-card:not(.hp-msg-mobile-open) .hp-msg-thread { display: none; }
    }

    /* ---- List pane ---- */
    .hp-msg-list-pane {
        display: flex; flex-direction: column;
        border-right: 1px solid var(--rh-line);
        min-height: 0;
    }
    .hp-msg-list-header {
        padding: 14px 16px 10px;
        border-bottom: 1px solid var(--rh-line);
    }
    .hp-msg-list-header h2 {
        margin: 0; font-size: 15px; font-weight: 700; color: var(--rh-ink);
    }

    .hp-msg-search-wrap {
        display: flex; align-items: center; gap: 8px;
        margin: 10px 12px;
        padding: 6px 10px;
        background: #F6F7FB; border: 1px solid var(--rh-line);
        border-radius: 8px;
    }
    .hp-msg-search-wrap svg { width: 16px; height: 16px; color: var(--rh-muted); flex-shrink: 0; }
    .hp-msg-search {
        flex: 1; min-width: 0; border: none; outline: none; background: transparent;
        font-family: inherit; font-size: 13px; color: var(--rh-ink);
    }
    .hp-msg-search::placeholder { color: var(--rh-muted); }

    .hp-msg-tabs {
        display: flex; gap: 4px;
        padding: 0 12px 8px;
    }
    .hp-msg-tab {
        padding: 5px 10px; font-size: 12px; font-weight: 600;
        color: var(--rh-muted); background: transparent;
        border: 1px solid transparent; border-radius: 7px;
        cursor: pointer; font-family: inherit;
        transition: background .15s ease, color .15s ease;
    }
    .hp-msg-tab:hover { background: #F6F7FB; color: var(--rh-ink); }
    .hp-msg-tab.active {
        background: var(--rh-accent-light); color: #b07708;
        border-color: rgba(237, 164, 35, .35);
    }

    .hp-msg-list {
        flex: 1; overflow-y: auto; padding: 4px 6px 8px;
    }
    .hp-msg-list-item {
        display: flex; align-items: flex-start; gap: 10px;
        padding: 10px 10px; border-radius: 10px;
        text-decoration: none; color: inherit;
        transition: background .15s ease;
    }
    .hp-msg-list-item:hover { background: #F6F7FB; }
    .hp-msg-list-item.active { background: var(--rh-accent-light); }
    .hp-msg-list-item.unread .hp-msg-name { font-weight: 800; }
    .hp-msg-list-item.unread .hp-msg-preview { color: var(--rh-ink); font-weight: 600; }
    .hp-msg-list-item.js-hidden { display: none; }

    .hp-msg-avatar {
        width: 38px; height: 38px; border-radius: 50%;
        overflow: hidden; flex-shrink: 0; background: #F0F1F6;
    }
    .hp-msg-avatar img { width: 100%; height: 100%; object-fit: cover; }

    .hp-msg-item-body {
        flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px;
    }
    .hp-msg-item-top {
        display: flex; align-items: center; justify-content: space-between; gap: 8px;
    }
    .hp-msg-name {
        font-size: 13.5px; font-weight: 600; color: var(--rh-ink);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        flex: 1; min-width: 0;
    }
    .hp-msg-badge {
        background: #e14b4b; color: #fff; font-size: 11px; font-weight: 700;
        padding: 2px 7px; border-radius: 999px; line-height: 1; flex-shrink: 0;
    }
    .hp-msg-listing-tag {
        font-size: 11px; color: var(--rh-muted); font-weight: 600;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .hp-msg-preview {
        font-size: 12.5px; color: var(--rh-muted);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    /* ---- Thread pane ---- */
    .hp-msg-thread {
        display: flex; flex-direction: column;
        min-height: 0;
        background: #FAFBFD;
    }
    .hp-msg-thread-header {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 16px; background: #fff;
        border-bottom: 1px solid var(--rh-line);
    }
    .hp-msg-back {
        display: inline-flex; align-items: center; justify-content: center;
        width: 32px; height: 32px; border-radius: 8px;
        color: var(--rh-muted); text-decoration: none;
        transition: background .15s ease, color .15s ease;
    }
    .hp-msg-back:hover { background: #F6F7FB; color: var(--rh-ink); }
    .hp-msg-back svg { width: 18px; height: 18px; }
    .hp-msg-thread-avatar {
        width: 36px; height: 36px; border-radius: 50%;
        object-fit: cover; flex-shrink: 0; background: #F0F1F6;
    }
    .hp-msg-thread-info { flex: 1; min-width: 0; }
    .hp-msg-thread-name {
        font-size: 14px; font-weight: 700; color: var(--rh-ink);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .hp-msg-thread-listing {
        margin: 2px 0 0; font-size: 12px; color: var(--rh-muted); font-weight: 600;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .hp-msg-thread-actions { display: flex; gap: 4px; }
    .hp-msg-icon-btn {
        display: inline-flex; align-items: center; justify-content: center;
        width: 32px; height: 32px; border-radius: 8px;
        color: var(--rh-muted); text-decoration: none;
        transition: background .15s ease, color .15s ease;
    }
    .hp-msg-icon-btn:hover { background: #F6F7FB; color: var(--rh-ink); }
    .hp-msg-icon-btn svg { width: 17px; height: 17px; }

    .hp-msg-thread-body {
        flex: 1; overflow-y: auto; padding: 16px;
        display: flex; flex-direction: column; gap: 4px;
    }
    .hp-msg-day-divider {
        align-self: center;
        margin: 12px 0 8px;
        padding: 3px 12px;
        font-size: 11px; font-weight: 700; color: var(--rh-muted);
        background: #EEF1F6; border-radius: 999px;
    }
    .hp-msg-row { display: flex; margin-bottom: 6px; }
    .hp-msg-row.mine { justify-content: flex-end; }
    .hp-msg-row.theirs { justify-content: flex-start; }
    .hp-msg-bubble-wrap {
        display: flex; flex-direction: column;
        max-width: 75%;
    }
    .hp-msg-row.mine .hp-msg-bubble-wrap { align-items: flex-end; }
    .hp-msg-bubble {
        padding: 9px 13px; border-radius: 14px;
        font-size: 13.5px; line-height: 1.45;
        word-wrap: break-word; overflow-wrap: anywhere;
    }
    .hp-msg-row.mine .hp-msg-bubble {
        background: linear-gradient(135deg, #f6b93b, #eda423);
        color: #1c2a38;
        border-bottom-right-radius: 4px;
    }
    .hp-msg-row.theirs .hp-msg-bubble {
        background: #fff; color: var(--rh-ink);
        border: 1px solid var(--rh-line);
        border-bottom-left-radius: 4px;
    }
    .hp-msg-time {
        font-size: 10.5px; color: var(--rh-muted);
        margin-top: 3px; padding: 0 4px;
    }

    /* ---- Welcome / empty state ---- */
    .hp-msg-welcome {
        flex: 1; display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        padding: 40px 20px; text-align: center; gap: 6px;
    }
    .hp-msg-welcome-icon {
        display: inline-flex;
        color: var(--rh-muted); margin-bottom: 6px;
    }
    .hp-msg-welcome-icon svg { width: 30px; height: 30px; }
    .hp-msg-welcome h3 {
        margin: 0; font-size: 16px; font-weight: 700; color: var(--rh-ink);
    }
    .hp-msg-welcome p {
        margin: 0; font-size: 13px; color: var(--rh-muted); max-width: 320px;
    }

    .hp-msg-card-empty {
        background: #fff; border: 1px solid var(--rh-line);
        border-radius: var(--rh-radius); overflow: hidden;
    }
    .hp-msg-card-empty .hp-msg-list-header {
        padding: 14px 16px; border-bottom: 1px solid var(--rh-line);
    }

    /* ---- Composer ---- */
    .hp-msg-composer {
        display: flex; align-items: center; gap: 8px;
        padding: 12px 16px; background: #fff;
        border-top: 1px solid var(--rh-line);
    }
    .hp-msg-input {
        flex: 1; min-width: 0;
        padding: 10px 14px; border-radius: 999px;
        border: 1px solid #dfe4ea; background: #fff;
        font-family: inherit; font-size: 13.5px; color: var(--rh-ink);
        outline: none;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .hp-msg-input:focus {
        border-color: var(--rh-accent);
        box-shadow: 0 0 0 3px rgba(237, 164, 35, 0.18);
    }
    .hp-msg-send-btn {
        display: inline-flex; align-items: center; justify-content: center;
        width: 40px; height: 40px; border-radius: 50%;
        border: none; cursor: pointer;
        background: linear-gradient(135deg, #f6b93b, #eda423);
        color: #1c2a38;
        box-shadow: 0 4px 12px rgba(237, 164, 35, 0.35);
        transition: transform .15s ease, box-shadow .15s ease;
        flex-shrink: 0;
    }
    .hp-msg-send-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(237, 164, 35, 0.45);
    }
    .hp-msg-send-btn svg {
        width: 18px; height: 18px;
        fill: currentColor;   /* keeps the macro's outline icon SOLID */
    }

    /* ---- Icon baseline ---- */
    svg.icon { display: inline-block; vertical-align: -0.18em; flex-shrink: 0; }

    /* ---- Dark mode ---- */
    body[data-theme="dark"] .hp-page-title { color: #e8ecf1; }
    body[data-theme="dark"] .hp-msg-card,
    body[data-theme="dark"] .hp-msg-card-empty { background: #141b24; border-color: #1a222b; }
    body[data-theme="dark"] .hp-msg-list-pane { border-right-color: #1a222b; }
    body[data-theme="dark"] .hp-msg-list-header { border-bottom-color: #1a222b; }
    body[data-theme="dark"] .hp-msg-list-header h2 { color: #e8ecf1; }
    body[data-theme="dark"] .hp-msg-search-wrap { background: #1a222b; border-color: #2a3540; }
    body[data-theme="dark"] .hp-msg-search { color: #e8ecf1; }
    body[data-theme="dark"] .hp-msg-search::placeholder { color: #5d6875; }
    body[data-theme="dark"] .hp-msg-tab { color: #8d99a5; }
    body[data-theme="dark"] .hp-msg-tab:hover { background: #1a222b; color: #e8ecf1; }
    body[data-theme="dark"] .hp-msg-tab.active { background: rgba(237, 164, 35, .15); color: #f6c04e; border-color: rgba(237, 164, 35, .35); }
    body[data-theme="dark"] .hp-msg-list-item:hover { background: #1a222b; }
    body[data-theme="dark"] .hp-msg-list-item.active { background: rgba(237, 164, 35, .15); }
    body[data-theme="dark"] .hp-msg-avatar { background: #1a222b; }
    body[data-theme="dark"] .hp-msg-name { color: #e8ecf1; }
    body[data-theme="dark"] .hp-msg-listing-tag { color: #8d99a5; }
    body[data-theme="dark"] .hp-msg-preview { color: #8d99a5; }
    body[data-theme="dark"] .hp-msg-thread { background: #0d1218; }
    body[data-theme="dark"] .hp-msg-thread-header { background: #141b24; border-bottom-color: #1a222b; }
    body[data-theme="dark"] .hp-msg-back { color: #8d99a5; }
    body[data-theme="dark"] .hp-msg-back:hover { background: #1a222b; color: #e8ecf1; }
    body[data-theme="dark"] .hp-msg-thread-avatar { background: #1a222b; }
    body[data-theme="dark"] .hp-msg-thread-name { color: #e8ecf1; }
    body[data-theme="dark"] .hp-msg-thread-listing { color: #8d99a5; }
    body[data-theme="dark"] .hp-msg-icon-btn { color: #8d99a5; }
    body[data-theme="dark"] .hp-msg-icon-btn:hover { background: #1a222b; color: #e8ecf1; }
    body[data-theme="dark"] .hp-msg-day-divider { background: #1a222b; color: #8d99a5; }
    body[data-theme="dark"] .hp-msg-row.theirs .hp-msg-bubble { background: #141b24; color: #e8ecf1; border-color: #1a222b; }
    body[data-theme="dark"] .hp-msg-time { color: #5d6875; }
    body[data-theme="dark"] .hp-msg-welcome h3 { color: #e8ecf1; }
    body[data-theme="dark"] .hp-msg-welcome p { color: #8d99a5; }
    body[data-theme="dark"] .hp-msg-composer { background: #141b24; border-top-color: #1a222b; }
    body[data-theme="dark"] .hp-msg-input { background: #0d1218; border-color: #2a3540; color: #e8ecf1; }
</style>
{% endblock %}

{% block content %}
<div class="hp-page-header">
    <div>
        <h1 class="hp-page-title">Messages</h1>
        <p class="hp-page-subtitle">Chat with tenants about their bookings.</p>
    </div>
</div>

{% if session_flash %}
    <div class="hp-flash {{ session_flash.type == 'success' ? 'hp-flash-success' : 'hp-flash-error' }}">
        {{ session_flash.message }}
    </div>
{% endif %}

{% if conversations is empty %}

    <section class="hp-msg-card-empty">
        <div class="hp-msg-list-header">
            <h2>Chats</h2>
        </div>
        <div class="hp-msg-welcome">
            <span class="hp-msg-welcome-icon">
                {{ ui.icon('message') }}
            </span>
            <h3>No conversations yet</h3>
            <p>When a tenant starts a chat on one of your listings, it will appear here.</p>
        </div>
    </section>

{% else %}

    <section class="hp-msg-card{{ is_explicit_thread ? ' hp-msg-mobile-open' : '' }}">

        {# ============ LIST PANE ============ #}
        <div class="hp-msg-list-pane">

            <div class="hp-msg-list-header">
                <h2>Chats</h2>
            </div>

            <div class="hp-msg-search-wrap">
                {{ ui.icon('search') }}
                <input type="text" id="hpMsgSearchInput" class="hp-msg-search" placeholder="Search messages" autocomplete="off">
            </div>

            <div class="hp-msg-tabs" id="hpMsgTabs">
                <button type="button" class="hp-msg-tab active" data-filter="all">All</button>
                <button type="button" class="hp-msg-tab" data-filter="unread">Unread</button>
            </div>

            <div class="hp-msg-list" id="hpMsgList">
                {% for c in conversations %}
                    {% set is_active = selected and c.id == selected.id %}
                    {% set is_unread = c.unread > 0 %}
                    <a href="{{ path('app_host_messages', {c: c.id}) }}"
                       class="hp-msg-list-item{{ is_active ? ' active' : '' }}{{ is_unread ? ' unread' : '' }}">
                        <span class="hp-msg-avatar">
                            <img src="{{ c.tenant_avatar }}" alt="{{ c.tenant_name }}">
                        </span>
                        <span class="hp-msg-item-body">
                            <span class="hp-msg-item-top">
                                <span class="hp-msg-name">
                                    {{ c.tenant_name }}{% if c.is_support %}<span class="hp-support-tag">SUPPORT</span>{% endif %}
                                </span>
                                {% if is_unread %}
                                    <span class="hp-msg-badge">{{ c.unread }}</span>
                                {% endif %}
                            </span>
                            {% if c.listing_title != '' %}
                                <span class="hp-msg-listing-tag">{{ c.listing_title }}</span>
                            {% endif %}
                            <span class="hp-msg-preview">{{ c.last_body != '' ? c.last_body : 'No messages yet' }}</span>
                        </span>
                    </a>
                {% endfor %}
            </div>

        </div>

        {# ============ THREAD PANE ============ #}
        <div class="hp-msg-thread">
            {% if selected %}

                <div class="hp-msg-thread-header">
                    <a href="{{ path('app_host_messages') }}" class="hp-msg-back" aria-label="Back to messages">
                        {{ ui.icon('chevron-left') }}
                    </a>
                    <img class="hp-msg-thread-avatar" src="{{ selected.tenant_avatar }}" alt="">

                    {% if selected.is_support %}

                        {# S2 — support thread header #}
                        <div class="hp-msg-thread-info">
                            <div class="hp-msg-thread-name">RoomHive Admin<span class="hp-support-tag">SUPPORT</span></div>
                            <p class="hp-msg-thread-listing">Official support &middot; we usually reply within 24 hours</p>
                        </div>

                    {% else %}

                        <div class="hp-msg-thread-info">
                            <div class="hp-msg-thread-name">{{ selected.tenant_name }}</div>
                            {% if selected.listing_title != '' %}
                                <p class="hp-msg-thread-listing">{{ selected.listing_title }}</p>
                            {% endif %}
                        </div>

                    {% endif %}

                    {% if selected.listing_id %}
                        <div class="hp-msg-thread-actions">
                            {# View-listing info button — circle-help is the closest macro affordance #}
                            <a href="/listings/{{ selected.listing_id }}"
                               class="hp-msg-icon-btn" title="View listing" aria-label="View listing">
                                {{ ui.icon('circle-help') }}
                            </a>
                        </div>
                    {% endif %}
                </div>

                <div class="hp-msg-thread-body" id="hpMsgThreadBody">
                    {% if thread is empty %}
                        <div class="hp-msg-welcome">
                            <span class="hp-msg-welcome-icon">
                                {{ ui.icon('message') }}
                            </span>
                            <h3>Say hello</h3>
                            <p>No messages in this conversation yet.</p>
                        </div>
                    {% endif %}

                    {% set last_day = null %}
                    {% for m in thread %}
                        {% if m.day_key != last_day %}
                            <span class="hp-msg-day-divider">{{ m.day_label }}</span>
                            {% set last_day = m.day_key %}
                        {% endif %}
                        <div class="hp-msg-row {{ m.is_mine ? 'mine' : 'theirs' }}">
                            <div class="hp-msg-bubble-wrap">
                                <div class="hp-msg-bubble">{{ m.body|nl2br }}</div>
                                <span class="hp-msg-time">{{ m.time_label }}</span>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <form method="POST" action="{{ path('app_host_messages') }}" class="hp-msg-composer">
                    <input type="hidden" name="hp_csrf" value="{{ hp_csrf }}">
                    <input type="hidden" name="conversation_id" value="{{ selected.id }}">
                    <input type="text" name="body" class="hp-msg-input" placeholder="Type your message..." autocomplete="off" required>
                    <button type="submit" name="send_message" value="1" class="hp-msg-send-btn" aria-label="Send message">
                        {{ ui.icon('arrow-up') }}
                    </button>
                </form>

            {% else %}
                <div class="hp-msg-welcome">
                    <span class="hp-msg-welcome-icon">
                        {{ ui.icon('message') }}
                    </span>
                    <h3>Select a conversation</h3>
                    <p>Pick a chat on the left to see your messages.</p>
                </div>
            {% endif %}
        </div>

    </section>

{% endif %}
{% endblock %}

{% block scripts %}
<script>
    (function () {
        /* =====================================================
           Scroll the thread to the bottom on load (same as
           legacy — no animation, instant jump).
        ====================================================== */
        var body = document.getElementById('hpMsgThreadBody');
        if (body) {
            body.scrollTop = body.scrollHeight;
        }

        /* =====================================================
           Search + tab filter (1:1 with legacy):
             • search input filters list items by textContent
             • All / Unread tabs toggle the .unread-only filter
             • both combine — an item shows only if it matches
               the active tab AND the search term
        ====================================================== */
        var searchInput = document.getElementById('hpMsgSearchInput');
        var tabsWrap = document.getElementById('hpMsgTabs');
        var list = document.getElementById('hpMsgList');
        if (!searchInput || !tabsWrap || !list) {
            return;
        }

        var items = Array.prototype.slice.call(list.querySelectorAll('.hp-msg-list-item'));
        var activeFilter = 'all';

        function applyFilters() {
            var term = searchInput.value.trim().toLowerCase();
            items.forEach(function (item) {
                var matchesTab = activeFilter === 'all' || item.classList.contains('unread');
                var matchesSearch = !term || item.textContent.toLowerCase().indexOf(term) !== -1;
                item.classList.toggle('js-hidden', !(matchesTab && matchesSearch));
            });
        }

        searchInput.addEventListener('input', applyFilters);

        tabsWrap.querySelectorAll('.hp-msg-tab').forEach(function (tab) {
            tab.addEventListener('click', function () {
                tabsWrap.querySelectorAll('.hp-msg-tab').forEach(function (t) {
                    t.classList.remove('active');
                });
                tab.classList.add('active');
                activeFilter = tab.getAttribute('data-filter');
                applyFilters();
            });
        });
    })();
</script>
{% endblock %}
