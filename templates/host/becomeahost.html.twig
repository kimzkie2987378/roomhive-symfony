                    { name: "Tacloban City", province: "Leyte" },
                    { name: "Baybay City", province: "Leyte" },
                    { name: "Ormoc City", province: "Leyte" },
                    { name: "Catbalogan City", province: "Samar" },
                    { name: "Calbayog City", province: "Samar" },
                    { name: "Borongan City", province: "Eastern Samar" },
                    { name: "Maasin City", province: "Southern Leyte" },
                    { name: "Catarman", province: "Northern Samar" },
                    /* Region IX */
                    { name: "Zamboanga City", province: "Zamboanga del Sur" },
                    { name: "Dapitan City", province: "Zamboanga del Norte" },
                    { name: "Dipolog City", province: "Zamboanga del Norte" },
                    { name: "Isabela City", province: "Basilan" },
                    { name: "Pagadian City", province: "Zamboanga del Sur" },
                    { name: "Ipil", province: "Zamboanga Sibugay" },
                    /* Region X */
                    { name: "Cagayan de Oro City", province: "Misamis Oriental" },
                    { name: "El Salvador City", province: "Misamis Oriental" },
                    { name: "Gingoog City", province: "Misamis Oriental" },
                    { name: "Iligan City", province: "Lanao del Norte" },
                    { name: "Malaybalay City", province: "Bukidnon" },
                    { name: "Valencia City", province: "Bukidnon" },
                    { name: "Oroquieta City", province: "Misamis Occidental" },
                    { name: "Ozamiz City", province: "Misamis Occidental" },
                    { name: "Tangub City", province: "Misamis Occidental" },
                    { name: "Mambajao", province: "Camiguin" },
                    /* Region XI */
                    { name: "Davao City", province: "Davao del Sur" },
                    { name: "Tagum City", province: "Davao del Norte" },
                    { name: "Panabo City", province: "Davao del Norte" },
                    { name: "Samal City", province: "Davao del Norte" },
                    { name: "Mati City", province: "Davao Oriental" },
                    { name: "Digos City", province: "Davao del Sur" },
                    { name: "Nabunturan", province: "Davao de Oro" },
                    { name: "Malita", province: "Davao Occidental" },
                    /* Region XII */
                    { name: "General Santos City", province: "South Cotabato" },
                    { name: "Koronadal City", province: "South Cotabato" },
                    { name: "Kidapawan City", province: "Cotabato" },
                    { name: "Tacurong City", province: "Sultan Kudarat" },
                    { name: "Alabel", province: "Sarangani" },
                    /* Caraga */
                    { name: "Butuan City", province: "Agusan del Norte" },
                    { name: "Cabadbaran City", province: "Agusan del Norte" },
                    { name: "Bayugan City", province: "Agusan del Sur" },
                    { name: "Surigao City", province: "Surigao del Norte" },
                    { name: "Bislig City", province: "Surigao del Sur" },
                    { name: "Tandag City", province: "Surigao del Sur" },
                    /* BARMM */
                    { name: "Marawi City", province: "Lanao del Sur" },
                    { name: "Lamitan City", province: "Basilan" },
                    { name: "Jolo", province: "Sulu" },
                    { name: "Bongao", province: "Tawi-Tawi" },
                ];

                /* =====================================================
                                                                   SHARED DROPDOWN FACTORY
                                                                   Creates one single-panel dropdown under the given
                                                                   input. opts:
                                                                     input        HTMLInputElement (required)
                                                                     headerLabel  string shown in the sticky header
                                                                     tag          pill text ("Province" / "City")
                                                                     findMatches  function(query) → [{ name, sub? }]
                                                                     applyPick    function(item) → sets input value
                                                                ===================================================== */
                function createRhDropdown(opts) {
                    var input = opts.input;
                    if (!input) return;

                    var wrapper = input.closest(".input-with-icon") || input.parentElement;
                    if (!wrapper) return;

                    /* cont-44: the group + grid row around the input
                                                                       get lifted (z-index 5000) while the dropdown is
                                                                       open — see the STACKING LIFT CSS comment. */
                    var group = input.closest(".input-group");
                    var row = input.closest(".form-grid");

                    var dropdown = document.createElement("div");
                    dropdown.className = "rh-location-dropdown";
                    dropdown.setAttribute("role", "listbox");
                    dropdown.setAttribute("aria-label", opts.headerLabel);
                    dropdown.id = "rhDd_" + input.id;

                    var header = document.createElement("div");
                    header.className = "rh-location-header";
                    header.textContent = opts.headerLabel;

                    var listEl = document.createElement("div");
                    listEl.className = "rh-location-list";

                    dropdown.appendChild(header);
                    dropdown.appendChild(listEl);
                    wrapper.appendChild(dropdown);

                    var highlightedIndex = -1;
                    var currentItems = [];

                    function escapeHtml(s) {
                        return String(s).replace(/[&<>"']/g, function (c) {
                            return {
                                "&": "&amp;",
                                "<": "&lt;",
                                ">": "&gt;",
                                '"': "&quot;",
                                "'": "&#39;",
                            }[c];
                        });
                    }

                    var MAP_PIN_SVG =
                        '<span class="rh-location-icon">' +
                        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" ' +
                        'fill="none" stroke="currentColor" stroke-width="2" ' +
                        'stroke-linecap="round" stroke-linejoin="round">' +
                        '<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>' +
                        '<circle cx="12" cy="10" r="3"/></svg></span>';

                    function open() {
                        dropdown.classList.add("is-open");
                        /* cont-44: lift the host chain above sibling
                                                                           groups/rows so later-in-DOM elements (Row 4's
                                                                           ID Type label + select, etc.) can't paint
                                                                           over the open dropdown and eat the clicks. */
                        wrapper.classList.add("rh-dd-host");
                        if (group) group.classList.add("rh-dd-host-group");
                        if (row) row.classList.add("rh-dd-host-row");
                    }

                    function close() {
                        dropdown.classList.remove("is-open");
                        wrapper.classList.remove("rh-dd-host");
                        if (group) group.classList.remove("rh-dd-host-group");
                        if (row) row.classList.remove("rh-dd-host-row");
                        highlightedIndex = -1;
                    }

                    function updateHighlight() {
                        var items = listEl.querySelectorAll(".rh-location-item");
                        items.forEach(function (el, i) {
                            el.classList.toggle("is-highlighted", i === highlightedIndex);
                        });
                        if (highlightedIndex >= 0 && items[highlightedIndex]) {
                            items[highlightedIndex].scrollIntoView({ block: "nearest" });
                        }
                    }

                    function render(matches) {
                        currentItems = matches;
                        highlightedIndex = -1;
                        listEl.innerHTML = "";

                        if (matches.length === 0) {
                            close();
                            return;
                        }

                        matches.forEach(function (item) {
                            var el = document.createElement("div");
                            el.className = "rh-location-item";
                            el.setAttribute("role", "option");
                            el.setAttribute("tabindex", "-1");

                            var nameHtml = escapeHtml(item.name);
                            if (item.sub) {
                                nameHtml +=
                                    '<span class="rh-location-sub"> — ' +
                                    escapeHtml(item.sub) +
                                    "</span>";
                            }

                            el.innerHTML =
                                MAP_PIN_SVG +
                                '<span class="rh-location-name">' +
                                nameHtml +
                                "</span>" +
                                '<span class="rh-location-tag">' +
                                escapeHtml(opts.tag) +
                                "</span>";

                            /* mousedown (not click) so the input hasn't
                                                                               lost focus yet when we fill it — prevents
                                                                               the blur handler from racing the pick. */
                            el.addEventListener("mousedown", function (e) {
                                e.preventDefault();
                                opts.applyPick(item);
                                /* cont-45: programmatic value changes
                                                                                   fire no events — dispatch `input` so
                                                                                   the validation hints refresh AND the
                                                                                   hidden location composer stays in
                                                                                   sync. (The factory's own input
                                                                                   listener re-renders + re-opens the
                                                                                   list; close() below runs last, so
                                                                                   the dropdown still ends closed.) */
                                input.dispatchEvent(new Event("input", { bubbles: true }));
                                close();
                            });

                            listEl.appendChild(el);
                        });

                        open();
                    }

                    /* cont-46: touch-to-open. opts.allMatches() (when
                                                                       provided) returns the FULL list — province: all
                                                                       83 provinces; city: the whole province-filtered
                                                                       pool — so touching the box works like a native
                                                                       select: the suggestions appear immediately,
                                                                       scrollable, no typing needed. */
                    function showAll() {
                        if (typeof opts.allMatches === "function") {
                            render(opts.allMatches());
                        } else {
                            render(opts.findMatches(""));
                        }
                    }

                    input.addEventListener("input", function () {
                        var q = this.value.trim().toLowerCase();
                        if (q.length < 1) {
                            /* clearing the text while the box is still
                                                                               focused (backspace to empty) re-shows the
                                                                               full list instead of closing — the box is
                                                                               active, so the suggestions stay useful */
                            if (document.activeElement === input) {
                                showAll();
                            } else {
                                close();
                            }
                            return;
                        }
                        render(opts.findMatches(q));
                    });

                    /* focus = touching/clicking/tabbing into the box —
                                                                       ALWAYS refresh to the full list. No is-open guard:
                                                                       when switching between the two boxes the old
                                                                       dropdown can still be "open" (its blur-close is
                                                                       pending) and skipping here would show a STALE
                                                                       list from before the switch (cont-46 fix). */
                    input.addEventListener("focus", function () {
                        showAll();
                    });

                    /* second click on an ALREADY-focused input fires no
                                                                       focus event — mousedown reopens the full list in
                                                                       that case. When the list is already open this is
                                                                       a no-op (keeps the filtered results). */
                    input.addEventListener("mousedown", function () {
                        if (!dropdown.classList.contains("is-open")) showAll();
                    });

                    input.addEventListener("keydown", function (e) {
                        if (e.key === "Escape") {
                            close();
                            return;
                        }
                        if (!dropdown.classList.contains("is-open")) return;

                        if (e.key === "ArrowDown") {
                            e.preventDefault();
                            highlightedIndex = Math.min(
                                highlightedIndex + 1,
                                currentItems.length - 1,
                            );
                            updateHighlight();
                        } else if (e.key === "ArrowUp") {
                            e.preventDefault();
                            highlightedIndex = Math.max(highlightedIndex - 1, 0);
                            updateHighlight();
                        } else if (e.key === "Enter" && highlightedIndex >= 0) {
                            e.preventDefault();
                            opts.applyPick(currentItems[highlightedIndex]);
                            /* cont-45: same sync as the mousedown pick */
                            input.dispatchEvent(new Event("input", { bubbles: true }));
                            close();
                        }
                    });

                    input.addEventListener("blur", function () {
                        /* cont-46: only close if focus did NOT come back
                                                                           within the grace period — otherwise switching
                                                                           between the two boxes (province → city within
                                                                           150ms) would close the freshly opened list. */
                        window.setTimeout(function () {
                            if (document.activeElement !== input) close();
                        }, 150);
                    });

                    document.addEventListener("click", function (e) {
                        /* cont-46: also ignore clicks on the field's own
                                                                           label — clicking it focuses the input (which
                                                                           now opens the list) and must not instantly
                                                                           close it again via this outside-click closer. */
                        var group = input.closest(".input-group");
                        var label = group ? group.querySelector("label") : null;
                        if (
                            !dropdown.contains(e.target) &&
                            e.target !== input &&
                            !(label && label.contains(e.target))
                        ) {
                            close();
                        }
                    });
                }

                /* =====================================================
                                                                   INSTANCE 1 — PROVINCE dropdown on #province
                                                                ===================================================== */
                createRhDropdown({
                    input: document.getElementById("province"),
                    headerLabel: "Provinces",
                    tag: "Province",
                    findMatches: function (q) {
                        return PROVINCES.filter(function (p) {
                            return p.toLowerCase().indexOf(q) !== -1;
                        })
                            .slice(0, 7)
                            .map(function (p) {
                                return { name: p };
                            });
                    },
                    /* cont-46: touching the box shows ALL provinces,
                                                                       scrollable — select-like, no typing needed */
                    allMatches: function () {
                        return PROVINCES.map(function (p) {
                            return { name: p };
                        });
                    },
                    applyPick: function (item) {
                        /* cont-44 CRITICAL FIX: this MUST be `var input`.
                                                                           applyPick is defined OUTSIDE createRhDropdown,
                                                                           so it cannot see the factory's own `var input`;
                                                                           the old bare assignment threw
                                                                           "ReferenceError: input is not defined" (the
                                                                           main IIFE is strict mode) on EVERY mousedown
                                                                           pick — the suggestion visibly did nothing.
                                                                           The city instance below already had `var`. */
                        var input = document.getElementById("province");
                        if (input) input.value = item.name;
                    },
                });

                /* =====================================================
                                                                   INSTANCE 2 — CITY dropdown on #city
                                                                   Filters to the selected province when #province has
                                                                   a value matching a known province — so after picking
                                                                   "Negros Oriental", the city box only surfaces
                                                                   Negros Oriental cities (both when typing AND when
                                                                   the full touch-to-open list is shown).
                                                                ===================================================== */
                /* shared pool: narrows to the selected province's cities
                                                                   when #province holds a known province name, else all
                                                                   166 cities. Used by findMatches AND allMatches. */
                function rhCityPool() {
                    var provInput = document.getElementById("province");
                    var provVal = provInput ? provInput.value.trim().toLowerCase() : "";
                    var pool = CITIES;

                    if (provVal !== "") {
                        var inProv = CITIES.filter(function (c) {
                            return c.province.toLowerCase() === provVal;
                        });
                        /* only narrow the pool when the province
                                                                           value actually matches a known province
                                                                           (free-typed text that matches nothing
                                                                           keeps the full list usable) */
                        if (inProv.length > 0) pool = inProv;
                    }

                    return pool;
                }

                createRhDropdown({
                    input: document.getElementById("city"),
                    headerLabel: "Cities",
                    tag: "City",
                    findMatches: function (q) {
                        return rhCityPool()
                            .filter(function (c) {
                                return c.name.toLowerCase().indexOf(q) !== -1;
                            })
                            .slice(0, 7)
                            .map(function (c) {
                                return { name: c.name, sub: c.province };
                            });
                    },
                    /* cont-46: touching the box shows the FULL pool —
                                                                       the province's cities when one is selected,
                                                                       otherwise all 166 cities */
                    allMatches: function () {
                        return rhCityPool().map(function (c) {
                            return { name: c.name, sub: c.province };
                        });
                    },
                    applyPick: function (item) {
                        var input = document.getElementById("city");
                        if (input) input.value = item.name;
                    },
                });
            })();
        </script>

    </body>
</html>
