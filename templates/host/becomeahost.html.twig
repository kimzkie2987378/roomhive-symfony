        {# =========================================================
           LUCIDE ICONS — guarded loader (same key as navbar: never
           double-runs). Renders every <i data-lucide="..."> as an
           inline SVG. hiveRefreshIcons() is preserved as a thin
           alias so the form/upload IIFE's existing
           `var refreshIcons = window.hiveRefreshIcons` reference
           keeps working unchanged.
        ========================================================= #}
        <script>
            (function () {
                "use strict";

                function renderRhIcons() {
                    if (window.lucide && typeof window.lucide.createIcons === "function") {
                        window.lucide.createIcons();
                    }
                }

                /* legacy alias — the form/upload IIFE reads
                                                                   window.hiveRefreshIcons; keep it pointing at the
                                                                   same render so its init call still works */
                window.hiveRefreshIcons = renderRhIcons;

                if (!window.__rhNavbarLucide) {
                    window.__rhNavbarLucide = true;
                    var s = document.createElement("script");
                    s.src = "https://unpkg.com/lucide@0.469.0/dist/umd/lucide.min.js";
                    s.addEventListener("load", renderRhIcons);
                    document.head.appendChild(s);
                }

                if (document.readyState === "loading") {
                    document.addEventListener("DOMContentLoaded", renderRhIcons);
                } else {
                    renderRhIcons();
                }
                window.addEventListener("load", renderRhIcons);
            })();
        </script>

        {# =========================================================
           STEP 1 PAGE SCRIPTS
           ⚠ RECONSTRUCTED — your original JS wasn't in the paste.
           Built to match the CSS hooks already present:
           #progressCount/#progressTotal/#progressFill, is-valid /
           is-invalid, .shake, .is-loading, .drag-over, .has-image,
           .upload-error.show, [hidden] toggles.

           Preserved 1:1 — the only adjustment is the
           `window.hiveRefreshIcons` reference now points at the
           guarded loader above instead of the legacy plain-CDN
           hiveRefreshIcons function (same contract: callable
           from anywhere, idempotent, safe before lucide loads).
        ========================================================= #}
        <script>
            (function () {
                "use strict";

                var refreshIcons = window.hiveRefreshIcons || function () {};

                /* =========================================================
                                                                   ELEMENTS
                                                                ========================================================= */
                var form = document.getElementById("hostForm");
                var card = document.querySelector(".host-form-card");

                var progressCount = document.getElementById("progressCount");
                var progressTotal = document.getElementById("progressTotal");
                var progressFill = document.getElementById("progressFill");

                var uploadBox = document.getElementById("uploadBox");
                var fileInput = document.getElementById("upload_id");
                var removeBtn = document.getElementById("uploadRemove");
                var overlay = document.getElementById("uploadOverlay");
                var fileNameEl = document.getElementById("uploadFileName");
                var uploadError = document.getElementById("uploadError");

                var nextBtn = document.getElementById("nextBtn");

                var MAX_UPLOAD_BYTES = 5 * 1024 * 1024;
                var ALLOWED_MIME = ["image/jpeg", "image/png"];

                /* 9 tracked fields: 8 inputs + the ID upload
                                                                   (cont-43: single 'location' split into province + city) */
                var FIELDS = [
                    "full_name",
                    "email",
                    "phone",
                    "age",
                    "province",
                    "city",
                    "id_type",
                    "id_number",
                    "upload_id",
                ];

                if (progressTotal) progressTotal.textContent = String(FIELDS.length);

                /* =========================================================
                                                                   FIELD VALIDATION
                                                                   Returns true when valid, or an error message string.
                                                                ========================================================= */
                var validators = {
                    full_name: function (v) {
                        return v.trim().length >= 2 ? true : "Please enter your full name.";
                    },
                    email: function (v) {
                        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim())
                            ? true
                            : "Please enter a valid email address.";
                    },
                    phone: function (v) {
                        /* PH mobile numbers always start with 09
                                                                           (e.g. 09171234567). 11 digits total: 09 + 9 more. */
                        return /^09[0-9]{9}$/.test(v.trim())
                            ? true
                            : "Phone number must start with 09 and be 11 digits.";
                    },
                    age: function (v) {
                        if (!/^[0-9]+$/.test(v.trim())) return "Please enter a valid age.";
                        var n = parseInt(v, 10);
                        if (n < 18)
                            return "You must be at least 18 years old to become a host.";
                        if (n > 120) return "Please enter a valid age.";
                        return true;
                    },
                    province: function (v) {
                        return v.trim() !== "" ? true : "Please enter your province.";
                    },
                    city: function (v) {
                        return v.trim() !== ""
                            ? true
                            : "Please enter your city or municipality.";
                    },
                    id_type: function (v) {
                        return v !== "" ? true : "Please select your ID type.";
                    },
                    id_number: function (v) {
                        return v.trim() !== "" ? true : "Please enter your ID number.";
                    },
                };

                function groupFor(name) {
                    return form ? form.querySelector('[data-field="' + name + '"]') : null;
                }

                function validateField(name, mark) {
                    var el = form && form.elements[name];
                    var group = groupFor(name);
                    if (!el || !group) return true;

                    var result = validators[name](el.value);
                    var hint = group.querySelector(".field-hint");

                    if (result === true) {
                        group.classList.remove("is-invalid");
                        group.classList.add("is-valid");
                        if (hint) {
                            if (!hint.dataset.default)
                                hint.dataset.default = hint.textContent;
                            hint.textContent = "Looks good";
                        }
                        return true;
                    }

                    group.classList.remove("is-valid");
                    if (mark) {
                        group.classList.add("is-invalid");
                        if (hint) {
                            if (!hint.dataset.default)
                                hint.dataset.default = hint.textContent;
                            hint.textContent = result;
                        }
                    } else if (hint && hint.dataset.default) {
                        hint.textContent = hint.dataset.default;
                    }
                    return false;
                }

                /* =========================================================
                                                                   UPLOAD STATE
                                                                ========================================================= */
                var uploadValid = false;

                function markUpload(valid) {
                    uploadValid = valid;
                    var group = groupFor("upload_id");
                    if (group) {
                        group.classList.toggle("is-valid", valid);
                        group.classList.toggle("is-invalid", !valid);
                    }
                }

                function showUploadError(msg) {
                    if (!uploadError) return;
                    uploadError.textContent = msg;
                    uploadError.classList.add("show");
                }

                function clearUploadError() {
                    if (!uploadError) return;
                    uploadError.textContent = "";
                    uploadError.classList.remove("show");
                }

                function resetUpload() {
                    uploadValid = false;
                    if (fileInput) fileInput.value = "";
                    if (uploadBox) {
                        uploadBox.style.backgroundImage = "";
                        uploadBox.classList.remove("has-image");
                    }
                    if (overlay) overlay.hidden = true;
                    if (removeBtn) removeBtn.hidden = true;
                    markUpload(false);
                    updateProgress();
                }

                function handleFiles(fileList) {
                    var file = fileList && fileList[0];
                    if (!file) return;

                    clearUploadError();

                    if (ALLOWED_MIME.indexOf(file.type) === -1) {
                        showUploadError("Only JPG and PNG files are allowed.");
                        markUpload(false);
                        updateProgress();
                        return;
                    }

                    if (file.size > MAX_UPLOAD_BYTES) {
                        showUploadError("ID file must not exceed 5MB.");
                        markUpload(false);
                        updateProgress();
                        return;
                    }

                    /* Sync the chosen file onto the real input so a
                                                                       drag-and-drop selection is still submitted with the form */
                    try {
                        var dt = new DataTransfer();
                        dt.items.add(file);
                        if (fileInput) fileInput.files = dt.files;
                    } catch (err) {
                        /* older browsers: only click-selected files submit */
                    }

                    var reader = new FileReader();
                    reader.onload = function (e) {
                        if (uploadBox) {
                            uploadBox.style.backgroundImage =
                                "url(" + e.target.result + ")";
                            uploadBox.classList.add("has-image");
                        }
                        if (fileNameEl) fileNameEl.textContent = file.name;
                        if (overlay) overlay.hidden = false;
                        if (removeBtn) removeBtn.hidden = false;
                    };
                    reader.readAsDataURL(file);

                    markUpload(true);
                    updateProgress();
                }

                if (uploadBox && fileInput) {
                    uploadBox.addEventListener("click", function (e) {
                        /* let the remove button do its own thing */
                        if (e.target.closest && e.target.closest(".upload-remove-btn"))
                            return;
                        fileInput.click();
                    });

                    uploadBox.addEventListener("keydown", function (e) {
                        if (e.key === "Enter" || e.key === " ") {
                            e.preventDefault();
                            fileInput.click();
                        }
                    });

                    fileInput.addEventListener("change", function () {
                        handleFiles(fileInput.files);
                    });

                    ["dragenter", "dragover"].forEach(function (evt) {
                        uploadBox.addEventListener(evt, function (e) {
                            e.preventDefault();
                            e.stopPropagation();
                            uploadBox.classList.add("drag-over");
                        });
                    });

                    ["dragleave", "drop"].forEach(function (evt) {
                        uploadBox.addEventListener(evt, function (e) {
                            e.preventDefault();
                            e.stopPropagation();
                            uploadBox.classList.remove("drag-over");
                        });
                    });

                    uploadBox.addEventListener("drop", function (e) {
                        if (e.dataTransfer && e.dataTransfer.files.length) {
                            handleFiles(e.dataTransfer.files);
                        }
                    });
                }

                if (removeBtn) {
                    removeBtn.addEventListener("click", function (e) {
                        e.stopPropagation();
                        resetUpload();
                    });
                }

                /* =========================================================
                                                                   PROGRESS BAR
                                                                ========================================================= */
                function countValid() {
                    var count = 0;
                    FIELDS.forEach(function (name) {
                        if (name === "upload_id") {
                            if (uploadValid) count++;
                            return;
                        }
                        var el = form && form.elements[name];
                        if (el && validators[name](el.value) === true) count++;
                    });
                    return count;
                }

                function updateProgress() {
                    var count = countValid();
                    if (progressCount) progressCount.textContent = String(count);
                    if (progressFill) {
                        progressFill.style.width = (count / FIELDS.length) * 100 + "%";
                    }
                }

                /* =========================================================
                                                                   INPUT WIRING
                                                                ========================================================= */
                FIELDS.forEach(function (name) {
                    if (name === "upload_id") return;
                    var el = form && form.elements[name];
                    if (!el) return;

                    ["input", "change", "blur"].forEach(function (evt) {
                        el.addEventListener(evt, function () {
                            validateField(name, true);
                            updateProgress();
                        });
                    });
                });

                /* =========================================================
                                                                   HIDDEN location COMPOSER (cont-45)
                                                                   The visible form posts province + city (cont-43), but
                                                                   the controller may still validate/save the legacy
                                                                   single `location` field. Keep the hidden
                                                                   #rhLocationField in sync as "City, Province" so BOTH
                                                                   controller versions accept the POST. Runs on every
                                                                   province/city keystroke AND once at submit time (see
                                                                   the submit handler — first line).
                                                                ========================================================= */
                var locationField = document.getElementById("rhLocationField");
                var provinceField = form ? form.elements["province"] : null;
                var cityField = form ? form.elements["city"] : null;

                function syncLocationField() {
                    if (!locationField || !provinceField || !cityField) return;
                    var parts = [];
                    if (cityField.value.trim() !== "") parts.push(cityField.value.trim());
                    if (provinceField.value.trim() !== "")
                        parts.push(provinceField.value.trim());
                    locationField.value = parts.join(", ");
                }

                if (provinceField)
                    provinceField.addEventListener("input", syncLocationField);
                if (cityField) cityField.addEventListener("input", syncLocationField);

                /* Phone: digits only, hard cap 11 */
                var phoneEl = form && form.elements["phone"];
                if (phoneEl) {
                    phoneEl.addEventListener("input", function () {
                        var cleaned = this.value.replace(/\D/g, "").slice(0, 11);
                        if (cleaned !== this.value) this.value = cleaned;
                    });
                }

                /* =========================================================
                                                                   SUBMIT — validate everything, shake on failure,
                                                                   spinner + disabled state while the PHP round-trips.
                                                                ========================================================= */
                if (form) {
                    form.addEventListener("submit", function (e) {
                        /* cont-45: compose the hidden legacy `location`
                                                                           ("City, Province") right before anything reads
                                                                           the form — belt and suspenders on top of the
                                                                           per-keystroke sync. */
                        syncLocationField();

                        var allValid = true;

                        FIELDS.forEach(function (name) {
                            var ok;
                            if (name === "upload_id") {
                                ok = uploadValid;
                                if (!ok) {
                                    markUpload(false);
                                    if (uploadError && !uploadError.textContent) {
                                        showUploadError("Please upload your ID.");
                                    }
                                }
                            } else {
                                ok = validateField(name, true);
                            }
                            if (!ok) allValid = false;
                        });

                        updateProgress();

                        if (!allValid) {
                            e.preventDefault();

                            if (card) {
                                card.classList.remove("shake");
                                void card.offsetWidth; /* restart the animation */
                                card.classList.add("shake");
                            }

                            var firstInvalid = form.querySelector(
                                ".input-group.is-invalid input, .input-group.is-invalid select",
                            );
                            if (firstInvalid) firstInvalid.focus();

                            return;
                        }

                        if (nextBtn) {
                            nextBtn.disabled = true;
                            nextBtn.classList.add("is-loading");
                            var label = nextBtn.querySelector(".next-label");
                            if (label) label.textContent = "Submitting\u2026";
                        }
                    });
                }

                /* =========================================================
                                                                   INIT
                                                                   Compute progress without marking anything invalid —
                                                                   a fresh page shouldn't greet the user with red borders.
                                                                ========================================================= */
                updateProgress();
                refreshIcons();
            })();
        </script>

