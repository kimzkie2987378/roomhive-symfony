{% extends 'admin/base.html.twig' %}
{% import 'admin/_macros.html.twig' as ui %}

{% set active_nav = 'Staff' %}
{% set page_title = 'Staff Management — RoomHive Admin' %}
{% set page_heading = 'Staff Management' %}
{% set page_subheading = 'Manage staff accounts, assign roles, and create login credentials.' %}

{% block styles %}
<style>
    .staff-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 12px;
    }
    .btn-add-staff {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(180deg, #f6c04e, #eda423);
        color: #14142b;
        font-weight: 700;
        font-size: 14px;
        padding: 10px 18px;
        border-radius: 9px;
        border: none;
        cursor: pointer;
        transition: filter 0.15s ease, transform 0.05s ease;
        box-shadow: 0 4px 12px rgba(237, 164, 35, 0.25);
    }
    .btn-add-staff:hover {
        filter: brightness(1.05);
    }
    .btn-add-staff .icon {
        width: 16px;
        height: 16px;
    }

    /* Stats Grid */
    .staff-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }
    .staff-stat-card {
        background: #fff;
        border: 1px solid #eef1f6;
        border-radius: 12px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .stat-icon-wrap {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: #fff8eb;
        color: #eda423;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .stat-icon-wrap .icon { width: 22px; height: 22px; }
    .stat-val { font-size: 22px; font-weight: 800; color: #14142b; }
    .stat-lbl { font-size: 12px; font-weight: 600; color: #8b93a6; margin-top: 2px; }

    /* Staff Table Card */
    .staff-card {
        background: #fff;
        border: 1px solid #eef1f6;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(20, 20, 43, 0.04);
    }
    .staff-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }
    .staff-table th {
        background: #fbfcfe;
        padding: 14px 18px;
        font-size: 12px;
        font-weight: 700;
        color: #5b6172;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid #eef1f6;
    }
    .staff-table td {
        padding: 16px 18px;
        font-size: 13px;
        color: #14142b;
        border-bottom: 1px solid #f6f7fb;
        vertical-align: middle;
    }
    .staff-table tr:last-child td {
        border-bottom: none;
    }
    .staff-table tr:hover td {
        background: #fafbfe;
    }

    .staff-member-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .staff-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #eda423;
        color: #fff;
        font-weight: 700;
        font-size: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .staff-name {
        font-weight: 600;
        color: #14142b;
    }
    .staff-email {
        color: #5b6172;
        font-family: inherit;
    }

    .action-btn-group {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .btn-action-status {
        background: #f6f7fb;
        border: 1px solid #eef1f6;
        color: #5b6172;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
    }
    .btn-action-status:hover {
        background: #eef1f6;
        color: #14142b;
    }
    .btn-action-delete {
        background: #fceaea;
        border: 1px solid #fad2d2;
        color: #e14b4b;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .btn-action-delete:hover {
        background: #e14b4b;
        color: #fff;
    }

    /* Modal Backdrop */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(20, 20, 43, 0.55);
        z-index: 1000;
        align-items: center;
        justify-content: center;
        padding: 20px;
        backdrop-filter: blur(2px);
    }
    .modal-overlay.active {
        display: flex;
    }
    .modal-card {
        background: #fff;
        border-radius: 16px;
        width: 100%;
        max-width: 460px;
        box-shadow: 0 20px 50px rgba(20, 20, 43, 0.2);
        overflow: hidden;
        animation: modalSlide 0.2s ease-out;
    }
    @keyframes modalSlide {
        from { transform: translateY(12px) scale(0.98); opacity: 0; }
        to { transform: translateY(0) scale(1); opacity: 1; }
    }
    .modal-header {
        padding: 20px 24px;
        border-bottom: 1px solid #eef1f6;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .modal-title {
        font-size: 17px;
        font-weight: 700;
        color: #14142b;
    }
    .modal-close {
        background: none;
        border: none;
        font-size: 22px;
        line-height: 1;
        color: #8b93a6;
        cursor: pointer;
    }
    .modal-close:hover { color: #14142b; }
    .modal-body {
        padding: 24px;
    }
    .modal-footer {
        padding: 16px 24px;
        border-top: 1px solid #eef1f6;
        background: #fbfcfe;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    /* Form Fields */
    .form-field {
        margin-bottom: 16px;
    }
    .form-field label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        color: #5b6172;
        margin-bottom: 6px;
    }
    .form-field input {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #e3e6ee;
        border-radius: 8px;
        font-size: 14px;
        color: #14142b;
        outline: none;
        box-sizing: border-box;
    }
    .form-field input:focus {
        border-color: #eda423;
        box-shadow: 0 0 0 3px rgba(237, 164, 35, 0.15);
    }
    .pw-input-wrap {
        display: flex;
        gap: 8px;
    }
    .btn-gen-pw {
        background: #f6f7fb;
        border: 1px solid #e3e6ee;
        border-radius: 8px;
        padding: 0 12px;
        font-size: 12px;
        font-weight: 600;
        color: #5b6172;
        cursor: pointer;
        white-space: nowrap;
    }
    .btn-gen-pw:hover { background: #eef1f6; color: #14142b; }

    /* Pop-up Credentials Box */
    .credentials-box {
        background: #fbfcfe;
        border: 2px dashed #eda423;
        border-radius: 12px;
        padding: 18px;
        margin: 16px 0;
    }
    .cred-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid #eef1f6;
    }
    .cred-row:last-child { border-bottom: none; }
    .cred-label { font-size: 12px; font-weight: 600; color: #8b93a6; }
    .cred-value {
        font-family: monospace;
        font-size: 14px;
        font-weight: 700;
        color: #14142b;
        background: #fff;
        padding: 4px 8px;
        border-radius: 6px;
        border: 1px solid #eef1f6;
    }
    .copy-pill {
        background: #fff4e0;
        color: #b07708;
        border: none;
        border-radius: 6px;
        padding: 4px 8px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        margin-left: 8px;
    }
    .copy-pill:hover { background: #eda423; color: #fff; }
</style>
{% endblock %}

{% block content %}
<div class="staff-top-bar">
    <div>
        <!-- Left empty for alignment -->
    </div>
    <button type="button" class="btn-add-staff" id="btnOpenAddModal">
        {{ ui.icon('user-plus') }} Add New Staff
    </button>
</div>

<!-- Stats -->
<div class="staff-stats-grid">
    <div class="staff-stat-card">
        <div class="stat-icon-wrap">{{ ui.icon('users') }}</div>
        <div>
            <div class="stat-val">{{ total_staff }}</div>
            <div class="stat-lbl">Total Staff Accounts</div>
        </div>
    </div>
    <div class="staff-stat-card">
        <div class="stat-icon-wrap" style="background:#e7f7ec; color:#2fa84f;">{{ ui.icon('badge-check') }}</div>
        <div>
            <div class="stat-val">{{ active_staff }}</div>
            <div class="stat-lbl">Active Accounts</div>
        </div>
    </div>
    <div class="staff-stat-card">
        <div class="stat-icon-wrap" style="background:#eef1f6; color:#5b6172;">{{ ui.icon('shield-alert') }}</div>
        <div>
            <div class="stat-val">{{ inactive_staff }}</div>
            <div class="stat-lbl">Inactive Accounts</div>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="staff-card">
    {% if staff_members is empty %}
        <div style="padding: 48px 24px; text-align: center;">
            {{ ui.empty_state('No staff accounts registered yet. Click "Add New Staff" to create one.') }}
        </div>
    {% else %}
        <table class="staff-table">
            <thead>
                <tr>
                    <th>Staff Member</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for s in staff_members %}
                    <tr>
                        <td>
                            <div class="staff-member-cell">
                                <div class="staff-avatar">{{ s.name|slice(0, 1)|upper }}</div>
                                <span class="staff-name">{{ s.name }}</span>
                            </div>
                        </td>
                        <td>
                            <span class="staff-email">{{ s.email }}</span>
                        </td>
                        <td>
                            <span class="badge badge-confirmed">Staff</span>
                        </td>
                        <td>
                            <span class="badge {{ s.status == 'active' ? 'badge-approved' : 'badge-cancelled' }}">
                                {{ s.status|capitalize }}
                            </span>
                        </td>
                        <td>
                            <span style="font-size: 12px; color: #8b93a6;">
                                {{ s.created_at ? s.created_at|date('M j, Y') : '—' }}
                            </span>
                        </td>
                        <td>
                            <div class="action-btn-group" style="justify-content: flex-end;">
                                <form method="post" action="{{ path('app_admin_staff') }}" style="display:inline;">
                                    <input type="hidden" name="csrf_token" value="{{ admin_csrf }}">
                                    <input type="hidden" name="action" value="toggle_status">
                                    <input type="hidden" name="staff_id" value="{{ s.id }}">
                                    <button type="submit" class="btn-action-status">
                                        {{ s.status == 'active' ? 'Deactivate' : 'Activate' }}
                                    </button>
                                </form>

                                <form method="post" action="{{ path('app_admin_staff') }}" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete staff account {{ s.email }}? This cannot be undone.');">
                                    <input type="hidden" name="csrf_token" value="{{ admin_csrf }}">
                                    <input type="hidden" name="action" value="delete">
                                    <input type="hidden" name="staff_id" value="{{ s.id }}">
                                    <button type="submit" class="btn-action-delete">
                                        {{ ui.icon('trash') }} Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>

<!-- ==================== MODAL 1: ADD STAFF ==================== -->
<div class="modal-overlay" id="addStaffModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3 class="modal-title">Add New Staff Member</h3>
            <button type="button" class="modal-close" id="btnCloseAddModal">&times;</button>
        </div>
        <form method="post" action="{{ path('app_admin_staff') }}" id="formAddStaff">
            <input type="hidden" name="csrf_token" value="{{ admin_csrf }}">
            <input type="hidden" name="action" value="add">

            <div class="modal-body">
                <div class="form-field">
                    <label for="staffName">Full Name</label>
                    <input type="text" id="staffName" name="name" placeholder="e.g. Staff Member 1" required autofocus>
                </div>

                <div class="form-field">
                    <label for="staffEmail">Staff Email</label>
                    <input type="email" id="staffEmail" name="email" placeholder="e.g. staff2@roomhive.com" required>
                </div>

                <div class="form-field">
                    <label for="staffPassword">Password</label>
                    <div class="pw-input-wrap">
                        <input type="text" id="staffPassword" name="password" placeholder="Enter or generate password">
                        <button type="button" class="btn-gen-pw" id="btnGenPassword">Generate</button>
                    </div>
                    <small style="color:#8b93a6; font-size:11px; margin-top:4px; display:block;">Leave blank or click Generate to auto-create a secure password.</small>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-action-status" id="btnCancelAdd">Cancel</button>
                <button type="submit" class="btn-add-staff" style="padding:8px 16px;">Create Staff Account</button>
            </div>
        </form>
    </div>
</div>

<!-- ==================== MODAL 2: POP-UP CREDENTIALS ON SCREEN ==================== -->
<div class="modal-overlay {{ new_staff_credentials ? 'active' : '' }}" id="credentialsModal">
    <div class="modal-card">
        <div class="modal-header" style="background:#fffcf5;">
            <div style="display:flex; align-items:center; gap:8px;">
                <div style="width:28px; height:28px; border-radius:50%; background:#e7f7ec; color:#2fa84f; display:flex; align-items:center; justify-content:center;">
                    {{ ui.icon('badge-check') }}
                </div>
                <h3 class="modal-title" style="color:#14142b;">Staff Account Created!</h3>
            </div>
            <button type="button" class="modal-close" id="btnCloseCredModal">&times;</button>
        </div>

        <div class="modal-body">
            <p style="font-size:13px; color:#5b6172; line-height:1.5;">
                A new staff account has been created. Below are the login details. <strong>Please copy or save them now</strong> to share with the staff member.
            </p>

            <div class="credentials-box">
                <div class="cred-row">
                    <span class="cred-label">Staff Name</span>
                    <span class="cred-value" id="dispStaffName">{{ new_staff_credentials.name|default('') }}</span>
                </div>
                <div class="cred-row">
                    <span class="cred-label">Login Email</span>
                    <div style="display:flex; align-items:center;">
                        <span class="cred-value" id="dispStaffEmail">{{ new_staff_credentials.email|default('') }}</span>
                        <button type="button" class="copy-pill" onclick="copyText('dispStaffEmail')">Copy</button>
                    </div>
                </div>
                <div class="cred-row">
                    <span class="cred-label">Password</span>
                    <div style="display:flex; align-items:center;">
                        <span class="cred-value" id="dispStaffPassword" style="color:#b07708;">{{ new_staff_credentials.password|default('') }}</span>
                        <button type="button" class="copy-pill" onclick="copyText('dispStaffPassword')">Copy</button>
                    </div>
                </div>
            </div>

            <p style="font-size:12px; color:#8b93a6; margin-top:8px;">
                The staff member can sign in at <code>/staff/login</code> with these credentials.
            </p>
        </div>

        <div class="modal-footer">
            <button type="button" class="btn-add-staff" id="btnDoneCred" style="width:100%; justify-content:center;">
                Done &amp; Close
            </button>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    function copyText(elementId) {
        const el = document.getElementById(elementId);
        if (!el) return;
        const text = el.textContent.trim();
        navigator.clipboard.writeText(text).then(() => {
            alert('Copied: ' + text);
        }).catch(() => {
            prompt('Copy this text:', text);
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        const addModal = document.getElementById('addStaffModal');
        const credModal = document.getElementById('credentialsModal');
        const btnOpenAdd = document.getElementById('btnOpenAddModal');
        const btnCloseAdd = document.getElementById('btnCloseAddModal');
        const btnCancelAdd = document.getElementById('btnCancelAdd');
        const btnCloseCred = document.getElementById('btnCloseCredModal');
        const btnDoneCred = document.getElementById('btnDoneCred');
        const btnGen = document.getElementById('btnGenPassword');
        const pwInput = document.getElementById('staffPassword');

        if (btnOpenAdd) {
            btnOpenAdd.addEventListener('click', () => addModal.classList.add('active'));
        }
        if (btnCloseAdd) {
            btnCloseAdd.addEventListener('click', () => addModal.classList.remove('active'));
        }
        if (btnCancelAdd) {
            btnCancelAdd.addEventListener('click', () => addModal.classList.remove('active'));
        }
        if (btnCloseCred) {
            btnCloseCred.addEventListener('click', () => credModal.classList.remove('active'));
        }
        if (btnDoneCred) {
            btnDoneCred.addEventListener('click', () => credModal.classList.remove('active'));
        }

        if (btnGen && pwInput) {
            btnGen.addEventListener('click', function () {
                const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$';
                let res = '';
                for (let i = 0; i < 10; i++) {
                    res += chars.charAt(Math.floor(Math.random() * chars.length));
                }
                pwInput.value = res;
            });
        }
    });
</script>
{% endblock %}
