    {% set path = icons[name]|default('') %}
    <svg class="icon {{ class }}" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ path|raw }}</svg>
{% endmacro %}

{% macro empty_state(text) %}
    <div class="empty-state">
        <div class="empty-icon">{{ _self.icon('inbox') }}</div>
        <p>{{ text }}</p>
    </div>
{% endmacro %}

{% macro list_image(src, alt, class = '') %}
    {% set fallback = '/images/ListingPlaceholder.png' %}
    <img src="{{ src }}" alt="{{ alt }}"{{ class ? (' class="' ~ class ~ '"')|raw : '' }} onerror="this.onerror=null;this.src='{{ fallback }}';">
{% endmacro %}
